  <!-- 属性组：每个类只声明自己的属性，子类通过引用父类属性组实现继承 -->
  <xs:attributeGroup name="AddressBarAttrs">
    <!-- 来源：AddressBar -->
    <xs:attribute name="address_path" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置路径</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="path_tooltip" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置是否显示路径的tooltip</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="return_update_ui" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置按回车时自动更新显示控件</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="esc_update_ui" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置按ESC时自动更新显示控件</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="kill_focus_update_ui" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置失去焦点时自动更新显示控件</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="rich_edit_class" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置编辑框的Class</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="rich_edit_clear_btn_class" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置编辑框的清除按钮Class</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="sub_path_hbox_class" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置地址栏路径的容器（HBox）Class，每个子路径一个HBox容器</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="sub_path_button_class" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置地址栏子路径按钮的Class</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="sub_path_root_class" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置地址栏根路径的Class（"/"路径）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="path_separator_class" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置地址栏路径分隔符的Class</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="BoxAttrs">
    <!-- 来源：Box -->
    <xs:attribute name="child_margin" type="xs:string">
      <xs:annotation>
        <xs:documentation>布局属性，子控件之间的间隔: X 轴方向 和 Y 轴方向同时设置为相同值</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="child_margin_x" type="xs:string">
      <xs:annotation>
        <xs:documentation>布局属性，子控件之间的间隔: X 轴方向</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="child_margin_y" type="xs:string">
      <xs:annotation>
        <xs:documentation>布局属性，子控件之间的间隔: Y 轴方向</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="child_valign" type="xs:string">
      <xs:annotation>
        <xs:documentation>布局属性，子控件的垂直方向对齐方式，可选值："top","center","bottom"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="child_halign" type="xs:string">
      <xs:annotation>
        <xs:documentation>布局属性，子控件的水平方向对齐方式，可选值："left","center","right"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="child_align" type="xs:string">
      <xs:annotation>
        <xs:documentation>布局属性，同时设置子控件的水平方向和垂直方向的对齐方式，功能与child_valign和child_halign相同。 可取值: left、right、hcenter、top、vcenter、bottom，用逗号分割，如"hcenter,vcenter"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="margin" type="xs:string">
      <xs:annotation>
        <xs:documentation>外边距,如(2,2,2,2)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="padding" type="xs:string">
      <xs:annotation>
        <xs:documentation>内边距,如(2,2,2,2)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="mouse_child" type="xs:string">
      <xs:annotation>
        <xs:documentation>子控件是否支持鼠标操作, true 或者 false</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="drag_out_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置是否支持拖拽拖出该容器：如果不等于0，支持拖出，否则不支持拖出（拖出到drop_in_id==drag_out_id的容器）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="drop_in_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置是否支持拖拽投放进入该容器: 如果不等于0，支持拖入，否则不支持拖入(从drag_out_id==drop_in_id的容器拖入到该容器)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="ControlAttrs">
    <!-- 来源：Control -->
    <xs:attribute name="class" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件样式,用样式里面的属性值来设置本控件的属性,如"btn_default",可以同时指定多个样式,各个样式之间用空格分隔,需要写在第一个属性位置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="enable_vars" type="xs:string">
      <xs:annotation>
        <xs:documentation>属性值中是否支持变量展开。 用法举例：假设在globle.xml中增加一行变量定义：&lt;Define name="SIZE_ICON_SMALL" value="16"/&gt; XML中的控件属性字符串中可以这样使用这个变量：width="${SIZE_ICON_SMALL}" 代码中也可以这样调用函数设置属性代码：Control::SetAttribute(_T("width"), _T("${SIZE_ICON_SMALL}"));</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="name" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件名字,同一窗口建议保持唯一，否则影响查询效率，也可能查询不到正确的结果</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="xs:string">
      <xs:annotation>
        <xs:documentation>可以设置int或string类型的值.当值为int是则设置控件的宽度值,如"100";当值为string时,stretch代表由父容器计算控件宽度,auto代表根据内容情况自动计算宽度,如果为百分比值"50%"，代表该控件的宽度期望值为父控件宽度的50%</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="xs:string">
      <xs:annotation>
        <xs:documentation>可以设置int或string类型的值.当值为int是则设置控件的高度值,如"100";当值为string时,stretch代表由父容器计算控件高度,auto代表根据内容情况自动计算高度,如果为百分比值"30%"，代表该控件的高度期望值为父控件高度的30%</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="min_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的最小宽度,如"30"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="min_height" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的最小高度,如"30"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="max_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的最大宽度,描述同width</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="max_height" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的最大高度,描述同height</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="control_padding" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许控件自身运用内边距</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="halign" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的水平方向的对齐方式,如"center",支持left、center、right三种位置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="valign" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的垂直方向的对齐方式,如"center",支持top、center、bottom三种位置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="align" type="xs:string">
      <xs:annotation>
        <xs:documentation>同时设置控件的水平方向和垂直方向的对齐方式，功能与valign和halign相同。 可取值: left、right、hcenter、top、vcenter、bottom，用逗号分割，如"hcenter,vcenter"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="float" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否使用绝对定位,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="keep_float_pos" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置当父控件位置和大小调整时，是否保持浮动控件相对父控件的位置不变,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bkcolor" type="xs:string">
      <xs:annotation>
        <xs:documentation>背景颜色字符串常量,如"white"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bkcolor2" type="xs:string">
      <xs:annotation>
        <xs:documentation>第二背景颜色字符串常量,如果设置了第二背景色，则支持背景颜色渐变,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bkcolor2_direction" type="xs:string">
      <xs:annotation>
        <xs:documentation>第二背景色方向，"1": 左-&gt;右，"2": 上-&gt;下，"3": 左上-&gt;右下，"4": 右上-&gt;左下</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fore_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>前景颜色字符串，前景色一般设置半透明的颜色，比如"#10006DD9"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="normal_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>普通状态颜色,如"white"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hovered_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>悬浮状态颜色,如"white"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pressed_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>按下状态颜色,如"white"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>禁用状态颜色,如"white"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="normal_color_margin" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置普通状态下的控件颜色外边距</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hovered_color_margin" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置悬浮状态下的控件颜色外边距</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pressed_color_margin" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置按下状态下的控件颜色外边距</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_color_margin" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置禁用状态下的控件颜色外边距</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="state_color_min_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置状态颜色区域的最小宽度（解决设置Margin后，DPI缩放运算精度损失导致线条宽度失真问题）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="state_color_min_height" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置状态颜色区域的最小高度（解决设置Margin后，DPI缩放运算精度损失导致线条宽度失真问题）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="normal_color_round" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置普通状态下的控件颜色圆角大小</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hovered_color_round" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置悬浮状态下的控件颜色圆角大小</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pressed_color_round" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置按下状态下的控件颜色圆角大小</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_color_round" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置禁用状态下的控件颜色圆角大小</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置所有状态下的边框颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="normal_border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>正常状态的边框颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hovered_border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>悬浮状态的边框颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pressed_border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>按下状态的边框颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>禁止状态的边框颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="focused_border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>焦点状态的边框颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="border_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>可以设置int或rect类型的值。当值为int时则左、上、右、下都用该值作为宽。值为rect类型时则分别设置左、上、右、下的边框</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="border_dash_style" type="xs:string">
      <xs:annotation>
        <xs:documentation>线的形状，可选值： "solid"：实线 "dash"：短划线构成的虚线 "dot"：点构成的虚线 "dash_dot"：交替短划线点线 "dash_dot_dot"：交替短划线点点线</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="borders_on_top" type="xs:string">
      <xs:annotation>
        <xs:documentation>边框是否在顶层（即先绘制子控件，后绘制边框，避免边框被子控件覆盖）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="left_border_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>左边边框大小,如"1",设置该值大于0,则将忽略border_size属性的设置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="top_border_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>顶部边框大小,如"1",设置该值大于0,则将忽略border_size属性的设置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="right_border_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>右边边框大小,如"1",设置该值大于0,则将忽略border_size属性的设置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bottom_border_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>底部边框大小,如"1",设置该值大于0,则将忽略border_size属性的设置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="border_round" type="xs:string">
      <xs:annotation>
        <xs:documentation>边框圆角半径,如"2,2"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bkimage" type="xs:string">
      <xs:annotation>
        <xs:documentation>背景图片,如"bk.bmp或file='aaa.jpg' res='' dest='0,0,0,0' source='0,0,0,0' corner='0,0,0,0' fade='255' xtiled='false' ytiled='false'"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="normal_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>普通状态图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hovered_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标悬浮的状态图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pressed_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标按下的状态图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>禁用的状态图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fore_normal_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>普通状态前景图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fore_hovered_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标悬浮的状态前景图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fore_pressed_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标按下的状态前景图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fore_disabled_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>禁用的状态前景图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tooltip_text" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标悬浮提示,如"请在这里输入你的密码"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tooltip_text_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标悬浮提示,指定多语言模块的ID,当tooltiptext为空时则显示此属性,如"TOOL_TIP_ID"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tooltip_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标悬浮提示所占的宽度</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="data_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>自定义字符串数据,辅助函数，供用户使用</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="user_data_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>自定义整型数据, 供用户使用</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="enabled" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否可以响应用户操作,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="mouse_enabled" type="xs:string">
      <xs:annotation>
        <xs:documentation>本控件是否可以响应鼠标操作,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="keyboard_enabled" type="xs:string">
      <xs:annotation>
        <xs:documentation>非CButtonUI类忽略该值,为false时不支持TAB_STOP,且该对象不处理键盘信息</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="visible" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否可见,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_visible" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否可见,如"true",此属性会触发控件动画效果</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="menu" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否需要右键菜单,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="no_focus" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否可以获取焦点,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tab_stop" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许通过按TAB键切换到此控件</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="show_focused_rect" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否显示焦点状态(一个虚线构成的矩形)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="focused_rect_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>焦点状态矩形的颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="alpha" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的整体透明度,如alpha="128"，有效值为 0-255</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="state" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的当前状态: 支持normal、hovered、pressed、disabled状态</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="cursor_type" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标移动到控件上时的鼠标光标: "arrow"：箭头 "hand"：手型 "wait"：忙碌 "cross"：十字线 "ibeam"：I型光标,文本光标 "size_we"：水平调整 "size_ns"：垂直调整 "size_nwse"：对角线调整，西北-东南调整 "size_nesw"：对角线调整，东北-西南调整 "size_all"：移动，四向调整 "no"：禁止光标 "progress"：进度，应用启动光标</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="render_offset" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件绘制时的偏移量,如"10,10",一般用于绘制动画</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_hovered" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件鼠标悬停状态下的透明渐变动画,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_hovered_frame_interval_ms" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置播放Hovered状态动画的定时器时间间隔（毫秒）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_hovered_total_ms" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置Hovered状态动画总的播放时间（毫秒）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_hovered_easing_function" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置Hovered状态动画缓动函数类型,支持的缓动函数类型参见EasingFunctions::GetEasingFunctionType实现函数</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_alpha" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件透明渐变动画。有效值如下： fade_alpha="false"：不启用控件透明渐变动画 fade_alpha="true"：启用控件透明渐变动画，最终控件的Alpha值设置为255 fade_alpha="128"：启用控件透明渐变动画，最终控件的Alpha值设置为128，这种情况下的有效值为1-255。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件宽度渐变动画,如"true"。控件宽度不能是拉伸类型，该属性必须写在width属性后面</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_height" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件高度渐变动画,如"true"。控件高度不能是拉伸类型，该属性必须写height属性后面</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件大小（高度和宽度）的渐变动画,如"true"。控件高度和宽度不能是拉伸类型，该属性必须写height属性和width属性后面</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_in_out_x_from_left" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件从左到右的动画,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_in_out_x_from_right" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件从右到左的动画,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_in_out_y_from_top" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件从上到下的动画,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_in_out_y_from_bottom" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件从下到上的动画,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_frame_interval_ms" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置播放动画的定时器时间间隔（毫秒）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_total_ms" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置动画总的播放时间（毫秒）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_easing_function" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置动画缓动函数类型,支持的缓动函数类型参见EasingFunctions::GetEasingFunctionType实现函数</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="loading" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置控件加载中状态的UI显示相关属性，使用方法与Image属性相似。 使用示例：loading="file='loading.xml' width='0' height='0' offset_x='-1' offset_y='-1' valign='center' halign='center' fade='255' animation_control='loading_animation' auto_stop='true'" loading的可用属性如下： "file": XML资源文件名，根据此设置去加载XML资源，最终放在一个Box容器中显示 "width": longding控件的显示宽度，像素 "height": longding控件的显示高度，像素 "offset_x": longding控件的位置X方向偏移，相对于关联控件的左上角，有效值: &gt;= 0 "offset_y": longding控件的位置Y方向偏移，相对于关联控件的左上角，有效值: &gt;= 0 "halign":水平方向对齐方式，可取值："left" "center" "right"，仅当offset_x不含有效值时生效 "valign":垂直方向对齐方式，可取值："top" "center" "bottom"，仅当offset_y不含有效值时生效 "fade":loading控件的透明度，有效值： 0 - 255 "auto_stop"：loading动画播放结束以后，自动停止loading状态（自动调用StopLoading()函数） "animation_control":动画控件的名称，用于Loading功能与loading控件上的动画控件交互使用 loading功能的完整演示，可参考examples/ListCtrl示例程序</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="paint_order" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置绘制顺序：0 表示常规绘制，非0表示指定绘制顺序，值越大表示越晚绘制</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="start_image_animation" type="xs:string">
      <xs:annotation>
        <xs:documentation>播放动画，最多3个参数，每个参数用','分割，详见函数的参数列表</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="stop_image_animation" type="xs:string">
      <xs:annotation>
        <xs:documentation>停止动画，最多3个参数，每个参数用','分割 ，详见函数的参数列表</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="set_image_animation_frame" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置动画当前帧，最多2个参数，每个参数用','分割，详见函数的参数列表</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="box_shadow" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置控件的阴影属性，举例：boxshadow="color='red' offset='0,0' blurradius='8' spreadradius='8'"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="enable_drag_drop" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许拖放操作，包括拖入文件和拖入文本</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="enable_drop_file" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许拖入文件操作</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="drop_file_types" type="xs:string">
      <xs:annotation>
        <xs:documentation>拖放文件操作支持的后缀名列表，比如:".txt;.csv"，表示仅支持txt和csv文件；如果为空，表示支持所有文件</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="row_span" type="xs:string">
      <xs:annotation>
        <xs:documentation>单元格合并属性，占几行（默认占1行），仅在GridLayout布局中生效</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="col_span" type="xs:string">
      <xs:annotation>
        <xs:documentation>单元格合并属性，占几列（默认占1列），仅在GridLayout布局中生效</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="AutoCompleteAttrs">
    <!-- 来源：AutoComplete -->
    <xs:attribute name="items" type="xs:string">
      <xs:annotation>
        <xs:documentation>初始候选数据源，多个候选项以分号;分隔（也可通过代码SetCandidates设置）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="prompt_text" type="xs:string">
      <xs:annotation>
        <xs:documentation>编辑框为空时显示的占位提示文本</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="prompt_text_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>占位提示文本的多语言字符串ID</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="prompt_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>占位提示文本的颜色（语义色名）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="min_chars" type="xs:string">
      <xs:annotation>
        <xs:documentation>输入达到多少个字符后开始联想</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="max_visible" type="xs:string">
      <xs:annotation>
        <xs:documentation>浮层最多可见候选行数，超出显示滚动条</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="match_mode" type="xs:string">
      <xs:annotation>
        <xs:documentation>文本匹配模式：prefix前缀匹配（候选项以输入文本开头）；contains包含匹配（任意位置包含）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="ignore_case" type="xs:string">
      <xs:annotation>
        <xs:documentation>匹配时是否忽略大小写</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="AvatarAttrs">
    <!-- 来源：Avatar -->
    <xs:attribute name="size" type="xs:string">
      <xs:annotation>
        <xs:documentation>头像尺寸：small(24) / default或medium(32) / large(40) / 数值（像素）；同时设置固定宽高</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="shape" type="xs:string">
      <xs:annotation>
        <xs:documentation>形状：circle（默认）/ square</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="corner" type="xs:string">
      <xs:annotation>
        <xs:documentation>方形头像的圆角半径（DPI自适应）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="image" type="xs:string">
      <xs:annotation>
        <xs:documentation>头像图片（完整图片属性串，如file='xxx.png' svg_replace_colors='...'），按cover填充并裁剪</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="icon" type="xs:string">
      <xs:annotation>
        <xs:documentation>头像图标（完整图片属性串），按contain居中</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="icon_scale" type="xs:string">
      <xs:annotation>
        <xs:documentation>图标边长占控件短边的百分比（1~100）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="text" type="xs:string">
      <xs:annotation>
        <xs:documentation>文字内容（优先于text_id）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="text_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>文字内容的多语言ID</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="font" type="xs:string">
      <xs:annotation>
        <xs:documentation>字体ID（决定字体族与粗斜体，字号由text_scale换算）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="font_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>字体ID（决定字体族与粗斜体，字号由text_scale换算）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="text_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>文字颜色（语义色名）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="text_scale" type="xs:string">
      <xs:annotation>
        <xs:documentation>字号占控件短边的百分比（1~100）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="color" type="xs:string">
      <xs:annotation>
        <xs:documentation>头像底色（语义色名），优先级最高</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="avatar_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>头像底色（语义色名），优先级最高</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="palette" type="xs:string">
      <xs:annotation>
        <xs:documentation>文字头像是否按文本自动配色（取bg_avatar_1..6）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="BadgeAttrs">
    <!-- 来源：Badge -->
    <xs:attribute name="count" type="xs:string">
      <xs:annotation>
        <xs:documentation>角标数量：数字模式下大于0时显示角标，小于等于0时自动隐藏（红点模式不受影响）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="max_count" type="xs:string">
      <xs:annotation>
        <xs:documentation>数量上限，超过上限时显示"上限+"（如"99+"）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="dot" type="xs:string">
      <xs:annotation>
        <xs:documentation>红点模式：true为纯小圆点，不显示数字</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="badge_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>角标背景颜色（语义色名或颜色值）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="LabelAttrs">
    <!-- 来源：Label -->
    <xs:attribute name="text" type="xs:string">
      <xs:annotation>
        <xs:documentation>显示文本</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="text_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>多语言功能的文本ID</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="rich_text" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置文本内容是否为RichText 使用示例如下：&lt;Label rich_text="true" text="一个简单&lt;b&gt;窗口&lt;/b&gt; 带有&lt;u&gt;标题栏&lt;/u&gt;和&lt;u&gt;常规按钮&lt;/u&gt;，&lt;b&gt;粗体，&lt;font color='#FF0000'&gt;红色字体&lt;/font&gt;&lt;/b&gt;" /&gt; 备注：在支持RichText的模式下，不支持如下功能： （1）对齐方式不支持两端对齐 （2）不支持vertical_text属性（也不支持纵向文本相关属性） （3）不支持end_ellipsis属性 （4）不支持path_ellipsis属性 （5）不支持auto_tooltip属性 （6）不支持word_spacing属性</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="text_align" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置文字的水平与垂直对齐方式，用半角逗号分隔，如"hcenter,vcenter" 。 水平对齐方式可取值：left（靠左对齐）、hcenter（居中对齐）、right（靠右对齐）、hjustify（两端对齐） 垂直对齐方式可取值：top（靠上对齐）、vcenter（居中对齐）、bottom（靠下对齐）、vjustify（两端对齐）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="text_padding" type="xs:string">
      <xs:annotation>
        <xs:documentation>文字显示的内边距, 格式为"left,top,right,bottom"，分别代表在目标区域的左侧、上方、右侧、下方设置内边距值，如："2,2,2,2"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="font" type="xs:string">
      <xs:annotation>
        <xs:documentation>字体ID，该字体ID必须在 global.xml 中存在</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="end_ellipsis" type="xs:string">
      <xs:annotation>
        <xs:documentation>句末显示不完整是否使用 ... 代替</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="path_ellipsis" type="xs:string">
      <xs:annotation>
        <xs:documentation>对于路径，显示不完整时是否使用 ... 代替中间路径</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="text_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>普通字体颜色,不指定则使用默认颜色，如 "blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="normal_text_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>普通字体颜色,不指定则使用默认颜色，如 "blue"，该属性与text_color属性相同</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hovered_text_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标悬浮字体颜色,不指定则使用默认颜色，如 "blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pressed_text_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标按下字体颜色,不指定则使用默认颜色，如 "blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_text_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>disabled字体颜色,不指定则使用默认颜色，如 "blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="single_line" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否单行输出文字</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="multi_line" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否多行输出文字，与single_line属性互斥</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="auto_tooltip" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标悬浮到控件显示的提示文本是否省略号出现时才显示</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="replace_newline" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否替换文本中的换行符：将字符串"\\\\n"替换为换行符"\n"，这样可以在XML中使用括号中这两个字符(\n)来当作换行符，从而支持多行文本，举例：原始字符串为"第一行\\\\n第二行"，当为true时，"\\\\n"这两个字符会被替换为换行符"\n"，最终字符串变成"第一行\n第二行"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="spacing_mul" type="xs:string">
      <xs:annotation>
        <xs:documentation>行（列）间距的倍数, 是字体大小的倍数比例（默认值通常为 1.0，即 100% 字体大小），用于按比例调整行间距 设置后，实际的行间距为：字体大小 * spacing_mul + spacing_add</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="spacing_add" type="xs:string">
      <xs:annotation>
        <xs:documentation>行（列）间距附加量, 是固定的附加像素值（默认值通常为 0），用于在比例调整的基础上增加固定偏移(像素) 设置后，实际的行间距为：字体大小 * spacing_mul + spacing_add</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="word_spacing" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置两个相邻的字符之间的间隔（像素）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="vertical_text" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置文本方向：true为纵向文本，false为横向文本 横向文本绘制方向：从左到右，从上到下 纵向文本绘制方向：从上到下，从右到左</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="use_font_height" type="xs:string">
      <xs:annotation>
        <xs:documentation>当纵向绘制文本时，设置字间距使用该字体的默认高度，而不是每个字的实际高度（显示时所有字体等高）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="ascii_rotate_90" type="xs:string">
      <xs:annotation>
        <xs:documentation>当纵向绘制文本时，对于字母、数字等字符，顺时针旋转90度显示</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="ControlAttrs2">
    <!-- 来源：Control -->
    <xs:attribute name="class" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件样式,用样式里面的属性值来设置本控件的属性,如"btn_default",可以同时指定多个样式,各个样式之间用空格分隔,需要写在第一个属性位置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="enable_vars" type="xs:string">
      <xs:annotation>
        <xs:documentation>属性值中是否支持变量展开。 用法举例：假设在globle.xml中增加一行变量定义：&lt;Define name="SIZE_ICON_SMALL" value="16"/&gt; XML中的控件属性字符串中可以这样使用这个变量：width="${SIZE_ICON_SMALL}" 代码中也可以这样调用函数设置属性代码：Control::SetAttribute(_T("width"), _T("${SIZE_ICON_SMALL}"));</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="name" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件名字,同一窗口建议保持唯一，否则影响查询效率，也可能查询不到正确的结果</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="xs:string">
      <xs:annotation>
        <xs:documentation>可以设置int或string类型的值.当值为int是则设置控件的宽度值,如"100";当值为string时,stretch代表由父容器计算控件宽度,auto代表根据内容情况自动计算宽度,如果为百分比值"50%"，代表该控件的宽度期望值为父控件宽度的50%</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="xs:string">
      <xs:annotation>
        <xs:documentation>可以设置int或string类型的值.当值为int是则设置控件的高度值,如"100";当值为string时,stretch代表由父容器计算控件高度,auto代表根据内容情况自动计算高度,如果为百分比值"30%"，代表该控件的高度期望值为父控件高度的30%</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="min_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的最小宽度,如"30"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="min_height" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的最小高度,如"30"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="max_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的最大宽度,描述同width</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="max_height" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的最大高度,描述同height</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="margin" type="xs:string">
      <xs:annotation>
        <xs:documentation>外边距,如"2,2,2,2"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="padding" type="xs:string">
      <xs:annotation>
        <xs:documentation>内边距,如"2,2,2,2"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="control_padding" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许控件自身运用内边距</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="halign" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的水平方向的对齐方式,如"center",支持left、center、right三种位置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="valign" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的垂直方向的对齐方式,如"center",支持top、center、bottom三种位置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="align" type="xs:string">
      <xs:annotation>
        <xs:documentation>同时设置控件的水平方向和垂直方向的对齐方式，功能与valign和halign相同。 可取值: left、right、hcenter、top、vcenter、bottom，用逗号分割，如"hcenter,vcenter"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="float" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否使用绝对定位,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="keep_float_pos" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置当父控件位置和大小调整时，是否保持浮动控件相对父控件的位置不变,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bkcolor" type="xs:string">
      <xs:annotation>
        <xs:documentation>背景颜色字符串常量,如"white"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bkcolor2" type="xs:string">
      <xs:annotation>
        <xs:documentation>第二背景颜色字符串常量,如果设置了第二背景色，则支持背景颜色渐变,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bkcolor2_direction" type="xs:string">
      <xs:annotation>
        <xs:documentation>第二背景色方向，"1": 左-&gt;右，"2": 上-&gt;下，"3": 左上-&gt;右下，"4": 右上-&gt;左下</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fore_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>前景颜色字符串，前景色一般设置半透明的颜色，比如"#10006DD9"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="normal_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>普通状态颜色,如"white"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hovered_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>悬浮状态颜色,如"white"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pressed_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>按下状态颜色,如"white"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>禁用状态颜色,如"white"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="normal_color_margin" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置普通状态下的控件颜色外边距</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hovered_color_margin" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置悬浮状态下的控件颜色外边距</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pressed_color_margin" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置按下状态下的控件颜色外边距</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_color_margin" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置禁用状态下的控件颜色外边距</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="state_color_min_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置状态颜色区域的最小宽度（解决设置Margin后，DPI缩放运算精度损失导致线条宽度失真问题）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="state_color_min_height" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置状态颜色区域的最小高度（解决设置Margin后，DPI缩放运算精度损失导致线条宽度失真问题）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="normal_color_round" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置普通状态下的控件颜色圆角大小</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hovered_color_round" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置悬浮状态下的控件颜色圆角大小</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pressed_color_round" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置按下状态下的控件颜色圆角大小</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_color_round" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置禁用状态下的控件颜色圆角大小</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置所有状态下的边框颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="normal_border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>正常状态的边框颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hovered_border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>悬浮状态的边框颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pressed_border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>按下状态的边框颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>禁止状态的边框颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="focused_border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>焦点状态的边框颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="border_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>可以设置int或rect类型的值。当值为int时则左、上、右、下都用该值作为宽。值为rect类型时则分别设置左、上、右、下的边框</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="border_dash_style" type="xs:string">
      <xs:annotation>
        <xs:documentation>线的形状，可选值： "solid"：实线 "dash"：短划线构成的虚线 "dot"：点构成的虚线 "dash_dot"：交替短划线点线 "dash_dot_dot"：交替短划线点点线</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="borders_on_top" type="xs:string">
      <xs:annotation>
        <xs:documentation>边框是否在顶层（即先绘制子控件，后绘制边框，避免边框被子控件覆盖）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="left_border_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>左边边框大小,如"1",设置该值大于0,则将忽略border_size属性的设置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="top_border_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>顶部边框大小,如"1",设置该值大于0,则将忽略border_size属性的设置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="right_border_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>右边边框大小,如"1",设置该值大于0,则将忽略border_size属性的设置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bottom_border_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>底部边框大小,如"1",设置该值大于0,则将忽略border_size属性的设置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="border_round" type="xs:string">
      <xs:annotation>
        <xs:documentation>边框圆角半径,如"2,2"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bkimage" type="xs:string">
      <xs:annotation>
        <xs:documentation>背景图片,如"bk.bmp或file='aaa.jpg' res='' dest='0,0,0,0' source='0,0,0,0' corner='0,0,0,0' fade='255' xtiled='false' ytiled='false'"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="normal_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>普通状态图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hovered_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标悬浮的状态图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pressed_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标按下的状态图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>禁用的状态图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fore_normal_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>普通状态前景图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fore_hovered_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标悬浮的状态前景图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fore_pressed_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标按下的状态前景图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fore_disabled_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>禁用的状态前景图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tooltip_text" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标悬浮提示,如"请在这里输入你的密码"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tooltip_text_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标悬浮提示,指定多语言模块的ID,当tooltiptext为空时则显示此属性,如"TOOL_TIP_ID"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tooltip_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标悬浮提示所占的宽度</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="data_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>自定义字符串数据,辅助函数，供用户使用</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="user_data_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>自定义整型数据, 供用户使用</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="enabled" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否可以响应用户操作,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="mouse_enabled" type="xs:string">
      <xs:annotation>
        <xs:documentation>本控件是否可以响应鼠标操作,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="keyboard_enabled" type="xs:string">
      <xs:annotation>
        <xs:documentation>非CButtonUI类忽略该值,为false时不支持TAB_STOP,且该对象不处理键盘信息</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="visible" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否可见,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_visible" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否可见,如"true",此属性会触发控件动画效果</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="menu" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否需要右键菜单,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="no_focus" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否可以获取焦点,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tab_stop" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许通过按TAB键切换到此控件</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="show_focused_rect" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否显示焦点状态(一个虚线构成的矩形)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="focused_rect_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>焦点状态矩形的颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="alpha" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的整体透明度,如alpha="128"，有效值为 0-255</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="state" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的当前状态: 支持normal、hovered、pressed、disabled状态</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="cursor_type" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标移动到控件上时的鼠标光标: "arrow"：箭头 "hand"：手型 "wait"：忙碌 "cross"：十字线 "ibeam"：I型光标,文本光标 "size_we"：水平调整 "size_ns"：垂直调整 "size_nwse"：对角线调整，西北-东南调整 "size_nesw"：对角线调整，东北-西南调整 "size_all"：移动，四向调整 "no"：禁止光标 "progress"：进度，应用启动光标</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="render_offset" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件绘制时的偏移量,如"10,10",一般用于绘制动画</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_hovered" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件鼠标悬停状态下的透明渐变动画,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_hovered_frame_interval_ms" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置播放Hovered状态动画的定时器时间间隔（毫秒）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_hovered_total_ms" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置Hovered状态动画总的播放时间（毫秒）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_hovered_easing_function" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置Hovered状态动画缓动函数类型,支持的缓动函数类型参见EasingFunctions::GetEasingFunctionType实现函数</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_alpha" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件透明渐变动画。有效值如下： fade_alpha="false"：不启用控件透明渐变动画 fade_alpha="true"：启用控件透明渐变动画，最终控件的Alpha值设置为255 fade_alpha="128"：启用控件透明渐变动画，最终控件的Alpha值设置为128，这种情况下的有效值为1-255。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件宽度渐变动画,如"true"。控件宽度不能是拉伸类型，该属性必须写在width属性后面</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_height" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件高度渐变动画,如"true"。控件高度不能是拉伸类型，该属性必须写height属性后面</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件大小（高度和宽度）的渐变动画,如"true"。控件高度和宽度不能是拉伸类型，该属性必须写height属性和width属性后面</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_in_out_x_from_left" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件从左到右的动画,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_in_out_x_from_right" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件从右到左的动画,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_in_out_y_from_top" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件从上到下的动画,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_in_out_y_from_bottom" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件从下到上的动画,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_frame_interval_ms" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置播放动画的定时器时间间隔（毫秒）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_total_ms" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置动画总的播放时间（毫秒）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_easing_function" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置动画缓动函数类型,支持的缓动函数类型参见EasingFunctions::GetEasingFunctionType实现函数</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="loading" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置控件加载中状态的UI显示相关属性，使用方法与Image属性相似。 使用示例：loading="file='loading.xml' width='0' height='0' offset_x='-1' offset_y='-1' valign='center' halign='center' fade='255' animation_control='loading_animation' auto_stop='true'" loading的可用属性如下： "file": XML资源文件名，根据此设置去加载XML资源，最终放在一个Box容器中显示 "width": longding控件的显示宽度，像素 "height": longding控件的显示高度，像素 "offset_x": longding控件的位置X方向偏移，相对于关联控件的左上角，有效值: &gt;= 0 "offset_y": longding控件的位置Y方向偏移，相对于关联控件的左上角，有效值: &gt;= 0 "halign":水平方向对齐方式，可取值："left" "center" "right"，仅当offset_x不含有效值时生效 "valign":垂直方向对齐方式，可取值："top" "center" "bottom"，仅当offset_y不含有效值时生效 "fade":loading控件的透明度，有效值： 0 - 255 "auto_stop"：loading动画播放结束以后，自动停止loading状态（自动调用StopLoading()函数） "animation_control":动画控件的名称，用于Loading功能与loading控件上的动画控件交互使用 loading功能的完整演示，可参考examples/ListCtrl示例程序</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="paint_order" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置绘制顺序：0 表示常规绘制，非0表示指定绘制顺序，值越大表示越晚绘制</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="start_image_animation" type="xs:string">
      <xs:annotation>
        <xs:documentation>播放动画，最多3个参数，每个参数用','分割，详见函数的参数列表</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="stop_image_animation" type="xs:string">
      <xs:annotation>
        <xs:documentation>停止动画，最多3个参数，每个参数用','分割 ，详见函数的参数列表</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="set_image_animation_frame" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置动画当前帧，最多2个参数，每个参数用','分割，详见函数的参数列表</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="box_shadow" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置控件的阴影属性，举例：boxshadow="color='red' offset='0,0' blurradius='8' spreadradius='8'"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="enable_drag_drop" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许拖放操作，包括拖入文件和拖入文本</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="enable_drop_file" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许拖入文件操作</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="drop_file_types" type="xs:string">
      <xs:annotation>
        <xs:documentation>拖放文件操作支持的后缀名列表，比如:".txt;.csv"，表示仅支持txt和csv文件；如果为空，表示支持所有文件</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="row_span" type="xs:string">
      <xs:annotation>
        <xs:documentation>单元格合并属性，占几行（默认占1行），仅在GridLayout布局中生效</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="col_span" type="xs:string">
      <xs:annotation>
        <xs:documentation>单元格合并属性，占几列（默认占1列），仅在GridLayout布局中生效</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="BitmapControlAttrs">
    <!-- 来源：BitmapControl -->
    <xs:attribute name="bitmap_halign" type="xs:string">
      <xs:annotation>
        <xs:documentation>图片的水平对齐方式，可取值: "left"、"center"、"right"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bitmap_valign" type="xs:string">
      <xs:annotation>
        <xs:documentation>图片的垂直对齐方式，可取值: "top"、"center"、"bottom"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bitmap_alpha" type="xs:string">
      <xs:annotation>
        <xs:documentation>图片绘制时的透明度，可取值: 0 - 255</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bitmap_dest" type="xs:string">
      <xs:annotation>
        <xs:documentation>图片绘制目标区域位置和大小(相对于控件区域的位置)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bitmap_src" type="xs:string">
      <xs:annotation>
        <xs:documentation>图片绘制源区域位置和大小</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bitmap_margin" type="xs:string">
      <xs:annotation>
        <xs:documentation>绘制目标区域中的外边距(如果指定了dest值，此值无效)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bitmap_adaptive_dest_rect" type="xs:string">
      <xs:annotation>
        <xs:documentation>绘制时是否自动适应目标区域（等比例缩放图片）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bitmap_stretch" type="xs:string">
      <xs:annotation>
        <xs:documentation>绘制时是否拉伸绘制图片（与IsAdaptiveDestRect()互斥，优先级低于IsAdaptiveDestRect()）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bitmap_multi_thread" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否支持多线程操作位图数据（如果无调用，则默认为true，默认是支持多线程操作位图数据的）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="BoxDragableAttrs">
    <!-- 来源：BoxDragable -->
    <xs:attribute name="drag_order" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否支持拖动调整顺序（在同一个容器内）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="drag_alpha" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置拖动顺序时，控件的透明度（0 - 255）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="drag_out" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否支持拖出操纵（在相同窗口的不同容器内）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="BoxMovableAttrs">
    <!-- 来源：BoxMovable -->
    <xs:attribute name="enable_move_pos" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否支持拖动调整控件的位置，默认是开启的</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="move_pos_draggable_border" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件可移动矩形的边框范围（四周可点击拖动，但中心区域不可拖动）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="move_pos_non_draggable_margin" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件可移动矩形的外边距（外边距定义的四周区域不可点击拖动，仅中心区域可拖动）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="move_parent_pos" type="xs:string">
      <xs:annotation>
        <xs:documentation>执行拖动调整控件位置操作时，是否调整父容器的位置，"true"表示调整父容器的位置，"false"表示调整控件自身的位置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="move_pos_alpha" type="xs:string">
      <xs:annotation>
        <xs:documentation>拖动调整位置时，控件的透明度</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="move_pos_reserve_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>横向移动时，在父容器内保留的高度，避免控件完全溢出父容器(未经DPI缩放)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="move_pos_reserve_height" type="xs:string">
      <xs:annotation>
        <xs:documentation>纵向移动时，在父容器内保留的宽度，避免控件完全溢出父容器(未经DPI缩放)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="move_pos_keep_within_parent" type="xs:string">
      <xs:annotation>
        <xs:documentation>移动控件时，确保子控件位于父容器内，无溢出</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="BoxResizableAttrs">
    <!-- 来源：BoxResizable -->
    <xs:attribute name="enable_resize" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否支持鼠标拖动改变控件的大小</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="enable_move_pos" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否支持拖动调整控件的位置，默认是关闭的；若开启，则相关属性可参考ControlMovableT的属性</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="resize_size_box" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置控件四边调整大小时的可拉伸范围的大小</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="resize_reserve_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置调整大小时，保留的最小宽度(未经DPI缩放)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="resize_reserve_height" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置调整大小时，保留的最小高度(未经DPI缩放)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="resize_keep_within_parent" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置调整控件大小时，是否确保子控件位于父容器内，无溢出</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="ControlMovableTAttrs">
    <!-- 来源：ControlMovableT -->
    <xs:attribute name="move_pos_draggable_border" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件可移动矩形的边框范围（四周可点击拖动，但中心区域不可拖动）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="move_pos_non_draggable_margin" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件可移动矩形的外边距（外边距定义的四周区域不可点击拖动，仅中心区域可拖动）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="move_parent_pos" type="xs:string">
      <xs:annotation>
        <xs:documentation>执行拖动调整控件位置操作时，是否调整父容器的位置，"true"表示调整父容器的位置，"false"表示调整控件自身的位置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="move_pos_alpha" type="xs:string">
      <xs:annotation>
        <xs:documentation>拖动调整位置时，控件的透明度</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="move_pos_reserve_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>横向移动时，在父容器内保留的高度，避免控件完全溢出父容器(未经DPI缩放)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="move_pos_reserve_height" type="xs:string">
      <xs:annotation>
        <xs:documentation>纵向移动时，在父容器内保留的宽度，避免控件完全溢出父容器(未经DPI缩放)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="move_pos_keep_within_parent" type="xs:string">
      <xs:annotation>
        <xs:documentation>移动控件时，确保子控件位于父容器内，无溢出</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="BreadcrumbAttrs">
    <!-- 来源：Breadcrumb -->
    <xs:attribute name="current" type="xs:string">
      <xs:annotation>
        <xs:documentation>当前项索引（0 起）；-1 表示自动跟随最后一项</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="separator" type="xs:string">
      <xs:annotation>
        <xs:documentation>条目之间的分隔符</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="spacing" type="xs:string">
      <xs:annotation>
        <xs:documentation>分隔符两侧的间距（像素，自动 DPI 缩放）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="item_padding" type="xs:string">
      <xs:annotation>
        <xs:documentation>条目点击区域左右内边距（像素，自动 DPI 缩放）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="item_round" type="xs:string">
      <xs:annotation>
        <xs:documentation>悬停 / 按下胶囊背景的圆角半径（像素，自动 DPI 缩放）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="click_to_jump" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许点击祖先项切换当前项</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="item_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>可点击祖先项颜色（语义色名或颜色值）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="current_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>当前项颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hovered_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>祖先项悬停颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pressed_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>祖先项按下颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>禁用项颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="separator_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>分隔符颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hover_bg_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>悬停状态胶囊背景色（留空则不绘制）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pressed_bg_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>按下状态胶囊背景色（留空则不绘制）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="font" type="xs:string">
      <xs:annotation>
        <xs:documentation>普通条目与分隔符的字体 ID</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="current_font" type="xs:string">
      <xs:annotation>
        <xs:documentation>当前项字体 ID（加粗强调）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="ControlAttrs3">
    <!-- 来源：Control -->
    <xs:attribute name="class" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件样式,用样式里面的属性值来设置本控件的属性,如"btn_default",可以同时指定多个样式,各个样式之间用空格分隔,需要写在第一个属性位置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="enable_vars" type="xs:string">
      <xs:annotation>
        <xs:documentation>属性值中是否支持变量展开。 用法举例：假设在globle.xml中增加一行变量定义：&lt;Define name="SIZE_ICON_SMALL" value="16"/&gt; XML中的控件属性字符串中可以这样使用这个变量：width="${SIZE_ICON_SMALL}" 代码中也可以这样调用函数设置属性代码：Control::SetAttribute(_T("width"), _T("${SIZE_ICON_SMALL}"));</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="name" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件名字,同一窗口建议保持唯一，否则影响查询效率，也可能查询不到正确的结果</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="xs:string">
      <xs:annotation>
        <xs:documentation>可以设置int或string类型的值.当值为int是则设置控件的宽度值,如"100";当值为string时,stretch代表由父容器计算控件宽度,auto代表根据内容情况自动计算宽度,如果为百分比值"50%"，代表该控件的宽度期望值为父控件宽度的50%</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="xs:string">
      <xs:annotation>
        <xs:documentation>可以设置int或string类型的值.当值为int是则设置控件的高度值,如"100";当值为string时,stretch代表由父容器计算控件高度,auto代表根据内容情况自动计算高度,如果为百分比值"30%"，代表该控件的高度期望值为父控件高度的30%</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="min_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的最小宽度,如"30"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="min_height" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的最小高度,如"30"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="max_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的最大宽度,描述同width</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="max_height" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的最大高度,描述同height</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="margin" type="xs:string">
      <xs:annotation>
        <xs:documentation>外边距,如"2,2,2,2"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="padding" type="xs:string">
      <xs:annotation>
        <xs:documentation>内边距,如"2,2,2,2"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="control_padding" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许控件自身运用内边距</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="halign" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的水平方向的对齐方式,如"center",支持left、center、right三种位置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="valign" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的垂直方向的对齐方式,如"center",支持top、center、bottom三种位置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="align" type="xs:string">
      <xs:annotation>
        <xs:documentation>同时设置控件的水平方向和垂直方向的对齐方式，功能与valign和halign相同。 可取值: left、right、hcenter、top、vcenter、bottom，用逗号分割，如"hcenter,vcenter"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="float" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否使用绝对定位,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="keep_float_pos" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置当父控件位置和大小调整时，是否保持浮动控件相对父控件的位置不变,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bkcolor" type="xs:string">
      <xs:annotation>
        <xs:documentation>背景颜色字符串常量,如"white"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bkcolor2" type="xs:string">
      <xs:annotation>
        <xs:documentation>第二背景颜色字符串常量,如果设置了第二背景色，则支持背景颜色渐变,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bkcolor2_direction" type="xs:string">
      <xs:annotation>
        <xs:documentation>第二背景色方向，"1": 左-&gt;右，"2": 上-&gt;下，"3": 左上-&gt;右下，"4": 右上-&gt;左下</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fore_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>前景颜色字符串，前景色一般设置半透明的颜色，比如"#10006DD9"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="normal_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>普通状态颜色,如"white"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="normal_color_margin" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置普通状态下的控件颜色外边距</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hovered_color_margin" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置悬浮状态下的控件颜色外边距</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pressed_color_margin" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置按下状态下的控件颜色外边距</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_color_margin" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置禁用状态下的控件颜色外边距</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="state_color_min_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置状态颜色区域的最小宽度（解决设置Margin后，DPI缩放运算精度损失导致线条宽度失真问题）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="state_color_min_height" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置状态颜色区域的最小高度（解决设置Margin后，DPI缩放运算精度损失导致线条宽度失真问题）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="normal_color_round" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置普通状态下的控件颜色圆角大小</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hovered_color_round" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置悬浮状态下的控件颜色圆角大小</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pressed_color_round" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置按下状态下的控件颜色圆角大小</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_color_round" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置禁用状态下的控件颜色圆角大小</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置所有状态下的边框颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="normal_border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>正常状态的边框颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hovered_border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>悬浮状态的边框颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pressed_border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>按下状态的边框颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>禁止状态的边框颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="focused_border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>焦点状态的边框颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="border_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>可以设置int或rect类型的值。当值为int时则左、上、右、下都用该值作为宽。值为rect类型时则分别设置左、上、右、下的边框</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="border_dash_style" type="xs:string">
      <xs:annotation>
        <xs:documentation>线的形状，可选值： "solid"：实线 "dash"：短划线构成的虚线 "dot"：点构成的虚线 "dash_dot"：交替短划线点线 "dash_dot_dot"：交替短划线点点线</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="borders_on_top" type="xs:string">
      <xs:annotation>
        <xs:documentation>边框是否在顶层（即先绘制子控件，后绘制边框，避免边框被子控件覆盖）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="left_border_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>左边边框大小,如"1",设置该值大于0,则将忽略border_size属性的设置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="top_border_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>顶部边框大小,如"1",设置该值大于0,则将忽略border_size属性的设置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="right_border_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>右边边框大小,如"1",设置该值大于0,则将忽略border_size属性的设置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bottom_border_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>底部边框大小,如"1",设置该值大于0,则将忽略border_size属性的设置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="border_round" type="xs:string">
      <xs:annotation>
        <xs:documentation>边框圆角半径,如"2,2"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bkimage" type="xs:string">
      <xs:annotation>
        <xs:documentation>背景图片,如"bk.bmp或file='aaa.jpg' res='' dest='0,0,0,0' source='0,0,0,0' corner='0,0,0,0' fade='255' xtiled='false' ytiled='false'"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="normal_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>普通状态图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hovered_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标悬浮的状态图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pressed_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标按下的状态图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>禁用的状态图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fore_normal_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>普通状态前景图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fore_hovered_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标悬浮的状态前景图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fore_pressed_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标按下的状态前景图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fore_disabled_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>禁用的状态前景图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tooltip_text" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标悬浮提示,如"请在这里输入你的密码"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tooltip_text_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标悬浮提示,指定多语言模块的ID,当tooltiptext为空时则显示此属性,如"TOOL_TIP_ID"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tooltip_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标悬浮提示所占的宽度</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="data_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>自定义字符串数据,辅助函数，供用户使用</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="user_data_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>自定义整型数据, 供用户使用</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="enabled" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否可以响应用户操作,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="mouse_enabled" type="xs:string">
      <xs:annotation>
        <xs:documentation>本控件是否可以响应鼠标操作,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="keyboard_enabled" type="xs:string">
      <xs:annotation>
        <xs:documentation>非CButtonUI类忽略该值,为false时不支持TAB_STOP,且该对象不处理键盘信息</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="visible" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否可见,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_visible" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否可见,如"true",此属性会触发控件动画效果</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="menu" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否需要右键菜单,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="no_focus" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否可以获取焦点,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tab_stop" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许通过按TAB键切换到此控件</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="show_focused_rect" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否显示焦点状态(一个虚线构成的矩形)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="focused_rect_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>焦点状态矩形的颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="alpha" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的整体透明度,如alpha="128"，有效值为 0-255</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="state" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的当前状态: 支持normal、hovered、pressed、disabled状态</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="cursor_type" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标移动到控件上时的鼠标光标: "arrow"：箭头 "hand"：手型 "wait"：忙碌 "cross"：十字线 "ibeam"：I型光标,文本光标 "size_we"：水平调整 "size_ns"：垂直调整 "size_nwse"：对角线调整，西北-东南调整 "size_nesw"：对角线调整，东北-西南调整 "size_all"：移动，四向调整 "no"：禁止光标 "progress"：进度，应用启动光标</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="render_offset" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件绘制时的偏移量,如"10,10",一般用于绘制动画</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_hovered" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件鼠标悬停状态下的透明渐变动画,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_hovered_frame_interval_ms" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置播放Hovered状态动画的定时器时间间隔（毫秒）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_hovered_total_ms" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置Hovered状态动画总的播放时间（毫秒）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_hovered_easing_function" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置Hovered状态动画缓动函数类型,支持的缓动函数类型参见EasingFunctions::GetEasingFunctionType实现函数</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_alpha" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件透明渐变动画。有效值如下： fade_alpha="false"：不启用控件透明渐变动画 fade_alpha="true"：启用控件透明渐变动画，最终控件的Alpha值设置为255 fade_alpha="128"：启用控件透明渐变动画，最终控件的Alpha值设置为128，这种情况下的有效值为1-255。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件宽度渐变动画,如"true"。控件宽度不能是拉伸类型，该属性必须写在width属性后面</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_height" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件高度渐变动画,如"true"。控件高度不能是拉伸类型，该属性必须写height属性后面</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件大小（高度和宽度）的渐变动画,如"true"。控件高度和宽度不能是拉伸类型，该属性必须写height属性和width属性后面</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_in_out_x_from_left" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件从左到右的动画,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_in_out_x_from_right" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件从右到左的动画,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_in_out_y_from_top" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件从上到下的动画,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_in_out_y_from_bottom" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件从下到上的动画,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_frame_interval_ms" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置播放动画的定时器时间间隔（毫秒）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_total_ms" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置动画总的播放时间（毫秒）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_easing_function" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置动画缓动函数类型,支持的缓动函数类型参见EasingFunctions::GetEasingFunctionType实现函数</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="loading" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置控件加载中状态的UI显示相关属性，使用方法与Image属性相似。 使用示例：loading="file='loading.xml' width='0' height='0' offset_x='-1' offset_y='-1' valign='center' halign='center' fade='255' animation_control='loading_animation' auto_stop='true'" loading的可用属性如下： "file": XML资源文件名，根据此设置去加载XML资源，最终放在一个Box容器中显示 "width": longding控件的显示宽度，像素 "height": longding控件的显示高度，像素 "offset_x": longding控件的位置X方向偏移，相对于关联控件的左上角，有效值: &gt;= 0 "offset_y": longding控件的位置Y方向偏移，相对于关联控件的左上角，有效值: &gt;= 0 "halign":水平方向对齐方式，可取值："left" "center" "right"，仅当offset_x不含有效值时生效 "valign":垂直方向对齐方式，可取值："top" "center" "bottom"，仅当offset_y不含有效值时生效 "fade":loading控件的透明度，有效值： 0 - 255 "auto_stop"：loading动画播放结束以后，自动停止loading状态（自动调用StopLoading()函数） "animation_control":动画控件的名称，用于Loading功能与loading控件上的动画控件交互使用 loading功能的完整演示，可参考examples/ListCtrl示例程序</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="paint_order" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置绘制顺序：0 表示常规绘制，非0表示指定绘制顺序，值越大表示越晚绘制</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="start_image_animation" type="xs:string">
      <xs:annotation>
        <xs:documentation>播放动画，最多3个参数，每个参数用','分割，详见函数的参数列表</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="stop_image_animation" type="xs:string">
      <xs:annotation>
        <xs:documentation>停止动画，最多3个参数，每个参数用','分割 ，详见函数的参数列表</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="set_image_animation_frame" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置动画当前帧，最多2个参数，每个参数用','分割，详见函数的参数列表</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="box_shadow" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置控件的阴影属性，举例：boxshadow="color='red' offset='0,0' blurradius='8' spreadradius='8'"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="enable_drag_drop" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许拖放操作，包括拖入文件和拖入文本</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="enable_drop_file" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许拖入文件操作</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="drop_file_types" type="xs:string">
      <xs:annotation>
        <xs:documentation>拖放文件操作支持的后缀名列表，比如:".txt;.csv"，表示仅支持txt和csv文件；如果为空，表示支持所有文件</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="row_span" type="xs:string">
      <xs:annotation>
        <xs:documentation>单元格合并属性，占几行（默认占1行），仅在GridLayout布局中生效</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="col_span" type="xs:string">
      <xs:annotation>
        <xs:documentation>单元格合并属性，占几列（默认占1列），仅在GridLayout布局中生效</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="BoxAttrs2">
    <!-- 来源：Box -->
    <xs:attribute name="child_margin" type="xs:string">
      <xs:annotation>
        <xs:documentation>布局属性，子控件之间的间隔: X 轴方向 和 Y 轴方向同时设置为相同值</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="child_margin_x" type="xs:string">
      <xs:annotation>
        <xs:documentation>布局属性，子控件之间的间隔: X 轴方向</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="child_margin_y" type="xs:string">
      <xs:annotation>
        <xs:documentation>布局属性，子控件之间的间隔: Y 轴方向</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="child_valign" type="xs:string">
      <xs:annotation>
        <xs:documentation>布局属性，子控件的垂直方向对齐方式，可选值："top","center","bottom"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="child_halign" type="xs:string">
      <xs:annotation>
        <xs:documentation>布局属性，子控件的水平方向对齐方式，可选值："left","center","right"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="child_align" type="xs:string">
      <xs:annotation>
        <xs:documentation>布局属性，同时设置子控件的水平方向和垂直方向的对齐方式，功能与child_valign和child_halign相同。 可取值: left、right、hcenter、top、vcenter、bottom，用逗号分割，如"hcenter,vcenter"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="mouse_child" type="xs:string">
      <xs:annotation>
        <xs:documentation>子控件是否支持鼠标操作, true 或者 false</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="drag_out_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置是否支持拖拽拖出该容器：如果不等于0，支持拖出，否则不支持拖出（拖出到drop_in_id==drag_out_id的容器）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="drop_in_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置是否支持拖拽投放进入该容器: 如果不等于0，支持拖入，否则不支持拖入(从drag_out_id==drop_in_id的容器拖入到该容器)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="CalendarAttrs">
    <!-- 来源：Calendar -->
    <xs:attribute name="calendar_mode" type="xs:string">
      <xs:annotation>
        <xs:documentation>选择模式："single"单选，"range"范围选择</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="first_day_of_week" type="xs:string">
      <xs:annotation>
        <xs:documentation>每周第一天："monday"周一，"sunday"周日</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="min_date" type="xs:string">
      <xs:annotation>
        <xs:documentation>最小可选日期（格式：yyyy-mm-dd），空表示不限制</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="max_date" type="xs:string">
      <xs:annotation>
        <xs:documentation>最大可选日期（格式：yyyy-mm-dd），空表示不限制</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_dates" type="xs:string">
      <xs:annotation>
        <xs:documentation>业务禁用日期列表；多个项用 , 或 ; 分隔，每项为 yyyy-mm-dd 或 yyyy-mm-dd~yyyy-mm-dd（闭区间）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="CarouselAttrs">
    <!-- 来源：Carousel -->
    <xs:attribute name="current_index" type="xs:string">
      <xs:annotation>
        <xs:documentation>当前幻灯片索引（0 起），钳位到 [0, count-1]</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="loop" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否循环（首尾相接，无限滚动）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="auto_play" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否自动播放</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="interval" type="xs:string">
      <xs:annotation>
        <xs:documentation>自动播放间隔（毫秒）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hover_pause" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标悬停时暂停自动播放</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="transition_ms" type="xs:string">
      <xs:annotation>
        <xs:documentation>切换动画时长（毫秒，0 = 立即切换）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="show_indicator" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否显示页码指示点</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="indicator_normal_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>指示点常态图</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="indicator_active_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>指示点当前页图</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="indicator_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>指示点尺寸（像素，自动 DPI 缩放）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="indicator_gap" type="xs:string">
      <xs:annotation>
        <xs:documentation>指示点间距（像素，自动 DPI 缩放）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="indicator_bottom" type="xs:string">
      <xs:annotation>
        <xs:documentation>指示点距内容区底边距离（像素，自动 DPI 缩放）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="show_nav_button" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否显示左右切换按钮</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="btn_prev_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>上一张 / 下一张按钮图</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="btn_next_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>上一张 / 下一张按钮图</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="btn_prev_hovered_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>按钮悬停态图片（可选）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="btn_next_hovered_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>按钮悬停态图片（可选）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="btn_prev_pressed_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>按钮按下态图片（可选，回退悬停 / 常态）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="btn_next_pressed_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>按钮按下态图片（可选，回退悬停 / 常态）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="btn_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>切换按钮尺寸（像素，自动 DPI 缩放）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="btn_margin" type="xs:string">
      <xs:annotation>
        <xs:documentation>切换按钮距内容区边缘距离（像素，自动 DPI 缩放）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="CascadingSelectAttrs">
    <!-- 来源：CascadingSelect -->
    <xs:attribute name="items_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>多语言路径列表，格式同 items 但每段是语言 ID；语言切换时自动刷新</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="path_separator" type="xs:string">
      <xs:annotation>
        <xs:documentation>路径层级分隔符</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="value_separator" type="xs:string">
      <xs:annotation>
        <xs:documentation>GetSelectionText() 使用的连接符</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="column_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>固定列宽（像素，自动 DPI 缩放）；0 表示按控件宽度等分</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="row_height" type="xs:string">
      <xs:annotation>
        <xs:documentation>行高（像素，自动 DPI 缩放）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="text_padding" type="xs:string">
      <xs:annotation>
        <xs:documentation>行内文本左右内边距（像素，自动 DPI 缩放）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="item_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>普通行文本颜色（语义色名或颜色值）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="selected_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>选中行文本颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>禁用行文本颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hover_bg_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>悬停行背景色（留空则不绘制）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="selected_bg_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>选中行背景色（留空则不绘制）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="divider_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>列分隔线颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="chevron_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>有子项的节点右侧箭头颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="scrollbar_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>列内容溢出时右缘滚动条颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="font" type="xs:string">
      <xs:annotation>
        <xs:documentation>文本字体 ID</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="dropdown" type="xs:string">
      <xs:annotation>
        <xs:documentation>true = 下拉列表框形态（选择框 + 浮层）；false = 内嵌多列</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="placeholder" type="xs:string">
      <xs:annotation>
        <xs:documentation>未选择时的提示文本（字面文本）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="placeholder_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>未选择时的提示文本（多语言 ID，优先于 placeholder）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="allow_clear" type="xs:string">
      <xs:annotation>
        <xs:documentation>悬停且已有选择时是否显示清空按钮（×）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="expand_on_hover" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标悬停在父项上时自动展开子列（仅展开，不提交）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="popup_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>浮层宽度（像素）；0 表示按“列数 × 列宽”自动计算，显式值不足时自动放宽到可容纳全部列</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="popup_max_rows" type="xs:string">
      <xs:annotation>
        <xs:documentation>浮层最多可见行数，超出时列内滚动</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="popup_class" type="xs:string">
      <xs:annotation>
        <xs:documentation>浮层内级联列表使用的样式 Class</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="text_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>已选择时的文本颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="placeholder_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>提示文本颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_text_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件禁用时的文本颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bg_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>选择框背景色（留空则不绘制）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>选择框边框颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hover_border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>悬停或浮层展开时的边框颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="clear_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>清空按钮颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="clear_hover_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>清空按钮悬停颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="border_round" type="xs:string">
      <xs:annotation>
        <xs:documentation>选择框圆角（像素，自动 DPI 缩放）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="border_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>选择框边框宽度（像素，自动 DPI 缩放）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="ControlAttrs4">
    <!-- 来源：Control -->
    <xs:attribute name="class" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件样式,用样式里面的属性值来设置本控件的属性,如"btn_default",可以同时指定多个样式,各个样式之间用空格分隔,需要写在第一个属性位置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="enable_vars" type="xs:string">
      <xs:annotation>
        <xs:documentation>属性值中是否支持变量展开。 用法举例：假设在globle.xml中增加一行变量定义：&lt;Define name="SIZE_ICON_SMALL" value="16"/&gt; XML中的控件属性字符串中可以这样使用这个变量：width="${SIZE_ICON_SMALL}" 代码中也可以这样调用函数设置属性代码：Control::SetAttribute(_T("width"), _T("${SIZE_ICON_SMALL}"));</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="name" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件名字,同一窗口建议保持唯一，否则影响查询效率，也可能查询不到正确的结果</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="xs:string">
      <xs:annotation>
        <xs:documentation>可以设置int或string类型的值.当值为int是则设置控件的宽度值,如"100";当值为string时,stretch代表由父容器计算控件宽度,auto代表根据内容情况自动计算宽度,如果为百分比值"50%"，代表该控件的宽度期望值为父控件宽度的50%</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="xs:string">
      <xs:annotation>
        <xs:documentation>可以设置int或string类型的值.当值为int是则设置控件的高度值,如"100";当值为string时,stretch代表由父容器计算控件高度,auto代表根据内容情况自动计算高度,如果为百分比值"30%"，代表该控件的高度期望值为父控件高度的30%</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="min_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的最小宽度,如"30"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="min_height" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的最小高度,如"30"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="max_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的最大宽度,描述同width</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="max_height" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的最大高度,描述同height</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="margin" type="xs:string">
      <xs:annotation>
        <xs:documentation>外边距,如"2,2,2,2"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="padding" type="xs:string">
      <xs:annotation>
        <xs:documentation>内边距,如"2,2,2,2"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="control_padding" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许控件自身运用内边距</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="halign" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的水平方向的对齐方式,如"center",支持left、center、right三种位置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="valign" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的垂直方向的对齐方式,如"center",支持top、center、bottom三种位置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="align" type="xs:string">
      <xs:annotation>
        <xs:documentation>同时设置控件的水平方向和垂直方向的对齐方式，功能与valign和halign相同。 可取值: left、right、hcenter、top、vcenter、bottom，用逗号分割，如"hcenter,vcenter"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="float" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否使用绝对定位,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="keep_float_pos" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置当父控件位置和大小调整时，是否保持浮动控件相对父控件的位置不变,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bkcolor" type="xs:string">
      <xs:annotation>
        <xs:documentation>背景颜色字符串常量,如"white"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bkcolor2" type="xs:string">
      <xs:annotation>
        <xs:documentation>第二背景颜色字符串常量,如果设置了第二背景色，则支持背景颜色渐变,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bkcolor2_direction" type="xs:string">
      <xs:annotation>
        <xs:documentation>第二背景色方向，"1": 左-&gt;右，"2": 上-&gt;下，"3": 左上-&gt;右下，"4": 右上-&gt;左下</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fore_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>前景颜色字符串，前景色一般设置半透明的颜色，比如"#10006DD9"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="normal_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>普通状态颜色,如"white"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hovered_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>悬浮状态颜色,如"white"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pressed_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>按下状态颜色,如"white"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="normal_color_margin" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置普通状态下的控件颜色外边距</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hovered_color_margin" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置悬浮状态下的控件颜色外边距</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pressed_color_margin" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置按下状态下的控件颜色外边距</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_color_margin" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置禁用状态下的控件颜色外边距</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="state_color_min_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置状态颜色区域的最小宽度（解决设置Margin后，DPI缩放运算精度损失导致线条宽度失真问题）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="state_color_min_height" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置状态颜色区域的最小高度（解决设置Margin后，DPI缩放运算精度损失导致线条宽度失真问题）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="normal_color_round" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置普通状态下的控件颜色圆角大小</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hovered_color_round" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置悬浮状态下的控件颜色圆角大小</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pressed_color_round" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置按下状态下的控件颜色圆角大小</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_color_round" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置禁用状态下的控件颜色圆角大小</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="normal_border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>正常状态的边框颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hovered_border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>悬浮状态的边框颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pressed_border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>按下状态的边框颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>禁止状态的边框颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="focused_border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>焦点状态的边框颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="border_dash_style" type="xs:string">
      <xs:annotation>
        <xs:documentation>线的形状，可选值： "solid"：实线 "dash"：短划线构成的虚线 "dot"：点构成的虚线 "dash_dot"：交替短划线点线 "dash_dot_dot"：交替短划线点点线</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="borders_on_top" type="xs:string">
      <xs:annotation>
        <xs:documentation>边框是否在顶层（即先绘制子控件，后绘制边框，避免边框被子控件覆盖）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="left_border_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>左边边框大小,如"1",设置该值大于0,则将忽略border_size属性的设置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="top_border_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>顶部边框大小,如"1",设置该值大于0,则将忽略border_size属性的设置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="right_border_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>右边边框大小,如"1",设置该值大于0,则将忽略border_size属性的设置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bottom_border_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>底部边框大小,如"1",设置该值大于0,则将忽略border_size属性的设置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bkimage" type="xs:string">
      <xs:annotation>
        <xs:documentation>背景图片,如"bk.bmp或file='aaa.jpg' res='' dest='0,0,0,0' source='0,0,0,0' corner='0,0,0,0' fade='255' xtiled='false' ytiled='false'"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="normal_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>普通状态图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hovered_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标悬浮的状态图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pressed_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标按下的状态图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>禁用的状态图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fore_normal_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>普通状态前景图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fore_hovered_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标悬浮的状态前景图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fore_pressed_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标按下的状态前景图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fore_disabled_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>禁用的状态前景图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tooltip_text" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标悬浮提示,如"请在这里输入你的密码"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tooltip_text_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标悬浮提示,指定多语言模块的ID,当tooltiptext为空时则显示此属性,如"TOOL_TIP_ID"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tooltip_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标悬浮提示所占的宽度</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="data_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>自定义字符串数据,辅助函数，供用户使用</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="user_data_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>自定义整型数据, 供用户使用</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="enabled" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否可以响应用户操作,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="mouse_enabled" type="xs:string">
      <xs:annotation>
        <xs:documentation>本控件是否可以响应鼠标操作,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="keyboard_enabled" type="xs:string">
      <xs:annotation>
        <xs:documentation>非CButtonUI类忽略该值,为false时不支持TAB_STOP,且该对象不处理键盘信息</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="visible" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否可见,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_visible" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否可见,如"true",此属性会触发控件动画效果</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="menu" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否需要右键菜单,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="no_focus" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否可以获取焦点,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tab_stop" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许通过按TAB键切换到此控件</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="show_focused_rect" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否显示焦点状态(一个虚线构成的矩形)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="focused_rect_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>焦点状态矩形的颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="alpha" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的整体透明度,如alpha="128"，有效值为 0-255</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="state" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的当前状态: 支持normal、hovered、pressed、disabled状态</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="cursor_type" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标移动到控件上时的鼠标光标: "arrow"：箭头 "hand"：手型 "wait"：忙碌 "cross"：十字线 "ibeam"：I型光标,文本光标 "size_we"：水平调整 "size_ns"：垂直调整 "size_nwse"：对角线调整，西北-东南调整 "size_nesw"：对角线调整，东北-西南调整 "size_all"：移动，四向调整 "no"：禁止光标 "progress"：进度，应用启动光标</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="render_offset" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件绘制时的偏移量,如"10,10",一般用于绘制动画</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_hovered" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件鼠标悬停状态下的透明渐变动画,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_hovered_frame_interval_ms" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置播放Hovered状态动画的定时器时间间隔（毫秒）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_hovered_total_ms" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置Hovered状态动画总的播放时间（毫秒）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_hovered_easing_function" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置Hovered状态动画缓动函数类型,支持的缓动函数类型参见EasingFunctions::GetEasingFunctionType实现函数</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_alpha" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件透明渐变动画。有效值如下： fade_alpha="false"：不启用控件透明渐变动画 fade_alpha="true"：启用控件透明渐变动画，最终控件的Alpha值设置为255 fade_alpha="128"：启用控件透明渐变动画，最终控件的Alpha值设置为128，这种情况下的有效值为1-255。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件宽度渐变动画,如"true"。控件宽度不能是拉伸类型，该属性必须写在width属性后面</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_height" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件高度渐变动画,如"true"。控件高度不能是拉伸类型，该属性必须写height属性后面</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件大小（高度和宽度）的渐变动画,如"true"。控件高度和宽度不能是拉伸类型，该属性必须写height属性和width属性后面</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_in_out_x_from_left" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件从左到右的动画,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_in_out_x_from_right" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件从右到左的动画,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_in_out_y_from_top" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件从上到下的动画,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_in_out_y_from_bottom" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件从下到上的动画,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_frame_interval_ms" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置播放动画的定时器时间间隔（毫秒）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_total_ms" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置动画总的播放时间（毫秒）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_easing_function" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置动画缓动函数类型,支持的缓动函数类型参见EasingFunctions::GetEasingFunctionType实现函数</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="loading" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置控件加载中状态的UI显示相关属性，使用方法与Image属性相似。 使用示例：loading="file='loading.xml' width='0' height='0' offset_x='-1' offset_y='-1' valign='center' halign='center' fade='255' animation_control='loading_animation' auto_stop='true'" loading的可用属性如下： "file": XML资源文件名，根据此设置去加载XML资源，最终放在一个Box容器中显示 "width": longding控件的显示宽度，像素 "height": longding控件的显示高度，像素 "offset_x": longding控件的位置X方向偏移，相对于关联控件的左上角，有效值: &gt;= 0 "offset_y": longding控件的位置Y方向偏移，相对于关联控件的左上角，有效值: &gt;= 0 "halign":水平方向对齐方式，可取值："left" "center" "right"，仅当offset_x不含有效值时生效 "valign":垂直方向对齐方式，可取值："top" "center" "bottom"，仅当offset_y不含有效值时生效 "fade":loading控件的透明度，有效值： 0 - 255 "auto_stop"：loading动画播放结束以后，自动停止loading状态（自动调用StopLoading()函数） "animation_control":动画控件的名称，用于Loading功能与loading控件上的动画控件交互使用 loading功能的完整演示，可参考examples/ListCtrl示例程序</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="paint_order" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置绘制顺序：0 表示常规绘制，非0表示指定绘制顺序，值越大表示越晚绘制</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="start_image_animation" type="xs:string">
      <xs:annotation>
        <xs:documentation>播放动画，最多3个参数，每个参数用','分割，详见函数的参数列表</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="stop_image_animation" type="xs:string">
      <xs:annotation>
        <xs:documentation>停止动画，最多3个参数，每个参数用','分割 ，详见函数的参数列表</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="set_image_animation_frame" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置动画当前帧，最多2个参数，每个参数用','分割，详见函数的参数列表</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="box_shadow" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置控件的阴影属性，举例：boxshadow="color='red' offset='0,0' blurradius='8' spreadradius='8'"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="enable_drag_drop" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许拖放操作，包括拖入文件和拖入文本</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="enable_drop_file" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许拖入文件操作</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="drop_file_types" type="xs:string">
      <xs:annotation>
        <xs:documentation>拖放文件操作支持的后缀名列表，比如:".txt;.csv"，表示仅支持txt和csv文件；如果为空，表示支持所有文件</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="row_span" type="xs:string">
      <xs:annotation>
        <xs:documentation>单元格合并属性，占几行（默认占1行），仅在GridLayout布局中生效</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="col_span" type="xs:string">
      <xs:annotation>
        <xs:documentation>单元格合并属性，占几列（默认占1列），仅在GridLayout布局中生效</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="CefControlAttrs">
    <!-- 来源：CefControl -->
    <xs:attribute name="url" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件创建成功后，导航到此URL网址</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="url_is_local_file" type="xs:string">
      <xs:annotation>
        <xs:documentation>url指定的URL网址否为本地文件，如果是本地文件并且指定的是相对路径，则根目录是可执行程序所在目录</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="F11" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许F11快捷键(页面全屏/页面退出全屏)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="F12" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许F12快捷键(显示/隐藏开发者工具)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="download_favicon_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否下载网站的FavIcon图标</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="ChartAttrs">
    <!-- 来源：Chart -->
    <xs:attribute name="chart_type" type="xs:string">
      <xs:annotation>
        <xs:documentation>图表类型："line"折线图 / "bar"柱状图 / "pie"饼图</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="data" type="xs:string">
      <xs:annotation>
        <xs:documentation>逗号分隔的数值序列，如 data="12,35,28,40"，作为（单）系列数据</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="data_labels" type="xs:string">
      <xs:annotation>
        <xs:documentation>逗号分隔的类别标签，用于折线/柱状图的类目轴（X轴）与饼图的图例</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title" type="xs:string">
      <xs:annotation>
        <xs:documentation>图表标题（居中显示在顶部）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="x_axis_title" type="xs:string">
      <xs:annotation>
        <xs:documentation>X 轴标题（显示在类目轴下方）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="y_axis_title" type="xs:string">
      <xs:annotation>
        <xs:documentation>Y 轴标题（纵向显示在左侧）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>图表标题的语言 ID（text_id，多语言支持，优先于 title）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="x_axis_title_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>X 轴标题的语言 ID（多语言支持）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="y_axis_title_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>Y 轴标题的语言 ID（多语言支持）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="data_labels_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>类目标签的语言 ID（逗号分隔多个 STRID，多语言支持，优先于 data_labels）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="series_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>系列主色（语义色名或颜色值）；饼图各扇区在此基础上按索引自动生成同色系明暗渐变</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="axis_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>坐标轴/网格线颜色（折线、柱状图有效）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="label_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>文本标签颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="show_value" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否在数据点/柱顶/扇区旁显示数值</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="show_grid" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否显示网格线（折线、柱状图有效）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="show_axis_values" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否显示 Y 轴刻度值</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="axis_divisions" type="xs:string">
      <xs:annotation>
        <xs:documentation>Y 轴刻度分段数（1~10）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="legend_visible" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否显示图例（饼图默认显示；折线/柱状多系列时可开启）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="line_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>折线粗细（折线图有效，自动DPI缩放）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="line_mode" type="xs:string">
      <xs:annotation>
        <xs:documentation>折线绘制模式："straight"折线 / "curve"平滑曲线（贝塞尔）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="area_fill" type="xs:string">
      <xs:annotation>
        <xs:documentation>折线下方是否填充半透明面积（折线图）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="show_data_points" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否绘制数据点圆点（折线图）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bar_mode" type="xs:string">
      <xs:annotation>
        <xs:documentation>柱状排列模式："grouped"分组并排 / "stacked"堆叠累加</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="donut" type="xs:string">
      <xs:annotation>
        <xs:documentation>饼图是否环形（donut）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="show_percent" type="xs:string">
      <xs:annotation>
        <xs:documentation>饼图是否显示百分比（替代数值标签）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bar_radius" type="xs:string">
      <xs:annotation>
        <xs:documentation>柱状图圆角半径（像素，0 表示直角，自动DPI缩放）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bar_gradient" type="xs:string">
      <xs:annotation>
        <xs:documentation>柱状图是否渐变填充（顶部亮、底部暗）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="line_glow" type="xs:string">
      <xs:annotation>
        <xs:documentation>折线图是否绘制发光/阴影效果</xs:documentation>
      </xs:annotation>
