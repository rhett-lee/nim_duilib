      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="thumb_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>拖动滑块大小,如"10,10"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="step" type="xs:string">
      <xs:annotation>
        <xs:documentation>进度步长,如"1"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="page_step" type="xs:string">
      <xs:annotation>
        <xs:documentation>PageUp/PageDown（及Shift+方向键）的大步长，0 表示自动取 (max-min)/10</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="click_to_jump" type="xs:string">
      <xs:annotation>
        <xs:documentation>点击轨道是否按下即跳值；false 则保持"松开鼠标才跳值"的旧行为</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="progress_bar_padding" type="xs:string">
      <xs:annotation>
        <xs:documentation>滑动条绘制时缩小的内边距</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="show_ticks" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否显示刻度线（标尺）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tick_count" type="xs:string">
      <xs:annotation>
        <xs:documentation>刻度线数量（至少 2，含首尾两端）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tick_length" type="xs:string">
      <xs:annotation>
        <xs:documentation>刻度线长度（像素，内部按 DPI 缩放）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tick_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>刻度线颜色（语义色名或颜色值）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tick_pos" type="xs:string">
      <xs:annotation>
        <xs:documentation>刻度线位置：bottom/top（水平滑块）、right/left（垂直滑块）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="show_tick_labels" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否显示刻度值文本（需 show_ticks 为 true）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tick_label_interval" type="xs:string">
