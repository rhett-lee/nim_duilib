      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pressed_link_font_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>超级链接：鼠标按下状态文本颜色值</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="link_font_underline" type="xs:string">
      <xs:annotation>
        <xs:documentation>超级链接：是否使用带下划线的字体</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="row_spacing_mul" type="xs:string">
      <xs:annotation>
        <xs:documentation>行间距倍数, 比如1.5代表1.5倍行间距</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="row_spacing_add" type="xs:string">
      <xs:annotation>
        <xs:documentation>行间距附加量: 是固定的附加像素值（默认值通常为 0），用于在比例调整的基础上增加固定偏移（像素）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="word_wrap" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否自动换行，如果为false，则只有在 标签的时候才换行</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
