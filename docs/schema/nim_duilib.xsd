  <xs:attributeGroup name="SearchBoxAttrs">
    <!-- 来源：SearchBox -->
    <xs:attribute name="text" type="xs:string">
      <xs:annotation>
        <xs:documentation>搜索框初始文本</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="text_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>搜索框初始文本的多语言字符串ID（与text同时设置时，后设置的属性生效）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="prompt_text" type="xs:string">
      <xs:annotation>
        <xs:documentation>编辑框为空时显示的占位提示文本</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="prompt_text_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>占位提示文本的多语言字符串ID</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="prompt_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>占位提示文本的颜色（语义色名）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="debounce_interval" type="xs:string">
      <xs:annotation>
        <xs:documentation>防抖间隔（毫秒）：搜索文本连续变化时，仅在输入停顿达到该间隔后才触发 kEventTextChanged；0=每次变化立即触发（默认，向后兼容），用于避免搜索场景每次按键都触发搜索请求</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="suggestions" type="xs:string">
      <xs:annotation>
        <xs:documentation>建议数据源，多项以分号";"分隔（搜索历史由控件在提交搜索时自动记录，无需在此配置）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="max_visible" type="xs:string">
      <xs:annotation>
        <xs:documentation>下拉浮层最多可见候选行数（超出显示滚动条）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="history_enabled" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否记录并展示搜索历史（历史同时作为候选项展示）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="max_history" type="xs:string">
      <xs:annotation>
        <xs:documentation>搜索历史最多保留条数（超过后丢弃最旧，最近使用的置顶）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="filter_enabled" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否按输入文本过滤候选：true（默认）时，输入达到 min_chars 才按 match_mode/ignore_case 过滤候选项；false 时始终全量展示（不过滤），适合候选项较少或希望总览全部候选项的场景</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="min_chars" type="xs:string">
      <xs:annotation>
        <xs:documentation>过滤模式下触发过滤的最少输入字符数；输入为空或不足该值时展示全部（聚焦态）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="match_mode" type="xs:string">
      <xs:annotation>
        <xs:documentation>过滤匹配模式：prefix前缀匹配（候选项以输入文本开头）；contains包含匹配（任意位置包含）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="ignore_case" type="xs:string">
      <xs:annotation>
        <xs:documentation>过滤时是否忽略大小写</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="SpinBoxAttrs">
