    <xs:attribute name="group_separator" type="xs:string">
      <xs:annotation>
        <xs:documentation>千分位分隔符（如 ","），空表示不分组</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="RichEditAttrs2">
    <!-- 来源：RichEdit -->
    <xs:attribute name="vscrollbar" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否使用竖向滚动条,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hscrollbar" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否使用横向滚动条,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="auto_vscroll" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否随输入竖向滚动,如"true"(当为SDL实现时，该选项无效)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="auto_hscroll" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否随输入横向滚动,如"true" (当为SDL实现时，该选项无效)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="want_tab" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否接受tab按键消息,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="want_return" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否接受回车按键消息,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="want_ctrl_return" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否接受ctrl+return按键消息,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="rich_text" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否使用富格式,如"true"(当为SDL实现时，该选项无效)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="single_line" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否使用单行,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="multi_line" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否使用多行,该属性与single_line互斥,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="readonly" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否只读,如"false"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="password" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否为密码模式,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="show_password" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否显示密码符,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="password_char" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置密码字符，默认为 " * " 字符，可用通过这个属性改变</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="flash_password_char" type="xs:string">
      <xs:annotation>
        <xs:documentation>先显示字符，然后再显示密码字符</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="number_only" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否只允许输入数字,如"false"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="text_align" type="xs:string">
      <xs:annotation>
        <xs:documentation>文字的水平与垂直对齐方式, 可取值: left、right、hcenter、top、vcenter、bottom，用逗号分割，如"hcenter,vcenter"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="text_padding" type="xs:string">
      <xs:annotation>
        <xs:documentation>文本内边距，如："2,2,2,2"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="text" type="xs:string">
      <xs:annotation>
        <xs:documentation>显示文本</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="text_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>显示文本的多语言功能ID</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="font" type="xs:string">
      <xs:annotation>
        <xs:documentation>字体ID</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="normal_text_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>普通状态文字颜色,不指定则使用默认颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_text_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>禁用状态文字颜色,不指定则使用默认颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="caret_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>光标的颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="prompt_mode" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否显示提示文字,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="prompt_text" type="xs:string">
      <xs:annotation>
        <xs:documentation>文本框内提示文字,当文本框text为空时显示</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="prompt_text_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>多语言功能的ID,如"TEXT_OUT"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="prompt_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>文本框内提示文字的颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="focused_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>焦点状态下的图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="auto_detect_url" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否自动检测URL，如果是URL则显示为超链接 (当为SDL实现时，该选项无效)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="limit_text" type="xs:string">
      <xs:annotation>
        <xs:documentation>限制最多字符数</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="limit_chars" type="xs:string">
      <xs:annotation>
        <xs:documentation>限制允许输入哪些字符，比如"abc"表示只允许输入a、b、c字符，不允许输入其他字符</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="allow_beep" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许发出Beep声音 (当为SDL实现时，该选项无效)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="word_wrap" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否自动换行</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="no_caret_readonly" type="xs:string">
      <xs:annotation>
        <xs:documentation>只读模式，不显示光标</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="save_selection" type="xs:string">
      <xs:annotation>
        <xs:documentation>如果 为 true，则当控件处于非活动状态时，应保存所选内容的边界 (当为SDL实现时，该选项无效)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hide_selection" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否隐藏选择内容</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="zoom" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置缩放比例：设 wParam：缩放比例的分子，lParam：缩放比例的分母。"wParam,lParam" 表示按缩放比例分子/分母显示的缩放，取值范围：1/64 &lt; (wParam / lParam) &lt; 64。举例：则："0,0"表示关闭缩放功能，"2,1"表示放大到200%，"1,2"表示缩小到50%</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="wheel_zoom" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许Ctrl + 滚轮来调整缩放比例</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="default_context_menu" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否使用默认的右键菜单</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="spin_class" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置Spin功能的Class名称，如果不为空则显示Spin按钮，详细用法参见示例程序</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="clear_btn_class" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置清除按钮功能的Class名称，如果不为空则显示清楚按钮，详细用法参见示例程序</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="show_password_btn_class" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置显示密码按钮功能的Class名称，如果不为空则显示显示密码按钮 ，详细用法参见示例程序</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="selection_bkcolor" type="xs:string">
      <xs:annotation>
        <xs:documentation>选择文本的背景色（焦点状态） 如果设置为空，则不显示</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="inactive_selection_bkcolor" type="xs:string">
      <xs:annotation>
        <xs:documentation>选择文本的背景色（非焦点状态），如果设置为空，则不显示</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="current_row_bkcolor" type="xs:string">
      <xs:annotation>
        <xs:documentation>当前行的背景色（焦点状态），如果设置为空，则在焦点状态不显示当前行的背景色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="inactive_current_row_bkcolor" type="xs:string">
      <xs:annotation>
        <xs:documentation>当前行的背景色（非焦点状态），如果设置为空，则在非焦点状态不显示当前行的背景色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="select_all_on_focused" type="xs:string">
      <xs:annotation>
        <xs:documentation>获取焦点的时候，是否全选</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="focused_bottom_border_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>焦点状态时，底部边框的大小</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="focused_bottom_border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>焦点状态时，底部边框的颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="enable_drag_drop" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许拖放操作</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="enable_drop_file" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许拖放文件操作</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="enable_drag_out" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许文本拖出功能（作为拖放源），仅Windows平台支持，其他平台不支持，该选项仅在RichEdit2中支持</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="drop_file_types" type="xs:string">
      <xs:annotation>
        <xs:documentation>拖放文件操作支持的后缀名列表，比如:".txt;.csv"，表示仅支持txt和csv文件；如果为空，表示支持所有文件</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="row_spacing_mul" type="xs:string">
      <xs:annotation>
        <xs:documentation>行间距倍数, 比如1.5代表1.5倍行间距 Windows平台：仅当rich_text属性"true"时有效，因为Windows平台的RichEdit控件只有富文本模式时支持设置行间距； 使用SDL时，始终有效，即其他平台时，行间距属性均有效</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="row_spacing_add" type="xs:string">
      <xs:annotation>
        <xs:documentation>行间距附加量: 是固定的附加像素值（默认值通常为 0），用于在比例调整的基础上增加固定偏移（像素），仅当使用SDL时有效</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="SplitAttrs">
    <!-- 来源：Split -->
    <xs:attribute name="enable_split_single" type="xs:string">
      <xs:annotation>
        <xs:documentation>当只有一个控件的时候，是否允许调整其宽度</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="StatusBarAttrs">
    <!-- 来源：StatusBar -->
    <xs:attribute name="separator_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>相邻状态面板之间分隔线的宽度（像素，0 表示不绘制分隔线）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="separator_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>分隔线颜色（语义色名或颜色值）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="size_grip" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否绘制右下角的尺寸手柄</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="size_grip_resize" type="xs:string">
      <xs:annotation>
        <xs:documentation>尺寸手柄是否参与窗口拖拽缩放：true 时若状态栏停靠在窗口客户区右下角，会自动把窗口右下角可拉伸区域（size_box 的 right/bottom）扩大到覆盖手柄，从而能真正拖拽调整窗口大小；false 时手柄仅作视觉提示。注意该效果是窗口级的，扩大后窗口底边一带也会成为可拉伸区域。前提是窗口本身具备可缩放能力：Windows 默认具备；SDL 等平台需在 XML 中给 Window 声明非零 size_box</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="size_grip_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>尺寸手柄颜色（语义色名或颜色值）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="StepperAttrs">
    <!-- 来源：Stepper -->
    <xs:attribute name="current" type="xs:string">
      <xs:annotation>
        <xs:documentation>当前步骤索引（0 起），位于其前的步骤显示为已完成</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="current_index" type="xs:string">
      <xs:annotation>
        <xs:documentation>当前步骤索引（0 起），位于其前的步骤显示为已完成</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="direction" type="xs:string">
      <xs:annotation>
        <xs:documentation>排列方向：horizontal（水平，默认）/ vertical（垂直）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="orientation" type="xs:string">
      <xs:annotation>
        <xs:documentation>排列方向：horizontal（水平，默认）/ vertical（垂直）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="click_to_jump" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标点击步骤是否跳转到该步骤</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="node_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>节点直径（像素，自动 DPI 缩放）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="connector_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>未完成段连接线颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="connector_active_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>已完成段连接线颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="desc_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>描述文本颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title_font" type="xs:string">
      <xs:annotation>
        <xs:documentation>标题 / 描述字体 ID</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="desc_font" type="xs:string">
      <xs:annotation>
        <xs:documentation>标题 / 描述字体 ID</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="node_hovered_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>节点悬停态图片，可选；鼠标悬停于可点击步骤上时显示（绘制在节点圆形下层）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="node_pressed_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>节点按下态图片，可选；鼠标按下可点击步骤时显示，未配置时回退悬停态图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="SwitchAttrs">
    <!-- 来源：Switch -->
    <xs:attribute name="switch_animation_ms" type="xs:string">
      <xs:annotation>
        <xs:documentation>切换动画时长（毫秒），0表示不使用动画</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="track_off_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>未选中状态的轨道颜色（语义色名，无轨道图片时生效）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="track_on_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>选中状态的轨道颜色（语义色名，无轨道图片时生效）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="thumb_off_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>未选中状态的滑块颜色（语义色名，无滑块图片时生效）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="thumb_on_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>选中状态的滑块颜色（语义色名，无滑块图片时生效）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="track_off_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>未选中状态的轨道图片（图片属性串，与track_on_image成对配置）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="track_on_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>选中状态的轨道图片（图片属性串，与track_off_image成对配置）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="thumb_off_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>未选中状态的滑块图片（方形图片，与thumb_on_image成对配置）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="thumb_on_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>选中状态的滑块图片（方形图片，与thumb_off_image成对配置）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="thumb_padding" type="xs:string">
      <xs:annotation>
        <xs:documentation>滑块图片方形框与轨道边缘的距离（自动DPI缩放）。方形框边长等于轨道高度，阴影等留白需绘制在图片内部</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="switch_text_on" type="xs:string">
      <xs:annotation>
        <xs:documentation>选中状态下轨道内显示的文字（对应 Ant Design 的 checkedChildren）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="switch_text_off" type="xs:string">
      <xs:annotation>
        <xs:documentation>未选中状态下轨道内显示的文字（对应 Ant Design 的 unCheckedChildren）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="switch_text_on_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>选中状态轨道内文字颜色（语义色名）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="switch_text_off_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>未选中状态轨道内文字颜色（语义色名）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="switch_image_on" type="xs:string">
      <xs:annotation>
        <xs:documentation>选中状态轨道内显示的图标（图片属性串，可与文字同时使用）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="switch_image_off" type="xs:string">
      <xs:annotation>
        <xs:documentation>未选中状态轨道内显示的图标（图片属性串，可与文字同时使用）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="switch_loading" type="xs:string">
      <xs:annotation>
        <xs:documentation>加载中状态：滑块内绘制旋转指示器，并屏蔽用户点击切换</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="switch_loading_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>加载指示器颜色（语义色名）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="track_disabled_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>禁用状态的轨道颜色（语义色名，无轨道图片时生效）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="thumb_disabled_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>禁用状态的滑块颜色（语义色名，无滑块图片时生效）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="TabBoxAttrs">
    <!-- 来源：TabBox -->
    <xs:attribute name="selected_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>默认选中的页面id</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_switch" type="xs:string">
      <xs:annotation>
        <xs:documentation>当切换页面时是否使用动画效果, 取值："false" 或 "true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_switch_type" type="xs:string">
      <xs:annotation>
        <xs:documentation>页面切换的动画类型，取值："FadeInOut" 表示淡入淡出，"FadeInOutX" 表示内容区横向滑动</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_switch_frame_interval_ms" type="xs:string">
      <xs:annotation>
        <xs:documentation>播放切换动画的定时器时间间隔（毫秒）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_switch_total_ms" type="xs:string">
      <xs:annotation>
        <xs:documentation>切换动画总的播放时间（毫秒）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_switch_easing_function" type="xs:string">
      <xs:annotation>
        <xs:documentation>切换动画缓动函数类型</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="TabCtrlAttrs">
    <!-- 来源：TabCtrl -->
    <xs:attribute name="selected_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>默认选择的子项</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tab_box_name" type="xs:string">
      <xs:annotation>
        <xs:documentation>绑定的TabBox控件名称，绑定后TabCtrl的选择项变化时，TabBox的选择项会跟随变化</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="drag_order" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否支持拖动调整顺序（在同一个标签内），默认是开启的</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="drag_out_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置是否支持拖拽拖出该容器：如果不等于0，支持拖出，否则不支持拖出（拖出到drop_in_id==drag_out_id的容器）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="drop_in_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置是否支持拖拽投放进入该容器: 如果不等于0，支持拖入，否则不支持拖入(从drag_out_id==drop_in_id的容器拖入到该容器)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="selected_tab_item_outline_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>选择标签项的外部轮廓边线的宽度</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="selected_tab_item_outline_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>选择标签项的外部轮廓边线的颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tab_ctrl_bottom_line_height" type="xs:string">
      <xs:annotation>
        <xs:documentation>标签栏底部的边线高度（这个边线，选择标签的区域不绘制，其他区域绘制）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tab_ctrl_bottom_line_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置标签栏底部的边线颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="selected_tab_item_show_bg" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否绘制选中标签的背景色：false时不绘制选中背景（通常配合底部指示条使用）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="selected_tab_item_indicator_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>选中标签的底部指示条宽度：数值表示固定宽度（未做DPI缩放）；填auto时自动跟随标签标题文字宽度；为0时不绘制指示条</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="selected_tab_item_indicator_height" type="xs:string">
      <xs:annotation>
        <xs:documentation>选中标签的底部指示条高度（未做DPI缩放）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="selected_tab_item_indicator_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>选中标签的底部指示条颜色；为空时不绘制指示条</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="selected_tab_item_indicator_animation" type="xs:string">
      <xs:annotation>
        <xs:documentation>选中切换时，指示条是否以位置/宽度插值动画过渡；关闭后立即跳变，默认开启</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="selected_tab_item_indicator_animation_duration" type="xs:string">
      <xs:annotation>
        <xs:documentation>指示条滑动动画时长（毫秒），范围0-2000；为0时不播放动画，默认200</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tab_ctrl_bottom_line_mode" type="xs:string">
      <xs:annotation>
        <xs:documentation>底边线在选中项处的断开策略：auto（绘制选中背景时断开）/ break（始终断开）/ full（始终连续），默认auto</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tab_ctrl_orientation" type="xs:string">
      <xs:annotation>
        <xs:documentation>标签栏的布局方向：horz(水平，默认值) / vert(垂直)。垂直时标签位于左侧、内容区在右侧，选中项轮廓与分隔线自动适配为右侧</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="overflow_scroll" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用溢出滚动：标签总宽度（水平）或总高度（垂直）超出可视区域时，自动显示滚动条。滚动条悬浮在子控件之上，不占用布局空间；拖动标签靠近边缘时会自动滚动</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="overflow_buttons" type="xs:string">
      <xs:annotation>
        <xs:documentation>标签溢出时，是否在标签栏两端显示左右（垂直方向为上下）滚动箭头按钮，点击可按可视范围翻页滚动；启用时隐藏悬浮滚动条（两者互斥），默认开启</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="wheel_switch" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用鼠标滚轮切换标签：滚动滚轮选择上一个/下一个标签；默认关闭，滚轮用于滚动标签栏</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="middle_click_close" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用鼠标中键关闭标签：中键点击标签时发送kEventTabClose事件（不会自动删除标签），默认开启</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="drag_insert_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>拖动排序时插入位置提示线的颜色；为空时不绘制提示线</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tab_item_justify" type="xs:string">
      <xs:annotation>
        <xs:documentation>标签是否等宽填充：true时按标签栏可用宽度（垂直方向按高度）平分每个标签，并自动关闭滚动条；可用标签项的min_width/max_width做进一步约束</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="new_tab_button" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否在标签栏末尾显示"新建标签"按钮（+），点击时发送kEventTabNew事件，不会自动创建标签</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="BoxAttrs4">
    <!-- 来源：Box -->
    <xs:attribute name="child_margin" type="xs:string">
      <xs:annotation>
        <xs:documentation>布局属性，子控件之间的间隔: X 轴方向 和 Y 轴方向同时设置为相同值</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="child_margin_x" type="xs:string">
      <xs:annotation>
        <xs:documentation>布局属性，子控件之间的间隔: X 轴方向</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="child_margin_y" type="xs:string">
      <xs:annotation>
        <xs:documentation>布局属性，子控件之间的间隔: Y 轴方向</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="child_valign" type="xs:string">
      <xs:annotation>
        <xs:documentation>布局属性，子控件的垂直方向对齐方式，可选值："top","center","bottom"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="child_halign" type="xs:string">
      <xs:annotation>
        <xs:documentation>布局属性，子控件的水平方向对齐方式，可选值："left","center","right"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="child_align" type="xs:string">
      <xs:annotation>
        <xs:documentation>布局属性，同时设置子控件的水平方向和垂直方向的对齐方式，功能与child_valign和child_halign相同。 可取值: left、right、hcenter、top、vcenter、bottom，用逗号分割，如"hcenter,vcenter"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="margin" type="xs:string">
      <xs:annotation>
        <xs:documentation>外边距,如(2,2,2,2)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="padding" type="xs:string">
      <xs:annotation>
        <xs:documentation>内边距,如(2,2,2,2)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="mouse_child" type="xs:string">
      <xs:annotation>
        <xs:documentation>子控件是否支持鼠标操作, true 或者 false</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="TabCtrlItemAttrs">
    <!-- 来源：TabCtrlItem -->
    <xs:attribute name="tab_box_item_index" type="xs:string">
      <xs:annotation>
        <xs:documentation>绑定的TabBox子项索引号（即点击这个标签页，切换到此索引号的TabBox页面）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title" type="xs:string">
      <xs:annotation>
        <xs:documentation>标签页的标题文字</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>标签页的标题文字ID（用于支持多语版）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title_class" type="xs:string">
      <xs:annotation>
        <xs:documentation>标签页的标题文字资源属性Class值</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>标签标题文字在普通状态下的颜色（为空时不干预，保持原有颜色）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hovered_title_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>标签标题文字在悬停/按下状态下的颜色（为空时使用普通状态颜色）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="selected_title_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>标签标题文字在选中状态下的颜色（为空时使用普通状态颜色）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="selected_hovered_title_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>标签标题文字在“选中且悬停”状态下的颜色（为空时使用选中状态颜色）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_title_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>标签标题文字在禁用状态下的颜色（为空时不干预）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="selected_title_font" type="xs:string">
      <xs:annotation>
        <xs:documentation>标签标题在选中状态下使用的字体ID（如system_bold_12）；为空时使用title_class的字体</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="icon" type="xs:string">
      <xs:annotation>
        <xs:documentation>标签页的图标资源字符串</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="icon_class" type="xs:string">
      <xs:annotation>
        <xs:documentation>标签页的图标资源属性Class值</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="close_button_class" type="xs:string">
      <xs:annotation>
        <xs:documentation>标签页的关闭按钮资源属性Class值</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="line_class" type="xs:string">
      <xs:annotation>
        <xs:documentation>标签页的分割线资源属性Class值</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="selected_round_corner" type="xs:string">
      <xs:annotation>
        <xs:documentation>标签页选择状态时的圆角大小</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hovered_round_corner" type="xs:string">
      <xs:annotation>
        <xs:documentation>标签页悬停状态时的圆角大小</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hovered_padding" type="xs:string">
      <xs:annotation>
        <xs:documentation>标签页悬停状态的背景色的内边距</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="auto_hide_close_button" type="xs:string">
      <xs:annotation>
        <xs:documentation>关闭按钮是否自动隐藏</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="close_button_show_mode" type="xs:string">
      <xs:annotation>
        <xs:documentation>关闭按钮显示策略：auto（沿用auto_hide_close_button：选中或悬停时显示）/ hover（仅悬停时显示，选中也不常显；适合指示条风格）/ always（始终显示），默认auto</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="closable" type="xs:string">
      <xs:annotation>
        <xs:documentation>标签是否可关闭：false时隐藏关闭按钮，且鼠标中键点击也不会发送关闭请求事件，默认可关闭</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="drag_order" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否支持拖动调整顺序（在同一个标签栏内），默认是开启的；实际生效还需TabCtrl的drag_order总开关开启。固定标签期间该开关被临时关闭，取消固定（SetFixed(false)）后按此值恢复</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fixed" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否为固定标签：固定标签不可拖动、不可作为拖放目标，且不显示关闭按钮；多个固定标签始终位于标签栏前端，构成“固定块”（普通标签只能在固定块之后移动，且不可越过固定块）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="badge_count" type="xs:string">
      <xs:annotation>
        <xs:documentation>角标数量：大于0时显示角标，小于等于0时自动隐藏；未设置badge_class时不创建角标控件</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="badge_max_count" type="xs:string">
      <xs:annotation>
        <xs:documentation>角标数量上限，超过上限时显示"上限+"（如"99+"）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="badge_dot" type="xs:string">
      <xs:annotation>
        <xs:documentation>角标红点模式：true为纯小圆点，不显示数字；需配合badge_class或badge属性使用</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="badge_class" type="xs:string">
      <xs:annotation>
        <xs:documentation>角标控件的Class值（如tab_ctrl_item_badge），为空时不创建角标控件</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="badge_float" type="xs:string">
      <xs:annotation>
        <xs:documentation>角标是否浮动定位到标签右上角（float=true、右对齐/顶部对齐），不占用标题布局宽度；适合长标题或固定窄宽度的标签</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="TagInputAttrs">
    <!-- 来源：TagInput -->
    <xs:attribute name="prompt_text" type="xs:string">
      <xs:annotation>
        <xs:documentation>编辑框为空时显示的占位提示文本</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="prompt_text_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>占位提示文本的多语言字符串ID</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="prompt_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>占位提示文本的颜色（语义色名）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="allow_duplicate" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许重复标签（false时重复文本的标签不会被添加）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="max_count" type="xs:string">
      <xs:annotation>
        <xs:documentation>最多标签个数，0表示不限制</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="delimiter" type="xs:string">
      <xs:annotation>
        <xs:documentation>输入过程中直接生成标签的分隔符（如英文逗号,）；为空表示仅按回车键生成</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tags" type="xs:string">
      <xs:annotation>
        <xs:documentation>初始标签文本，多个标签以分号;分隔</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="ThemeAttrs">
    <!-- 来源：Theme -->
    <xs:attribute name="name" type="xs:string">
      <xs:annotation>
        <xs:documentation>主题显示名</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="type" type="xs:string">
      <xs:annotation>
        <xs:documentation>主题类型（详见 [§5 主题类型与风格](#_5-主题类型与风格)）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="style" type="xs:string">
      <xs:annotation>
        <xs:documentation>主题风格（影响控件暗色模式判断）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="accent_support" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否支持"强调色替换"特性（v2.0+）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="version" type="xs:string">
      <xs:annotation>
        <xs:documentation>XML 格式版本号</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="ThemeColorAttrs">
    <!-- 来源：ThemeColor -->
    <xs:attribute name="name" type="xs:string">
      <xs:annotation>
        <xs:documentation>颜色名称</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="value" type="xs:string">
      <xs:annotation>
        <xs:documentation>颜色取值</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="type" type="xs:string">
      <xs:annotation>
        <xs:documentation>颜色按功能划分的类型，比如: "common"代表通用颜色，"text"代表文本颜色，"window"代表窗口背景颜色，"button"代表按钮颜色，"menu_bar"代表菜单栏颜色，"list_ctrl"代表列表使用的颜色，还有其他很多取值，按所属控件划分</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="category" type="xs:string">
      <xs:annotation>
        <xs:documentation>颜色按类别划分的类型，比如: "basic_color"代表基础颜色， "text_color"代表文本颜色，"border_color"代表边框颜色，"bg_color"代表背景颜色，</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fixed" type="xs:string">
      <xs:annotation>
        <xs:documentation>该颜色是否支持强调色，"true"代表支持强调色，当使用强调色主题时，该颜色会被替换为强调色；"false"代表不支持强调色，当使用强调色时，该颜色保持不变</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="comment_cn" type="xs:string">
      <xs:annotation>
        <xs:documentation>颜色的中文注释</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="comment_en" type="xs:string">
      <xs:annotation>
        <xs:documentation>颜色的英文注释</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="role" type="xs:string">
      <xs:annotation>
        <xs:documentation>颜色角色，在强调色派生系统中的定位</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="derived_from" type="xs:string">
      <xs:annotation>
        <xs:documentation>派生来源，引用另一个颜色的 name，表示此颜色派生自该颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="adjust" type="xs:string">
      <xs:annotation>
        <xs:documentation>派生调整公式，派生时的颜色变换规则</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="ThemeMetaAttrs">
    <!-- 来源：ThemeMeta -->
    <xs:attribute name="author" type="xs:string">
      <xs:annotation>
        <xs:documentation>主题作者/来源</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="contrast_ratio" type="xs:string">
      <xs:annotation>
        <xs:documentation>对比度：主题默认的 WCAG 对比度值，用于无障碍访问检查</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="accent_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>默认强调色：主题出厂的主色调锚点</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="base_luminance" type="xs:string">
      <xs:annotation>
        <xs:documentation>基础亮度：主题的整体明暗基调</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="TimelineAttrs">
    <!-- 来源：Timeline -->
    <xs:attribute name="node_color_pending" type="xs:string">
      <xs:annotation>
        <xs:documentation>待处理状态节点颜色（语义色名或颜色值）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="node_color_inprogress" type="xs:string">
      <xs:annotation>
        <xs:documentation>进行中状态节点颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="node_color_completed" type="xs:string">
      <xs:annotation>
        <xs:documentation>已完成状态节点颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="node_color_failed" type="xs:string">
      <xs:annotation>
        <xs:documentation>失败状态节点颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="line_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>连接线颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="line_style" type="xs:string">
      <xs:annotation>
        <xs:documentation>连接线样式："solid"实线 / "dashed"虚线</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="scrollbar_track_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>滚动条轨道颜色（语义色名或颜色值）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="scrollbar_thumb_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>滚动条滑块颜色（语义色名或颜色值）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="auto_hide_scrollbar" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否仅在鼠标悬停时显示滚动条（默认开启，更美观）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="reverse" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否倒序显示（默认正序，即数据顺序从上到下）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="node_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>节点直径（像素，自动DPI缩放，4~64）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="item_spacing" type="xs:string">
      <xs:annotation>
        <xs:documentation>相邻条目间距（像素，自动DPI缩放）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="empty_text" type="xs:string">
      <xs:annotation>
        <xs:documentation>空数据提示文本（无条目时居中显示）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="empty_text_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>空数据提示文本的多语言ID（语言切换时自动刷新）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="loading" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否显示加载中状态</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="ControlAttrs6">
    <!-- 来源：Control -->
    <xs:attribute name="class" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件样式,用样式里面的属性值来设置本控件的属性,如"btn_default",可以同时指定多个样式,各个样式之间用空格分隔,需要写在第一个属性位置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="enable_vars" type="xs:string">
      <xs:annotation>
        <xs:documentation>属性值中是否支持变量展开。 用法举例：假设在globle.xml中增加一行变量定义：&lt;Define name="SIZE_ICON_SMALL" value="16"/&gt; XML中的控件属性字符串中可以这样使用这个变量：width="${SIZE_ICON_SMALL}" 代码中也可以这样调用函数设置属性代码：Control::SetAttribute(_T("width"), _T("${SIZE_ICON_SMALL}"));</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="name" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件名字,同一窗口建议保持唯一，否则影响查询效率，也可能查询不到正确的结果</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="xs:string">
      <xs:annotation>
        <xs:documentation>可以设置int或string类型的值.当值为int是则设置控件的宽度值,如"100";当值为string时,stretch代表由父容器计算控件宽度,auto代表根据内容情况自动计算宽度,如果为百分比值"50%"，代表该控件的宽度期望值为父控件宽度的50%</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="xs:string">
      <xs:annotation>
        <xs:documentation>可以设置int或string类型的值.当值为int是则设置控件的高度值,如"100";当值为string时,stretch代表由父容器计算控件高度,auto代表根据内容情况自动计算高度,如果为百分比值"30%"，代表该控件的高度期望值为父控件高度的30%</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="min_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的最小宽度,如"30"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="min_height" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的最小高度,如"30"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="max_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的最大宽度,描述同width</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="max_height" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的最大高度,描述同height</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="margin" type="xs:string">
      <xs:annotation>
        <xs:documentation>外边距,如"2,2,2,2"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="padding" type="xs:string">
      <xs:annotation>
        <xs:documentation>内边距,如"2,2,2,2"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="control_padding" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许控件自身运用内边距</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="halign" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的水平方向的对齐方式,如"center",支持left、center、right三种位置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="valign" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的垂直方向的对齐方式,如"center",支持top、center、bottom三种位置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="align" type="xs:string">
      <xs:annotation>
        <xs:documentation>同时设置控件的水平方向和垂直方向的对齐方式，功能与valign和halign相同。 可取值: left、right、hcenter、top、vcenter、bottom，用逗号分割，如"hcenter,vcenter"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="float" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否使用绝对定位,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="keep_float_pos" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置当父控件位置和大小调整时，是否保持浮动控件相对父控件的位置不变,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bkcolor" type="xs:string">
      <xs:annotation>
        <xs:documentation>背景颜色字符串常量,如"white"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bkcolor2" type="xs:string">
      <xs:annotation>
        <xs:documentation>第二背景颜色字符串常量,如果设置了第二背景色，则支持背景颜色渐变,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bkcolor2_direction" type="xs:string">
      <xs:annotation>
        <xs:documentation>第二背景色方向，"1": 左-&gt;右，"2": 上-&gt;下，"3": 左上-&gt;右下，"4": 右上-&gt;左下</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fore_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>前景颜色字符串，前景色一般设置半透明的颜色，比如"#10006DD9"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="normal_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>普通状态颜色,如"white"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hovered_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>悬浮状态颜色,如"white"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pressed_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>按下状态颜色,如"white"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>禁用状态颜色,如"white"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="normal_color_margin" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置普通状态下的控件颜色外边距</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hovered_color_margin" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置悬浮状态下的控件颜色外边距</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pressed_color_margin" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置按下状态下的控件颜色外边距</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_color_margin" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置禁用状态下的控件颜色外边距</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="state_color_min_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置状态颜色区域的最小宽度（解决设置Margin后，DPI缩放运算精度损失导致线条宽度失真问题）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="state_color_min_height" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置状态颜色区域的最小高度（解决设置Margin后，DPI缩放运算精度损失导致线条宽度失真问题）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="normal_color_round" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置普通状态下的控件颜色圆角大小</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hovered_color_round" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置悬浮状态下的控件颜色圆角大小</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pressed_color_round" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置按下状态下的控件颜色圆角大小</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_color_round" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置禁用状态下的控件颜色圆角大小</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置所有状态下的边框颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="normal_border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>正常状态的边框颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hovered_border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>悬浮状态的边框颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pressed_border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>按下状态的边框颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>禁止状态的边框颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="focused_border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>焦点状态的边框颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="border_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>可以设置int或rect类型的值。当值为int时则左、上、右、下都用该值作为宽。值为rect类型时则分别设置左、上、右、下的边框</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="border_dash_style" type="xs:string">
      <xs:annotation>
        <xs:documentation>线的形状，可选值： "solid"：实线 "dash"：短划线构成的虚线 "dot"：点构成的虚线 "dash_dot"：交替短划线点线 "dash_dot_dot"：交替短划线点点线</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="borders_on_top" type="xs:string">
      <xs:annotation>
        <xs:documentation>边框是否在顶层（即先绘制子控件，后绘制边框，避免边框被子控件覆盖）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="left_border_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>左边边框大小,如"1",设置该值大于0,则将忽略border_size属性的设置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="top_border_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>顶部边框大小,如"1",设置该值大于0,则将忽略border_size属性的设置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="right_border_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>右边边框大小,如"1",设置该值大于0,则将忽略border_size属性的设置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bottom_border_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>底部边框大小,如"1",设置该值大于0,则将忽略border_size属性的设置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="border_round" type="xs:string">
      <xs:annotation>
        <xs:documentation>边框圆角半径,如"2,2"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bkimage" type="xs:string">
      <xs:annotation>
        <xs:documentation>背景图片,如"bk.bmp或file='aaa.jpg' res='' dest='0,0,0,0' source='0,0,0,0' corner='0,0,0,0' fade='255' xtiled='false' ytiled='false'"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="normal_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>普通状态图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hovered_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标悬浮的状态图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pressed_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标按下的状态图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>禁用的状态图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fore_normal_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>普通状态前景图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fore_hovered_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标悬浮的状态前景图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fore_pressed_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标按下的状态前景图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fore_disabled_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>禁用的状态前景图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tooltip_text" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标悬浮提示,如"请在这里输入你的密码"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tooltip_text_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标悬浮提示,指定多语言模块的ID,当tooltiptext为空时则显示此属性,如"TOOL_TIP_ID"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tooltip_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标悬浮提示所占的宽度</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="data_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>自定义字符串数据,辅助函数，供用户使用</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="user_data_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>自定义整型数据, 供用户使用</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="enabled" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否可以响应用户操作,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="mouse_enabled" type="xs:string">
      <xs:annotation>
        <xs:documentation>本控件是否可以响应鼠标操作,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="keyboard_enabled" type="xs:string">
      <xs:annotation>
        <xs:documentation>非CButtonUI类忽略该值,为false时不支持TAB_STOP,且该对象不处理键盘信息</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="visible" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否可见,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_visible" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否可见,如"true",此属性会触发控件动画效果</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="menu" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否需要右键菜单,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="no_focus" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否可以获取焦点,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tab_stop" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许通过按TAB键切换到此控件</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="show_focused_rect" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否显示焦点状态(一个虚线构成的矩形)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="focused_rect_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>焦点状态矩形的颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="alpha" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的整体透明度,如alpha="128"，有效值为 0-255</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="state" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的当前状态: 支持normal、hovered、pressed、disabled状态</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="cursor_type" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标移动到控件上时的鼠标光标: "arrow"：箭头 "hand"：手型 "wait"：忙碌 "cross"：十字线 "ibeam"：I型光标,文本光标 "size_we"：水平调整 "size_ns"：垂直调整 "size_nwse"：对角线调整，西北-东南调整 "size_nesw"：对角线调整，东北-西南调整 "size_all"：移动，四向调整 "no"：禁止光标 "progress"：进度，应用启动光标</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="render_offset" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件绘制时的偏移量,如"10,10",一般用于绘制动画</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_hovered" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件鼠标悬停状态下的透明渐变动画,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_hovered_frame_interval_ms" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置播放Hovered状态动画的定时器时间间隔（毫秒）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_hovered_total_ms" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置Hovered状态动画总的播放时间（毫秒）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_hovered_easing_function" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置Hovered状态动画缓动函数类型,支持的缓动函数类型参见EasingFunctions::GetEasingFunctionType实现函数</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_alpha" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件透明渐变动画。有效值如下： fade_alpha="false"：不启用控件透明渐变动画 fade_alpha="true"：启用控件透明渐变动画，最终控件的Alpha值设置为255 fade_alpha="128"：启用控件透明渐变动画，最终控件的Alpha值设置为128，这种情况下的有效值为1-255。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件宽度渐变动画,如"true"。控件宽度不能是拉伸类型，该属性必须写在width属性后面</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_height" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件高度渐变动画,如"true"。控件高度不能是拉伸类型，该属性必须写height属性后面</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件大小（高度和宽度）的渐变动画,如"true"。控件高度和宽度不能是拉伸类型，该属性必须写height属性和width属性后面</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_in_out_x_from_left" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件从左到右的动画,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_in_out_x_from_right" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件从右到左的动画,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_in_out_y_from_top" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件从上到下的动画,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_in_out_y_from_bottom" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件从下到上的动画,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_frame_interval_ms" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置播放动画的定时器时间间隔（毫秒）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_total_ms" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置动画总的播放时间（毫秒）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_easing_function" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置动画缓动函数类型,支持的缓动函数类型参见EasingFunctions::GetEasingFunctionType实现函数</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="paint_order" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置绘制顺序：0 表示常规绘制，非0表示指定绘制顺序，值越大表示越晚绘制</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="start_image_animation" type="xs:string">
      <xs:annotation>
        <xs:documentation>播放动画，最多3个参数，每个参数用','分割，详见函数的参数列表</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="stop_image_animation" type="xs:string">
      <xs:annotation>
        <xs:documentation>停止动画，最多3个参数，每个参数用','分割 ，详见函数的参数列表</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="set_image_animation_frame" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置动画当前帧，最多2个参数，每个参数用','分割，详见函数的参数列表</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="box_shadow" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置控件的阴影属性，举例：boxshadow="color='red' offset='0,0' blurradius='8' spreadradius='8'"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="enable_drag_drop" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许拖放操作，包括拖入文件和拖入文本</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="enable_drop_file" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许拖入文件操作</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="drop_file_types" type="xs:string">
      <xs:annotation>
        <xs:documentation>拖放文件操作支持的后缀名列表，比如:".txt;.csv"，表示仅支持txt和csv文件；如果为空，表示支持所有文件</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="row_span" type="xs:string">
      <xs:annotation>
        <xs:documentation>单元格合并属性，占几行（默认占1行），仅在GridLayout布局中生效</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="col_span" type="xs:string">
      <xs:annotation>
        <xs:documentation>单元格合并属性，占几列（默认占1列），仅在GridLayout布局中生效</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
