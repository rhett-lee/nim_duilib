      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>标题栏文字的多语言资源ID；设置后立即按当前语言解析为标题，切换语言时自动刷新；语言文件中找不到该ID时保留原标题。与 Label 的 text_id 用法一致</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title_height" type="xs:string">
      <xs:annotation>
        <xs:documentation>标题栏高度（像素，自动DPI缩放）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title_bk_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>标题栏背景色（语义色名，不设置则不绘制背景）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title_text_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>标题文字颜色（语义色名）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title_text_align" type="xs:string">
      <xs:annotation>
        <xs:documentation>标题文字水平对齐方式，可选值："left"、"hcenter"、"right"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title_font" type="xs:string">
      <xs:annotation>
        <xs:documentation>标题字体ID（global.xml 中的 Font id）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="collapsible" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否可折叠：为 true 时，点击标题栏（或箭头热区）可折叠/展开内容区</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="collapsed" type="xs:string">
      <xs:annotation>
        <xs:documentation>初始是否处于折叠状态；初始设置不触发事件、不播放动画</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="collapse_trigger" type="xs:string">
      <xs:annotation>
        <xs:documentation>折叠触发热区："title" 表示整个标题栏可点击；"arrow" 表示仅箭头区域可点击</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="collapse_anim" type="xs:string">
      <xs:annotation>
        <xs:documentation>折叠/展开动画时长（毫秒），0 表示无动画、立即切换，建议取值 150~300</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="arrow_align" type="xs:string">
      <xs:annotation>
        <xs:documentation>折叠箭头的位置："right"（标题栏右侧，默认）或 "left"（标题栏左侧）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="group" type="xs:string">
      <xs:annotation>
        <xs:documentation>手风琴分组名：同一窗口内同组面板同时只允许一个展开（允许全部折叠）；空字符串表示不分组</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title_slot" type="xs:string">
      <xs:annotation>
        <xs:documentation>标题栏槽位：值为一个子控件的 name，该控件（建议设置 float="true"）会被自动定位到标题栏右侧（箭头左侧），折叠后仍显示且可点击</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="arrow_expanded_normal_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>展开状态（▼）箭头在普通态下的图片属性</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="arrow_expanded_hovered_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>展开状态箭头在悬停态下的图片属性</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="arrow_expanded_pushed_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>展开状态箭头在按下态下的图片属性</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="arrow_expanded_disabled_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>展开状态箭头在禁用态下的图片属性</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="arrow_collapsed_normal_image" type="xs:string">
      <xs:annotation>
