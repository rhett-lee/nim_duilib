    </xs:attribute>
    <xs:attribute name="shadow_type" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置下拉窗口的阴影类型： "default", 默认阴影 "big", 大阴影，直角（适合普通窗口） "big_round", 大阴影，圆角（适合普通窗口） "small", 小阴影，直角（适合普通窗口） "small_round", 小阴影，圆角（适合普通窗口） "menu", 小阴影，直角（适合弹出式窗口，比如菜单等） "menu_round", 小阴影，圆角（适合弹出式窗口，比如菜单等） "none", 无阴影</xs:documentation>
      </xs:annotation>
