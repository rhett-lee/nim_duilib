    <xs:attribute name="arrow_collapsed_hovered_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>折叠状态箭头在悬停态下的图片属性</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="arrow_collapsed_pushed_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>折叠状态箭头在按下态下的图片属性</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="arrow_collapsed_disabled_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>折叠状态箭头在禁用态下的图片属性</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="padding" type="xs:string">
      <xs:annotation>
        <xs:documentation>内容区的内边距；标题栏空间由控件在顶部自动额外预留，padding 只作用于标题栏下方的内容区</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="PopconfirmAttrs">
    <!-- 来源：Popconfirm -->
    <xs:attribute name="description" type="xs:string">
      <xs:annotation>
        <xs:documentation>卡片描述（字面文本，\n表示换行，可省略）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="description_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>卡片描述的多语言ID（与description互斥，优先生效）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="icon" type="xs:string">
      <xs:annotation>
        <xs:documentation>图标语义：warning / info / success / error / none（不显示图标）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="ok_text" type="xs:string">
      <xs:annotation>
        <xs:documentation>"确定"按钮的字面文本（默认为语言键STRID_PUBLIC_STRING_OK）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="ok_text_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>"确定"按钮的多语言ID（优先于ok_text）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="cancel_text" type="xs:string">
      <xs:annotation>
        <xs:documentation>"取消"按钮的字面文本（默认为语言键STRID_PUBLIC_STRING_CANCEL）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="cancel_text_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>"取消"按钮的多语言ID（优先于cancel_text）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="show_cancel" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否显示"取消"按钮</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="ok_type" type="xs:string">
      <xs:annotation>
        <xs:documentation>"确定"按钮样式：primary / default / danger</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="close_on_ok" type="xs:string">
      <xs:annotation>
        <xs:documentation>点击"确定"后是否关闭卡片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="PopoverAttrs">
    <!-- 来源：Popover -->
    <xs:attribute name="title" type="xs:string">
      <xs:annotation>
        <xs:documentation>卡片标题（字面文本，可省略）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>卡片标题的多语言ID（与title互斥，优先生效）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="content" type="xs:string">
      <xs:annotation>
        <xs:documentation>卡片正文（字面文本，\n表示换行，可省略）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="content_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>卡片正文的多语言ID（与content互斥，优先生效）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="content_xml" type="xs:string">
      <xs:annotation>
        <xs:documentation>富内容XML片段（作为卡片根容器的子控件插入；与content互斥）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="trigger" type="xs:string">
      <xs:annotation>
        <xs:documentation>触发方式：click / hover / focus / manual</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="placement" type="xs:string">
      <xs:annotation>
        <xs:documentation>弹出方位：top / top_left / top_right / bottom / bottom_left / bottom_right / left / left_top / left_bottom / right / right_top / right_bottom（下划线可省略，也接受topLeft写法）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="gap" type="xs:string">
      <xs:annotation>
        <xs:documentation>卡片与锚点的间距（像素，DPI缩放）；显示尖角箭头时，指"尖角尖端"到锚点的距离</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="card_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>卡片宽度（像素，DPI缩放，最小120），正文自动换行</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="arrow" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否显示指向锚点的尖角箭头；箭头朝向随弹出方位自动调整，卡片翻转时随之转向</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="auto_dismiss" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否自动关闭：点击卡片与锚点以外的区域、按Esc是否关闭。trigger="manual"时"点击外部关闭"默认不生效（Esc仍受该属性控制），显式设置该属性可恢复</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hover_delay" type="xs:string">
      <xs:annotation>
        <xs:documentation>trigger="hover"时移入锚点后打开前的延迟（毫秒）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="close_delay" type="xs:string">
      <xs:annotation>
        <xs:documentation>trigger="hover"时移出锚点与卡片后关闭前的延迟（毫秒）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="PropertyGridAttrs">
    <!-- 来源：PropertyGrid -->
    <xs:attribute name="property_grid_xml" type="xs:string">
      <xs:annotation>
        <xs:documentation>配置文件XML，如果为空，默认为："public/property_grid/property_grid.xml"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="row_grid_line_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>横向网格线的宽度</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="row_grid_line_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>横向网格线的颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="column_grid_line_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>纵向网格线的宽度</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="column_grid_line_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>纵向网格线的颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="header_class" type="xs:string">
      <xs:annotation>
        <xs:documentation>表头的Class属性，定义方法请参考global.xml 中的对应内容和示例程序</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="group_class" type="xs:string">
      <xs:annotation>
        <xs:documentation>分组的Class属性，定义方法请参考global.xml 中的对应内容和示例程序</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="group_label_class" type="xs:string">
      <xs:annotation>
        <xs:documentation>分组的文本控件Class</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="property_class" type="xs:string">
      <xs:annotation>
        <xs:documentation>属性的Class属性，定义方法请参考global.xml 中的对应内容和示例程序</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="property_name_label_class" type="xs:string">
      <xs:annotation>
        <xs:documentation>属性的名称文本控件Class</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="property_value_label_class" type="xs:string">
      <xs:annotation>
        <xs:documentation>属性的值文本控件Class</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="left_column_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>左侧一列的宽度</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="property_font_normal" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置属性值的字体Id（正常状态）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="property_font_modified" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置属性值的字体Id（已修改状态）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="GridLayoutAttrs">
    <!-- 来源：GridLayout -->
    <xs:attribute name="rows" type="xs:string">
      <xs:annotation>
        <xs:documentation>网格行数(0表示自动计算)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="columns" type="xs:string">
      <xs:annotation>
        <xs:documentation>网格列数(0表示自动计算)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="grid_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>网格单元格宽度(0表示自动计算)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="grid_height" type="xs:string">
      <xs:annotation>
        <xs:documentation>网格单元格高度(0表示自动计算)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="scale_down" type="xs:string">
      <xs:annotation>
        <xs:documentation>当控件内容超出边界时，是否按比例缩小 true 使用子控件的大小，若超出网格大小，按比例缩小，以使控件内容完全显示在网格内 false 忽略子控件自身的大小，子控件的大小与网格大小一致</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="RangeSliderAttrs">
    <!-- 来源：RangeSlider -->
    <xs:attribute name="low_value" type="xs:string">
      <xs:annotation>
        <xs:documentation>下限值（支持浮点），如"200"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="high_value" type="xs:string">
      <xs:annotation>
        <xs:documentation>上限值（支持浮点），与基类的 value 等价</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="min_range" type="xs:string">
      <xs:annotation>
        <xs:documentation>下限与上限之间的最小间距（下限不得超过"上限 - min_range"）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="range_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>高亮选中区间的颜色（语义色名或颜色值，为空则回退使用 progress_color）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="range_radius" type="xs:string">
      <xs:annotation>
        <xs:documentation>高亮选中区间的圆角半径（像素，自动DPI缩放，0为直角）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="click_to_jump" type="xs:string">
      <xs:annotation>
        <xs:documentation>点击轨道是否按下即跳值；false 则保持"松开鼠标才跳值"的旧行为</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="thumb_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>两个滑块的统一大小，如"10,10"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tooltip_open" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否始终显示两个滑块的值气泡（false 时：拖动中与悬停该滑块时显示，松开鼠标后延迟 1 秒自动消失）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tooltip_format" type="xs:string">
      <xs:annotation>
        <xs:documentation>值气泡文本格式（如 %.0f）/ 其多语言 ID（优先，语言切换时自动刷新）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tooltip_format_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>值气泡文本格式（如 %.0f）/ 其多语言 ID（优先，语言切换时自动刷新）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tooltip_bkcolor" type="xs:string">
      <xs:annotation>
        <xs:documentation>值气泡背景色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tooltip_text_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>值气泡文本颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="mark_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>刻度点的颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="mark_label_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>刻度标签的默认颜色（marks 中 @color 可覆盖单个标签）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="mark_dot_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>刻度点直径（像素，DPI 缩放）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="mark_label_gap" type="xs:string">
      <xs:annotation>
        <xs:documentation>刻度标签与轨道之间的距离（像素，DPI 缩放）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="snap_to_marks" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否把取值吸附到最近的刻度（拖动、点击轨道与 SetXXX 均生效）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="included" type="xs:string">
      <xs:annotation>
        <xs:documentation>true 高亮两个滑块之间；false 高亮滑块外侧的两段区间</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="RatingAttrs">
    <!-- 来源：Rating -->
    <xs:attribute name="value" type="xs:string">
      <xs:annotation>
        <xs:documentation>当前评分值，钳位到 [0, max]，按 allow_half 对齐步长</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="max" type="xs:string">
      <xs:annotation>
        <xs:documentation>星星数量</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="allow_half" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许半星（步长 0.5，否则 1）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="read_only" type="xs:string">
      <xs:annotation>
        <xs:documentation>只读展示模式，禁止鼠标交互</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="star_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>单颗星绘制直径（像素，自动 DPI 缩放）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="star_gap" type="xs:string">
      <xs:annotation>
        <xs:documentation>星星间距（像素，自动 DPI 缩放）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="star_filled_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>实心星图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="star_half_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>半星图片（可选，未配置时对实心星做左半裁剪绘制）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="star_empty_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>空心星图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="star_hovered_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>星悬停态图标，可选（绘制在星形下层，形成外圈光晕 / 描边）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="star_pressed_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>星按下态图标，可选；未配置时回退悬停态图标</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="RichEditAttrs">
    <!-- 来源：RichEdit -->
    <xs:attribute name="vscrollbar" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否使用竖向滚动条,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hscrollbar" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否使用横向滚动条,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="auto_vscroll" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否随输入竖向滚动,如"true"(当为SDL实现时，该选项无效)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="auto_hscroll" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否随输入横向滚动,如"true" (当为SDL实现时，该选项无效)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="want_tab" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否接受tab按键消息,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="want_return" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否接受回车按键消息,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="want_ctrl_return" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否接受ctrl+return按键消息,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="rich_text" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否使用富格式,如"true"(当为SDL实现时，该选项无效)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="single_line" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否使用单行,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="multi_line" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否使用多行,该属性与single_line互斥,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="readonly" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否只读,如"false"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="password" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否为密码模式,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="show_password" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否显示密码符,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="password_char" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置密码字符，默认为 " * " 字符，可用通过这个属性改变</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="flash_password_char" type="xs:string">
      <xs:annotation>
        <xs:documentation>先显示字符，然后再显示密码字符</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="number_only" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否只允许输入数字,如"false"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="max_number" type="xs:string">
      <xs:annotation>
        <xs:documentation>允许的最大数字(仅当number_only为true的时候有效)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="min_number" type="xs:string">
      <xs:annotation>
        <xs:documentation>允许的最小数字(仅当number_only为true的时候有效)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="text_align" type="xs:string">
      <xs:annotation>
        <xs:documentation>文字的水平与垂直对齐方式, 可取值: left、right、hcenter、top、vcenter、bottom，用逗号分割，如"hcenter,vcenter"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="text_padding" type="xs:string">
      <xs:annotation>
        <xs:documentation>文本内边距，如："2,2,2,2"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="text" type="xs:string">
      <xs:annotation>
        <xs:documentation>显示文本</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="text_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>显示文本的多语言功能ID</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="font" type="xs:string">
      <xs:annotation>
        <xs:documentation>字体ID</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="normal_text_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>普通状态文字颜色,不指定则使用默认颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_text_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>禁用状态文字颜色,不指定则使用默认颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="caret_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>光标的颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="prompt_mode" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否显示提示文字,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="prompt_text" type="xs:string">
      <xs:annotation>
        <xs:documentation>文本框内提示文字,当文本框text为空时显示</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="prompt_text_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>多语言功能的ID,如"TEXT_OUT"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="prompt_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>文本框内提示文字的颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="focused_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>焦点状态下的图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="auto_detect_url" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否自动检测URL，如果是URL则显示为超链接 (当为SDL实现时，该选项无效)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="limit_text" type="xs:string">
      <xs:annotation>
        <xs:documentation>限制最多字符数</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="limit_chars" type="xs:string">
      <xs:annotation>
        <xs:documentation>限制允许输入哪些字符，比如"abc"表示只允许输入a、b、c字符，不允许输入其他字符</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="allow_beep" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许发出Beep声音 (当为SDL实现时，该选项无效)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="word_wrap" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否自动换行</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="no_caret_readonly" type="xs:string">
      <xs:annotation>
        <xs:documentation>只读模式，不显示光标</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="save_selection" type="xs:string">
      <xs:annotation>
        <xs:documentation>如果 为 true，则当控件处于非活动状态时，应保存所选内容的边界 (当为SDL实现时，该选项无效)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hide_selection" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否隐藏选择内容</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="zoom" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置缩放比例：设 wParam：缩放比例的分子，lParam：缩放比例的分母。"wParam,lParam" 表示按缩放比例分子/分母显示的缩放，取值范围：1/64 &lt; (wParam / lParam) &lt; 64。举例：则："0,0"表示关闭缩放功能，"2,1"表示放大到200%，"1,2"表示缩小到50%</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="wheel_zoom" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许Ctrl + 滚轮来调整缩放比例</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="default_context_menu" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否使用默认的右键菜单</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="spin_class" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置Spin功能的Class名称，如果不为空则显示Spin按钮，详细用法参见示例程序</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="clear_btn_class" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置清除按钮功能的Class名称，如果不为空则显示清楚按钮，详细用法参见示例程序</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="show_password_btn_class" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置显示密码按钮功能的Class名称，如果不为空则显示显示密码按钮 ，详细用法参见示例程序</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="selection_bkcolor" type="xs:string">
      <xs:annotation>
        <xs:documentation>选择文本的背景色（焦点状态） 如果设置为空，则不显示</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="inactive_selection_bkcolor" type="xs:string">
      <xs:annotation>
        <xs:documentation>选择文本的背景色（非焦点状态），如果设置为空，则不显示</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="current_row_bkcolor" type="xs:string">
      <xs:annotation>
        <xs:documentation>当前行的背景色（焦点状态），如果设置为空，则在焦点状态不显示当前行的背景色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="inactive_current_row_bkcolor" type="xs:string">
      <xs:annotation>
        <xs:documentation>当前行的背景色（非焦点状态），如果设置为空，则在非焦点状态不显示当前行的背景色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="select_all_on_focused" type="xs:string">
      <xs:annotation>
        <xs:documentation>获取焦点的时候，是否全选</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="focused_bottom_border_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>焦点状态时，底部边框的大小</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="focused_bottom_border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>焦点状态时，底部边框的颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="enable_drag_drop" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许拖放操作</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="enable_drop_file" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许拖放文件操作</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="enable_drag_out" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许文本拖出功能（作为拖放源），仅Windows平台支持，其他平台不支持，该选项仅在RichEdit2中支持</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="drop_file_types" type="xs:string">
      <xs:annotation>
        <xs:documentation>拖放文件操作支持的后缀名列表，比如:".txt;.csv"，表示仅支持txt和csv文件；如果为空，表示支持所有文件</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="row_spacing_mul" type="xs:string">
      <xs:annotation>
        <xs:documentation>行间距倍数, 比如1.5代表1.5倍行间距 Windows平台：仅当rich_text属性"true"时有效，因为Windows平台的RichEdit控件只有富文本模式时支持设置行间距； 使用SDL时，始终有效，即其他平台时，行间距属性均有效</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="row_spacing_add" type="xs:string">
      <xs:annotation>
        <xs:documentation>行间距附加量: 是固定的附加像素值（默认值通常为 0），用于在比例调整的基础上增加固定偏移（像素），仅当使用SDL时有效</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="ScrollBoxAttrs2">
    <!-- 来源：ScrollBox -->
    <xs:attribute name="vscrollbar_style" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置本容器的纵向滚动条的样式</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hscrollbar_style" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置本容器的横向滚动条的样式</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="vscrollbar_class" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置本容器的纵向滚动条的Class</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hscrollbar_class" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置本容器的横向滚动条的Class</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="scrollbar_padding" type="xs:string">
      <xs:annotation>
        <xs:documentation>滚动条的外边距,可以让滚动条不占满容器,如"2,2,2,2"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="vscroll_unit" type="xs:string">
      <xs:annotation>
        <xs:documentation>容器的垂直滚动条滚动步长, 0代表使用默认步长</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hscroll_unit" type="xs:string">
      <xs:annotation>
        <xs:documentation>容器的水平滚动条滚动步长, 0代表使用默认步长</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="scrollbar_float" type="xs:string">
      <xs:annotation>
        <xs:documentation>容器的滚动条是否悬浮在子控件上面,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="vscrollbar_left" type="xs:string">
      <xs:annotation>
        <xs:documentation>容器的滚动条是否在左侧显示</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hold_end" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否一直保持显示末尾位置,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="ControlAttrs5">
    <!-- 来源：Control -->
    <xs:attribute name="class" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件样式,用样式里面的属性值来设置本控件的属性,如"btn_default",可以同时指定多个样式,各个样式之间用空格分隔,需要写在第一个属性位置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="enable_vars" type="xs:string">
      <xs:annotation>
        <xs:documentation>属性值中是否支持变量展开。 用法举例：假设在globle.xml中增加一行变量定义：&lt;Define name="SIZE_ICON_SMALL" value="16"/&gt; XML中的控件属性字符串中可以这样使用这个变量：width="${SIZE_ICON_SMALL}" 代码中也可以这样调用函数设置属性代码：Control::SetAttribute(_T("width"), _T("${SIZE_ICON_SMALL}"));</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="name" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件名字,同一窗口建议保持唯一，否则影响查询效率，也可能查询不到正确的结果</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="xs:string">
      <xs:annotation>
        <xs:documentation>可以设置int或string类型的值.当值为int是则设置控件的宽度值,如"100";当值为string时,stretch代表由父容器计算控件宽度,auto代表根据内容情况自动计算宽度,如果为百分比值"50%"，代表该控件的宽度期望值为父控件宽度的50%</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="xs:string">
      <xs:annotation>
        <xs:documentation>可以设置int或string类型的值.当值为int是则设置控件的高度值,如"100";当值为string时,stretch代表由父容器计算控件高度,auto代表根据内容情况自动计算高度,如果为百分比值"30%"，代表该控件的高度期望值为父控件高度的30%</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="min_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的最小宽度,如"30"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="min_height" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的最小高度,如"30"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="max_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的最大宽度,描述同width</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="max_height" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的最大高度,描述同height</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="control_padding" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许控件自身运用内边距</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="halign" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的水平方向的对齐方式,如"center",支持left、center、right三种位置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="valign" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的垂直方向的对齐方式,如"center",支持top、center、bottom三种位置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="align" type="xs:string">
      <xs:annotation>
        <xs:documentation>同时设置控件的水平方向和垂直方向的对齐方式，功能与valign和halign相同。 可取值: left、right、hcenter、top、vcenter、bottom，用逗号分割，如"hcenter,vcenter"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="float" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否使用绝对定位,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="keep_float_pos" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置当父控件位置和大小调整时，是否保持浮动控件相对父控件的位置不变,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bkcolor" type="xs:string">
      <xs:annotation>
        <xs:documentation>背景颜色字符串常量,如"white"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bkcolor2" type="xs:string">
      <xs:annotation>
        <xs:documentation>第二背景颜色字符串常量,如果设置了第二背景色，则支持背景颜色渐变,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bkcolor2_direction" type="xs:string">
      <xs:annotation>
        <xs:documentation>第二背景色方向，"1": 左-&gt;右，"2": 上-&gt;下，"3": 左上-&gt;右下，"4": 右上-&gt;左下</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fore_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>前景颜色字符串，前景色一般设置半透明的颜色，比如"#10006DD9"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="normal_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>普通状态颜色,如"white"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hovered_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>悬浮状态颜色,如"white"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pressed_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>按下状态颜色,如"white"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>禁用状态颜色,如"white"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="normal_color_margin" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置普通状态下的控件颜色外边距</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hovered_color_margin" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置悬浮状态下的控件颜色外边距</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pressed_color_margin" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置按下状态下的控件颜色外边距</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_color_margin" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置禁用状态下的控件颜色外边距</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="state_color_min_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置状态颜色区域的最小宽度（解决设置Margin后，DPI缩放运算精度损失导致线条宽度失真问题）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="state_color_min_height" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置状态颜色区域的最小高度（解决设置Margin后，DPI缩放运算精度损失导致线条宽度失真问题）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="normal_color_round" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置普通状态下的控件颜色圆角大小</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hovered_color_round" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置悬浮状态下的控件颜色圆角大小</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pressed_color_round" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置按下状态下的控件颜色圆角大小</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_color_round" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置禁用状态下的控件颜色圆角大小</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置所有状态下的边框颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="normal_border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>正常状态的边框颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hovered_border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>悬浮状态的边框颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pressed_border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>按下状态的边框颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>禁止状态的边框颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="focused_border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>焦点状态的边框颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="border_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>可以设置int或rect类型的值。当值为int时则左、上、右、下都用该值作为宽。值为rect类型时则分别设置左、上、右、下的边框</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="border_dash_style" type="xs:string">
      <xs:annotation>
        <xs:documentation>线的形状，可选值： "solid"：实线 "dash"：短划线构成的虚线 "dot"：点构成的虚线 "dash_dot"：交替短划线点线 "dash_dot_dot"：交替短划线点点线</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="borders_on_top" type="xs:string">
      <xs:annotation>
        <xs:documentation>边框是否在顶层（即先绘制子控件，后绘制边框，避免边框被子控件覆盖）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="left_border_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>左边边框大小,如"1",设置该值大于0,则将忽略border_size属性的设置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="top_border_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>顶部边框大小,如"1",设置该值大于0,则将忽略border_size属性的设置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="right_border_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>右边边框大小,如"1",设置该值大于0,则将忽略border_size属性的设置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bottom_border_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>底部边框大小,如"1",设置该值大于0,则将忽略border_size属性的设置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="border_round" type="xs:string">
      <xs:annotation>
        <xs:documentation>边框圆角半径,如"2,2"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bkimage" type="xs:string">
      <xs:annotation>
        <xs:documentation>背景图片,如"bk.bmp或file='aaa.jpg' res='' dest='0,0,0,0' source='0,0,0,0' corner='0,0,0,0' fade='255' xtiled='false' ytiled='false'"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="normal_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>普通状态图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hovered_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标悬浮的状态图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pressed_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标按下的状态图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>禁用的状态图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fore_normal_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>普通状态前景图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fore_hovered_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标悬浮的状态前景图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fore_pressed_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标按下的状态前景图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fore_disabled_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>禁用的状态前景图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tooltip_text" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标悬浮提示,如"请在这里输入你的密码"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tooltip_text_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标悬浮提示,指定多语言模块的ID,当tooltiptext为空时则显示此属性,如"TOOL_TIP_ID"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tooltip_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标悬浮提示所占的宽度</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="data_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>自定义字符串数据,辅助函数，供用户使用</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="user_data_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>自定义整型数据, 供用户使用</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="enabled" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否可以响应用户操作,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="mouse_enabled" type="xs:string">
      <xs:annotation>
        <xs:documentation>本控件是否可以响应鼠标操作,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="keyboard_enabled" type="xs:string">
      <xs:annotation>
        <xs:documentation>非CButtonUI类忽略该值,为false时不支持TAB_STOP,且该对象不处理键盘信息</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="visible" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否可见,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_visible" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否可见,如"true",此属性会触发控件动画效果</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="menu" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否需要右键菜单,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="no_focus" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否可以获取焦点,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tab_stop" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许通过按TAB键切换到此控件</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="show_focused_rect" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否显示焦点状态(一个虚线构成的矩形)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="focused_rect_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>焦点状态矩形的颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="alpha" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的整体透明度,如alpha="128"，有效值为 0-255</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="state" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件的当前状态: 支持normal、hovered、pressed、disabled状态</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="cursor_type" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标移动到控件上时的鼠标光标: "arrow"：箭头 "hand"：手型 "wait"：忙碌 "cross"：十字线 "ibeam"：I型光标,文本光标 "size_we"：水平调整 "size_ns"：垂直调整 "size_nwse"：对角线调整，西北-东南调整 "size_nesw"：对角线调整，东北-西南调整 "size_all"：移动，四向调整 "no"：禁止光标 "progress"：进度，应用启动光标</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="render_offset" type="xs:string">
      <xs:annotation>
        <xs:documentation>控件绘制时的偏移量,如"10,10",一般用于绘制动画</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_hovered" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件鼠标悬停状态下的透明渐变动画,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_hovered_frame_interval_ms" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置播放Hovered状态动画的定时器时间间隔（毫秒）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_hovered_total_ms" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置Hovered状态动画总的播放时间（毫秒）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_hovered_easing_function" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置Hovered状态动画缓动函数类型,支持的缓动函数类型参见EasingFunctions::GetEasingFunctionType实现函数</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_alpha" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件透明渐变动画。有效值如下： fade_alpha="false"：不启用控件透明渐变动画 fade_alpha="true"：启用控件透明渐变动画，最终控件的Alpha值设置为255 fade_alpha="128"：启用控件透明渐变动画，最终控件的Alpha值设置为128，这种情况下的有效值为1-255。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件宽度渐变动画,如"true"。控件宽度不能是拉伸类型，该属性必须写在width属性后面</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_height" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件高度渐变动画,如"true"。控件高度不能是拉伸类型，该属性必须写height属性后面</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件大小（高度和宽度）的渐变动画,如"true"。控件高度和宽度不能是拉伸类型，该属性必须写height属性和width属性后面</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_in_out_x_from_left" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件从左到右的动画,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_in_out_x_from_right" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件从右到左的动画,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_in_out_y_from_top" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件从上到下的动画,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_in_out_y_from_bottom" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用控件从下到上的动画,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_frame_interval_ms" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置播放动画的定时器时间间隔（毫秒）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_total_ms" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置动画总的播放时间（毫秒）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fade_easing_function" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置动画缓动函数类型,支持的缓动函数类型参见EasingFunctions::GetEasingFunctionType实现函数</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="loading" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置控件加载中状态的UI显示相关属性，使用方法与Image属性相似。 使用示例：loading="file='loading.xml' width='0' height='0' offset_x='-1' offset_y='-1' valign='center' halign='center' fade='255' animation_control='loading_animation' auto_stop='true'" loading的可用属性如下： "file": XML资源文件名，根据此设置去加载XML资源，最终放在一个Box容器中显示 "width": longding控件的显示宽度，像素 "height": longding控件的显示高度，像素 "offset_x": longding控件的位置X方向偏移，相对于关联控件的左上角，有效值: &gt;= 0 "offset_y": longding控件的位置Y方向偏移，相对于关联控件的左上角，有效值: &gt;= 0 "halign":水平方向对齐方式，可取值："left" "center" "right"，仅当offset_x不含有效值时生效 "valign":垂直方向对齐方式，可取值："top" "center" "bottom"，仅当offset_y不含有效值时生效 "fade":loading控件的透明度，有效值： 0 - 255 "auto_stop"：loading动画播放结束以后，自动停止loading状态（自动调用StopLoading()函数） "animation_control":动画控件的名称，用于Loading功能与loading控件上的动画控件交互使用 loading功能的完整演示，可参考examples/ListCtrl示例程序</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="paint_order" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置绘制顺序：0 表示常规绘制，非0表示指定绘制顺序，值越大表示越晚绘制</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="start_image_animation" type="xs:string">
      <xs:annotation>
        <xs:documentation>播放动画，最多3个参数，每个参数用','分割，详见函数的参数列表</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="stop_image_animation" type="xs:string">
      <xs:annotation>
        <xs:documentation>停止动画，最多3个参数，每个参数用','分割 ，详见函数的参数列表</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="set_image_animation_frame" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置动画当前帧，最多2个参数，每个参数用','分割，详见函数的参数列表</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="box_shadow" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置控件的阴影属性，举例：boxshadow="color='red' offset='0,0' blurradius='8' spreadradius='8'"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="row_span" type="xs:string">
      <xs:annotation>
        <xs:documentation>单元格合并属性，占几行（默认占1行），仅在GridLayout布局中生效</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="col_span" type="xs:string">
      <xs:annotation>
        <xs:documentation>单元格合并属性，占几列（默认占1列），仅在GridLayout布局中生效</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="RichEdit2Attrs">
    <!-- 来源：RichEdit2 -->
    <xs:attribute name="vscrollbar" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否使用竖向滚动条,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hscrollbar" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否使用横向滚动条,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="auto_vscroll" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否随输入竖向滚动,如"true"(当为SDL实现时，该选项无效)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="auto_hscroll" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否随输入横向滚动,如"true" (当为SDL实现时，该选项无效)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="want_tab" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否接受tab按键消息,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="want_return" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否接受回车按键消息,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="want_ctrl_return" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否接受ctrl+return按键消息,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="rich_text" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否使用富格式,如"true"(当为SDL实现时，该选项无效)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="single_line" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否使用单行,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="multi_line" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否使用多行,该属性与single_line互斥,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="readonly" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否只读,如"false"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="password" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否为密码模式,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="show_password" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否显示密码符,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="password_char" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置密码字符，默认为 " * " 字符，可用通过这个属性改变</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="flash_password_char" type="xs:string">
      <xs:annotation>
        <xs:documentation>先显示字符，然后再显示密码字符</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="number_only" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否只允许输入数字,如"false"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="max_number" type="xs:string">
      <xs:annotation>
        <xs:documentation>允许的最大数字(仅当number_only为true的时候有效)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="min_number" type="xs:string">
      <xs:annotation>
        <xs:documentation>允许的最小数字(仅当number_only为true的时候有效)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="text_align" type="xs:string">
      <xs:annotation>
        <xs:documentation>文字的水平与垂直对齐方式, 可取值: left、right、hcenter、top、vcenter、bottom，用逗号分割，如"hcenter,vcenter"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="text_padding" type="xs:string">
      <xs:annotation>
        <xs:documentation>文本内边距，如："2,2,2,2"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="text" type="xs:string">
      <xs:annotation>
        <xs:documentation>显示文本</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="text_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>显示文本的多语言功能ID</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="font" type="xs:string">
      <xs:annotation>
        <xs:documentation>字体ID</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="normal_text_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>普通状态文字颜色,不指定则使用默认颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_text_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>禁用状态文字颜色,不指定则使用默认颜色,如"blue"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="caret_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>光标的颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="prompt_mode" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否显示提示文字,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="prompt_text" type="xs:string">
      <xs:annotation>
        <xs:documentation>文本框内提示文字,当文本框text为空时显示</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="prompt_text_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>多语言功能的ID,如"TEXT_OUT"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="prompt_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>文本框内提示文字的颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="focused_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>焦点状态下的图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="auto_detect_url" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否自动检测URL，如果是URL则显示为超链接 (当为SDL实现时，该选项无效)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="limit_text" type="xs:string">
      <xs:annotation>
        <xs:documentation>限制最多字符数</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="limit_chars" type="xs:string">
      <xs:annotation>
        <xs:documentation>限制允许输入哪些字符，比如"abc"表示只允许输入a、b、c字符，不允许输入其他字符</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="allow_beep" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许发出Beep声音 (当为SDL实现时，该选项无效)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="word_wrap" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否自动换行</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="no_caret_readonly" type="xs:string">
      <xs:annotation>
        <xs:documentation>只读模式，不显示光标</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="save_selection" type="xs:string">
      <xs:annotation>
        <xs:documentation>如果 为 true，则当控件处于非活动状态时，应保存所选内容的边界 (当为SDL实现时，该选项无效)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hide_selection" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否隐藏选择内容</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="zoom" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置缩放比例：设 wParam：缩放比例的分子，lParam：缩放比例的分母。"wParam,lParam" 表示按缩放比例分子/分母显示的缩放，取值范围：1/64 &lt; (wParam / lParam) &lt; 64。举例：则："0,0"表示关闭缩放功能，"2,1"表示放大到200%，"1,2"表示缩小到50%</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="wheel_zoom" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许Ctrl + 滚轮来调整缩放比例</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="default_context_menu" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否使用默认的右键菜单</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="spin_class" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置Spin功能的Class名称，如果不为空则显示Spin按钮，详细用法参见示例程序</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="clear_btn_class" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置清除按钮功能的Class名称，如果不为空则显示清楚按钮，详细用法参见示例程序</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="show_password_btn_class" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置显示密码按钮功能的Class名称，如果不为空则显示显示密码按钮 ，详细用法参见示例程序</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="selection_bkcolor" type="xs:string">
      <xs:annotation>
        <xs:documentation>选择文本的背景色（焦点状态） 如果设置为空，则不显示</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="inactive_selection_bkcolor" type="xs:string">
      <xs:annotation>
        <xs:documentation>选择文本的背景色（非焦点状态），如果设置为空，则不显示</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="current_row_bkcolor" type="xs:string">
      <xs:annotation>
        <xs:documentation>当前行的背景色（焦点状态），如果设置为空，则在焦点状态不显示当前行的背景色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="inactive_current_row_bkcolor" type="xs:string">
      <xs:annotation>
        <xs:documentation>当前行的背景色（非焦点状态），如果设置为空，则在非焦点状态不显示当前行的背景色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="select_all_on_focused" type="xs:string">
      <xs:annotation>
        <xs:documentation>获取焦点的时候，是否全选</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="focused_bottom_border_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>焦点状态时，底部边框的大小</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="focused_bottom_border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>焦点状态时，底部边框的颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="enable_drag_drop" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许拖放操作</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="enable_drop_file" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许拖放文件操作</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="enable_drag_out" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否允许文本拖出功能（作为拖放源），仅Windows平台支持，其他平台不支持，该选项仅在RichEdit2中支持</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="drop_file_types" type="xs:string">
      <xs:annotation>
        <xs:documentation>拖放文件操作支持的后缀名列表，比如:".txt;.csv"，表示仅支持txt和csv文件；如果为空，表示支持所有文件</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="row_spacing_mul" type="xs:string">
      <xs:annotation>
        <xs:documentation>行间距倍数, 比如1.5代表1.5倍行间距 Windows平台：仅当rich_text属性"true"时有效，因为Windows平台的RichEdit控件只有富文本模式时支持设置行间距； 使用SDL时，始终有效，即其他平台时，行间距属性均有效</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="row_spacing_add" type="xs:string">
      <xs:annotation>
        <xs:documentation>行间距附加量: 是固定的附加像素值（默认值通常为 0），用于在比例调整的基础上增加固定偏移（像素），仅当使用SDL时有效</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="RichTextAttrs">
    <!-- 来源：RichText -->
    <xs:attribute name="text_align" type="xs:string">
      <xs:annotation>
        <xs:documentation>文字的水平与垂直对齐方式, 可取值: left、right、hcenter、top、vcenter、bottom，用逗号分割，如"hcenter,vcenter"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="text_padding" type="xs:string">
      <xs:annotation>
        <xs:documentation>文本内边距，如："2,2,2,2"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
