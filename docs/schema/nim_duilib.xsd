    <xs:attribute name="circle_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>环形进度条的宽度，如"10"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="indicator" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置进度指示移动图标</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="clockwise" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置递增方向</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bgcolor" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置进度条背景颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fgcolor" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置进度条前景色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="gradient_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置进度条前景渐变颜色，与 fgcolor 同时使用，可以不设置则无渐变效果</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="indeterminate" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否不确定进度（忽略 value，一段弧持续旋转）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="start_angle" type="xs:string">
      <xs:annotation>
        <xs:documentation>圆弧起始角度（度），0 为12 点方向，顺时针递增；360 会被归一化为 0</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="span_angle" type="xs:string">
      <xs:annotation>
        <xs:documentation>圆弧总跨度（度），取值范围 (0, 360]；小于 360 即为缺口环/仪表盘</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="indeterminate_arc" type="xs:string">
      <xs:annotation>
        <xs:documentation>不确定进度模式下旋转弧的弧长（度）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="indeterminate_speed" type="xs:string">
      <xs:annotation>
        <xs:documentation>不确定进度模式下旋转角速度（度/次刷新）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="indeterminate_interval" type="xs:string">
      <xs:annotation>
        <xs:documentation>不确定进度模式的刷新间隔（毫秒），默认约 60 帧/秒</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="center_ratio" type="xs:string">
      <xs:annotation>
        <xs:documentation>中心内容区占控件的百分比（0~100），如"70"表示中心区为控件的 70%</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="center_padding" type="xs:string">
      <xs:annotation>
        <xs:documentation>中心内容区内边距，如"4,4,4,4"（XML 中按 DPI 缩放）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="ProgressAttrs">
    <!-- 来源：Progress -->
    <xs:attribute name="horizontal" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否水平的，"true"表示水平，"false"表示垂直</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="min" type="xs:string">
      <xs:annotation>
        <xs:documentation>进度最小值,如"0"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="max" type="xs:string">
      <xs:annotation>
        <xs:documentation>进度最大值,如"100"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="value" type="xs:string">
      <xs:annotation>
        <xs:documentation>进度值（支持浮点），如"50"或"0.5"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="progress_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>进度条前景图片</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="stretch_fore_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>指定进度条前景图片是否缩放显示</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="progress_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>进度条前景颜色（语义色名或颜色值），如"bg_progress"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="progress_radius" type="xs:string">
      <xs:annotation>
        <xs:documentation>纯色前景的圆角半径（像素，自动DPI缩放，0为直角）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="buffer_value" type="xs:string">
      <xs:annotation>
        <xs:documentation>次级进度值（缓冲/buffer，通常比主进度略靠前，如视频已缓存位置；≤min 不绘制）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="buffer_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>次级进度颜色（语义色名或颜色值，为空则用前景色的浅色版）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="show_percent" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否自动显示百分比文本（覆盖控件 text）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="animation_enabled" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否启用值变化动画（默认关闭）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="animation_duration" type="xs:string">
      <xs:annotation>
        <xs:documentation>值变化动画时长（毫秒）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="animation_easing" type="xs:string">
      <xs:annotation>
        <xs:documentation>值变化动画的缓动曲线，取值与 EasingFunctionType 枚举名完全一致，如"EaseLinear"、"EaseOutQuad"、"EaseOutElastic"、"EaseInOutBounce"（首字母大小写均可；无法识别时按 EaseLinear 处理）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="marquee" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否滚动显示</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="marquee_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>滚动的宽度</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="marquee_step" type="xs:string">
      <xs:annotation>
        <xs:documentation>滚动的步长</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="reverse" type="xs:string">
      <xs:annotation>
        <xs:documentation>进度是否反向填充：false 为 value=min 时空、value=max 时满格；true 则相反（value=min 时满格）。min != 0 时同样按比例正确换算</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="ClassAttrs">
    <!-- 来源：Class -->
    <xs:attribute name="name" type="xs:string">
      <xs:annotation>
        <xs:documentation>通用样式名称</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="WindowAttrs">
    <!-- 来源：Window -->
    <xs:attribute name="caption" type="xs:string">
      <xs:annotation>
        <xs:documentation>窗口可拖动的标题栏大小的边距, 最后一个参数是指离上边框的距离,如"0,0,0,36"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="use_system_caption" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置是否使用系统标题栏</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="snap_layout_menu" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否支持显示贴靠布局菜单（Windows 11新功能：通过将鼠标悬停在窗口的最大化按钮上或按 Win + Z，可以轻松访问对齐布局。），该属性仅当在窗口为分层窗口或者使用系统阴影时默认开启</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="sys_menu" type="xs:string">
      <xs:annotation>
        <xs:documentation>在右键点击标题栏时，是否显示系统的窗口菜单（可进行调整窗口状态，关闭窗口等操作）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="sys_menu_rect" type="xs:string">
      <xs:annotation>
        <xs:documentation>窗口菜单区域，在窗口标题栏的左上角（双击该区域可关闭窗口，点击显示系统的窗口菜单），该功能若XML中无设置，默认是关闭的</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="icon" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置窗口的图标文件路径，支持ico格式</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="text" type="xs:string">
      <xs:annotation>
        <xs:documentation>窗体标题字符串</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="text_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>窗体标题字符串的ID, ID在多语言文件中指定, 如"STRID_MIANWINDOW_TITLE"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="drag_drop" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置窗口内控件是否支持拖放操作（拖入文件/文本）：true=支持，false=不支持</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="shadow_attached" type="xs:string">
      <xs:annotation>
        <xs:documentation>窗口是否附加阴影效果，如"true"表示开启窗口阴影功能，"false"表示关闭窗口阴影功能 如果设置了shadow_type属性，相当于隐式将shadow_attached设置为"true"， 所以一般设置了shadow_type属性以后，不需要再单独设置shadow_attached属性</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="shadow_type" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置窗口的阴影类型： "default"：默认自绘阴影 "big"：有自绘阴影（大），直角，有边框（适合普通窗口） "big_round"：有自绘阴影（大），圆角，有边框（适合普通窗口） "small"：有自绘阴影（小），直角，有边框（适合普通窗口） "small_round"：有自绘阴影（小），圆角，有边框（适合普通窗口） "menu"：有自绘阴影（小），直角，有边框（适合弹出式窗口，比如菜单等） "menu_round"：有自绘阴影（小），圆角，有边框（适合弹出式窗口，比如菜单等） "none"：无阴影，直角，有边框 "none_round"：无阴影，圆角，有边框（自绘） "custom": 自定义自绘阴影，该类型需要同时设置shadow_image、shadow_corner、shadow_border_round属性 "system_default"：使用系统阴影，跟随操作系统默认窗口阴影属性 "system_not_round"：使用系统阴影，直角 "system_round"：使用系统阴影，圆角 "system_small_round"：使用系统阴影，小圆角 兼容性说明： （1）对于Win7和Win10系统：系统阴影仅支持"system_default"这一个，其他三个不支持 （2）对于Win11系统，四个系统阴影属性均支持，系统默认阴影为圆角 （3）对于macOS系统，四个系统阴影属性均支持，系统默认阴影为圆角 （4）对于Linux系统和FreeBSD系统，不支持系统阴影 （5）若设置为不支持的系统阴影，会自动切换为相应支持的系统阴影或者自绘阴影</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="shadow_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>使用自定义的阴影图片去代替默认的阴影效果，该属性一般仅当shadow_type="custom"时设置 设置的路径要注意相对路径以及九宫格属性， 如(file='public/shadow/shadow_big.svg' corner='64,64,68,70')</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="shadow_corner" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置了shadow_image属性后，设置此属性来指定阴影素材的九宫格描述，该属性一般仅当shadow_type="custom"时设置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="shadow_border_round" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置了shadow_image属性后，设置此属性来指定阴影的圆角属性，该属性一般仅当shadow_type="custom"时设置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="shadow_border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置窗口阴影的边框颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="shadow_border_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置窗口阴影的边框像素大小，实际视觉显示的边框宽度为此值的一半（例如设置为2，实际显示1像素）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="shadow_snap" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置阴影是否支持窗口贴边操作，如果为true，则在窗口贴近屏幕边缘时，这一侧的阴影自动隐藏，以增大视图内的有效空间 该属性仅当使用自绘阴影时有效，当使用系统阴影时无效</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="size" type="xs:string">
      <xs:annotation>
        <xs:documentation>窗口的初始化大小, 支持的格式：size="1200,800", 或者size="50%,50%", 或者size="1200,50%", size="50%,800"，百分比是指屏幕宽度或者高度的百分比</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="size_contain_shadow" type="xs:string">
      <xs:annotation>
        <xs:documentation>窗口的初始化大小(size属性)，是否包含窗口的阴影，默认不包含，窗口的实际大小是配置的size值 + 阴影大小</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="min_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>窗口最小大小, 如"320,240"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="max_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>窗口最大大小, 如"1600,1200"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="size_box" type="xs:string">
      <xs:annotation>
        <xs:documentation>窗口可拖动改变窗口大小的边距, 如"4,4,4,4"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="round_corner" type="xs:string">
      <xs:annotation>
        <xs:documentation>窗口圆角大小, 如"4,4"，该属性在使用窗口阴影（即设置了shadow_type属性）时，一般不需要设置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="layered_window" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置是否为层窗口，使用注意事项： （1）该属性在使用窗口阴影（即设置了shadow_type属性）时不需要设置，窗口阴影功能会根据需要来管理该属性 （2）当使用系统标题栏时（即use_system_caption="true"），不应设置该属性</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="opacity" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置不透明度数值[0, 255]，当 opacity 为 0 时，窗口是完全透明的。 当 opacity 为 255 时，窗口是不透明的。 仅当layered_window="true"时有效，所以如果当前不是分层窗口，内部会自动设置为分层窗口 该参数在SetLayeredWindowAttributes函数中作为参数使用(bAlpha)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="render_backend_type" type="xs:string">
      <xs:annotation>
        <xs:documentation>"CPU": CPU绘制 "GL": 使用OpenGL绘制 注意事项: （1）一个线程内，只允许有一个窗口使用OpenGL绘制，否则会出现导致程序崩溃的问题 （2）OpenGL绘制的窗口，不能是分层窗口（即带有WS_EX_LAYERED属性的窗口），因此使用GL渲染时，layered_window、alpha、opacity 属性均无效 （3）使用OpenGL的窗口，每次绘制都是绘制整个窗口，不支持局部绘制，所以不一定比使用CPU绘制的情况下性能更好</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="ColorPickerRegularAttrs">
    <!-- 来源：ColorPickerRegular -->
    <xs:attribute name="color_type" type="xs:string">
      <xs:annotation>
        <xs:documentation>颜色数据来源："default" 使用默认颜色表，"basic" 使用基本颜色表</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="item_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>每个颜色块的大小，如"40,20"（继承 VirtualVTileListBox 属性）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="columns" type="xs:string">
      <xs:annotation>
        <xs:documentation>显示的列数，如"10"（继承 VirtualVTileListBox 属性）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="VirtualVTileListBoxAttrs">
    <!-- 来源：VirtualVTileListBox -->
    <xs:attribute name="scale_down" type="xs:string">
      <xs:annotation>
        <xs:documentation>当控件内容超出边界时，按比例缩小，以使控件内容完全显示在瓦片区域内</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="ListBoxAttrs">
    <!-- 来源：ListBox -->
    <xs:attribute name="multi_select" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否支持多选</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="paint_selected_colors" type="xs:string">
      <xs:annotation>
        <xs:documentation>多选的时候，是否显示选择背景色 默认规则：如果有CheckBox，多选的时候，默认不显示选择背景色；其他情况下显示背景色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="scroll_select" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否随鼠标滚轮的滚动改变选中项设置(此选项仅单选有效)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="select_next_when_active_removed" type="xs:string">
      <xs:annotation>
        <xs:documentation>在移除一个子项后, 如果被移除项是选择项，是否自动选择下一项(此选项仅单选有效)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="frame_selection" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否支持鼠标框选功能，仅多选模式下生效</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="frame_selection_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标框选填充颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="frame_selection_border_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标框选边框的大小</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="frame_selection_border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标框选边框颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="frame_selection_alpha" type="xs:string">
      <xs:annotation>
        <xs:documentation>鼠标框选填充颜色的Alpha值</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="select_none_when_click_blank" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置当鼠标点击空白部分时，是否取消选择(仅当开启鼠标框选功能时有效)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="select_like_list_ctrl" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置选择模式：与ListCtrl类似（即Windows资源管理器中，对文件操作类似的方式），仅多选模式有效</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="ScrollBoxAttrs">
    <!-- 来源：ScrollBox -->
    <xs:attribute name="vscrollbar" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否使用竖向滚动条,如(true)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hscrollbar" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否使用横向滚动条,如(true)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="vscrollbar_style" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置本容器的纵向滚动条的样式</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hscrollbar_style" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置本容器的横向滚动条的样式</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="vscrollbar_class" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置本容器的纵向滚动条的Class</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hscrollbar_class" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置本容器的横向滚动条的Class</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="scrollbar_padding" type="xs:string">
      <xs:annotation>
        <xs:documentation>滚动条的外边距,可以让滚动条不占满容器,如"2,2,2,2"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="vscroll_unit" type="xs:string">
      <xs:annotation>
        <xs:documentation>容器的垂直滚动条滚动步长, 0代表使用默认步长</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hscroll_unit" type="xs:string">
      <xs:annotation>
        <xs:documentation>容器的水平滚动条滚动步长, 0代表使用默认步长</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="scrollbar_float" type="xs:string">
      <xs:annotation>
        <xs:documentation>容器的滚动条是否悬浮在子控件上面,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="vscrollbar_left" type="xs:string">
      <xs:annotation>
        <xs:documentation>容器的滚动条是否在左侧显示</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hold_end" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否一直保持显示末尾位置,如"true"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="SliderAttrs">
    <!-- 来源：Slider -->
    <xs:attribute name="thumb_normal_image" type="xs:string">
