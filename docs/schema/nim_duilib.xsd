    </xs:attribute>
    <xs:attribute name="tick_label_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>刻度值文本的颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
