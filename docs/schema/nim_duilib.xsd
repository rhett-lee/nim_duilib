    <xs:attribute name="mask_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>蒙层颜色（语义色名或颜色值）；为空表示不绘制蒙层底色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="highlight_control" type="xs:string">
      <xs:annotation>
        <xs:documentation>需要镂空(高亮)的控件名称（在整个窗口内按名称查找，目标控件可以是 Mask 之外的任意控件）；为空表示不镂空，整块区域均为蒙层</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="highlight_padding" type="xs:string">
      <xs:annotation>
        <xs:documentation>镂空区域相对高亮控件的内边距（DPI自适应）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="highlight_corner" type="xs:string">
      <xs:annotation>
        <xs:documentation>镂空区域的圆角半径（DPI自适应）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="click_through" type="xs:string">
      <xs:annotation>
        <xs:documentation>镂空区域内的鼠标点击是否穿透到下层控件；通常配合highlight_control用于新手引导</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="WindowAttrs2">
    <!-- 来源：Window -->
    <xs:attribute name="caption" type="xs:string">
      <xs:annotation>
        <xs:documentation>窗口可拖动的标题栏大小的边距, 最后一个参数是指离上边框的距离,如"0,0,0,36"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="use_system_caption" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置是否使用系统标题栏</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="snap_layout_menu" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否支持显示贴靠布局菜单（Windows 11新功能：通过将鼠标悬停在窗口的最大化按钮上或按 Win + Z，可以轻松访问对齐布局。），该属性仅当在窗口为分层窗口或者使用系统阴影时默认开启</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="sys_menu" type="xs:string">
      <xs:annotation>
        <xs:documentation>在右键点击标题栏时，是否显示系统的窗口菜单（可进行调整窗口状态，关闭窗口等操作）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="sys_menu_rect" type="xs:string">
      <xs:annotation>
        <xs:documentation>窗口菜单区域，在窗口标题栏的左上角（双击该区域可关闭窗口，点击显示系统的窗口菜单），该功能若XML中无设置，默认是关闭的</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="icon" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置窗口的图标文件路径，支持ico格式</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="text" type="xs:string">
      <xs:annotation>
        <xs:documentation>窗体标题字符串</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="text_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>窗体标题字符串的ID, ID在多语言文件中指定, 如"STRID_MIANWINDOW_TITLE"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="drag_drop" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置窗口内控件是否支持拖放操作（拖入文件/文本）：true=支持，false=不支持</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="shadow_attached" type="xs:string">
      <xs:annotation>
        <xs:documentation>窗口是否附加阴影效果，如"true"表示开启窗口阴影功能，"false"表示关闭窗口阴影功能 如果设置了shadow_type属性，相当于隐式将shadow_attached设置为"true"， 所以一般设置了shadow_type属性以后，不需要再单独设置shadow_attached属性</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="shadow_type" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置窗口的阴影类型： "default"：默认自绘阴影 "big"：有自绘阴影（大），直角，有边框（适合普通窗口） "big_round"：有自绘阴影（大），圆角，有边框（适合普通窗口） "small"：有自绘阴影（小），直角，有边框（适合普通窗口） "small_round"：有自绘阴影（小），圆角，有边框（适合普通窗口） "menu"：有自绘阴影（小），直角，有边框（适合弹出式窗口，比如菜单等） "menu_round"：有自绘阴影（小），圆角，有边框（适合弹出式窗口，比如菜单等） "none"：无阴影，直角，有边框 "none_round"：无阴影，圆角，有边框（自绘） "custom": 自定义自绘阴影，该类型需要同时设置shadow_image、shadow_corner、shadow_border_round属性 "system_default"：使用系统阴影，跟随操作系统默认窗口阴影属性 "system_not_round"：使用系统阴影，直角 "system_round"：使用系统阴影，圆角 "system_small_round"：使用系统阴影，小圆角 兼容性说明： （1）对于Win7和Win10系统：系统阴影仅支持"system_default"这一个，其他三个不支持 （2）对于Win11系统，四个系统阴影属性均支持，系统默认阴影为圆角 （3）对于macOS系统，四个系统阴影属性均支持，系统默认阴影为圆角 （4）对于Linux系统和FreeBSD系统，不支持系统阴影 （5）若设置为不支持的系统阴影，会自动切换为相应支持的系统阴影或者自绘阴影</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="shadow_image" type="xs:string">
      <xs:annotation>
        <xs:documentation>使用自定义的阴影图片去代替默认的阴影效果，该属性一般仅当shadow_type="custom"时设置 设置的路径要注意相对路径以及九宫格属性， 如(file='public/shadow/shadow_big.svg' corner='64,64,68,70')</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="shadow_corner" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置了shadow_image属性后，设置此属性来指定阴影素材的九宫格描述，该属性一般仅当shadow_type="custom"时设置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="shadow_border_round" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置了shadow_image属性后，设置此属性来指定阴影的圆角属性，该属性一般仅当shadow_type="custom"时设置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="shadow_border_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置窗口阴影的边框颜色</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="shadow_border_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置窗口阴影的边框像素大小，实际视觉显示的边框宽度为此值的一半（例如设置为2，实际显示1像素）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="shadow_snap" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置阴影是否支持窗口贴边操作，如果为true，则在窗口贴近屏幕边缘时，这一侧的阴影自动隐藏，以增大视图内的有效空间 该属性仅当使用自绘阴影时有效，当使用系统阴影时无效</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="size" type="xs:string">
      <xs:annotation>
        <xs:documentation>窗口的初始化大小, 支持的格式：size="1200,800", 或者size="50%,50%", 或者size="1200,50%", size="50%,800"，百分比是指屏幕宽度或者高度的百分比</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="size_contain_shadow" type="xs:string">
      <xs:annotation>
        <xs:documentation>窗口的初始化大小(size属性)，是否包含窗口的阴影，默认不包含，窗口的实际大小是配置的size值 + 阴影大小</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="min_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>窗口最小大小, 如"320,240"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="max_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>窗口最大大小, 如"1600,1200"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="size_box" type="xs:string">
      <xs:annotation>
        <xs:documentation>窗口可拖动改变窗口大小的边距, 如"4,4,4,4"</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="round_corner" type="xs:string">
      <xs:annotation>
        <xs:documentation>窗口圆角大小, 如"4,4"，该属性在使用窗口阴影（即设置了shadow_type属性）时，一般不需要设置</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="layered_window" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置是否为层窗口，使用注意事项： （1）该属性在使用窗口阴影（即设置了shadow_type属性）时不需要设置，窗口阴影功能会根据需要来管理该属性 （2）当使用系统标题栏时（即use_system_caption="true"），不应设置该属性</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="alpha" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置透明度数值[0, 255]，当 alpha 为 0 时，窗口是完全透明的。 当 alpha 为 255 时，窗口是不透明的。 仅当layered_window="true"时有效， 该参数在UpdateLayeredWindow函数中作为参数使用(BLENDFUNCTION.SourceConstantAlpha)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="opacity" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置不透明度数值[0, 255]，当 opacity 为 0 时，窗口是完全透明的。 当 opacity 为 255 时，窗口是不透明的。 仅当layered_window="true"时有效，所以如果当前不是分层窗口，内部会自动设置为分层窗口 该参数在SetLayeredWindowAttributes函数中作为参数使用(bAlpha)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="render_backend_type" type="xs:string">
      <xs:annotation>
        <xs:documentation>"CPU": CPU绘制 "GL": 使用OpenGL绘制 注意事项: （1）一个线程内，只允许有一个窗口使用OpenGL绘制，否则会出现导致程序崩溃的问题 （2）OpenGL绘制的窗口，不能是分层窗口（即带有WS_EX_LAYERED属性的窗口），因此使用GL渲染时，layered_window、alpha、opacity 属性均无效 （3）使用OpenGL的窗口，每次绘制都是绘制整个窗口，不支持局部绘制，所以不一定比使用CPU绘制的情况下性能更好</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="MenuBarAttrs">
    <!-- 来源：MenuBar -->
    <xs:attribute name="id" type="xs:string">
      <xs:annotation>
        <xs:documentation>顶级菜单项的ID，回调函数中用于标识菜单来源</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="text" type="xs:string">
      <xs:annotation>
        <xs:documentation>顶级菜单项显示的文本</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="text_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>顶级菜单项文本的多语言ID（text 为空时使用）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="xml_path" type="xs:string">
      <xs:annotation>
        <xs:documentation>该顶级菜单对应的菜单XML资源路径</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="NavigationViewAttrs">
    <!-- 来源：NavigationView -->
    <xs:attribute name="pane_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>展开态窗格宽度（像素，DPI 自适应；仅接受正值，&lt;=0 保持默认值）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="compact_pane_width" type="xs:string">
      <xs:annotation>
        <xs:documentation>紧凑态窗格宽度（像素，DPI 自适应；仅接受正值，&lt;=0 保持默认值）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pane_title" type="xs:string">
      <xs:annotation>
        <xs:documentation>窗格标题文字（紧凑态下标题自动隐藏）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pane_title_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>窗格标题文字 ID（多语言，优先于 pane_title）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="toggle_icon" type="xs:string">
      <xs:annotation>
        <xs:documentation>汉堡按钮图标图片属性串，如 file='nav/hamburger.svg' width='16' height='16'</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="collapsed" type="xs:string">
      <xs:annotation>
        <xs:documentation>初始是否为紧凑态（true=仅显示图标）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="show_header" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否显示内容区页头（显示当前选中项文字）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="settings_item" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否在窗格底部显示设置项（不随导航列表滚动，不参与序号统计）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="settings_page" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置项关联的内容页 name</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="settings_text_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置项文字 ID（多语言，由使用方提供）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="settings_icon" type="xs:string">
      <xs:annotation>
        <xs:documentation>设置项图标图片属性串（由使用方提供）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="selected_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>初始选中项对应的 page name；为空或找不到时选中第一个可选项（不含设置项）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="NavigationViewItemAttrs">
    <!-- 来源：NavigationViewItem -->
    <xs:attribute name="text" type="xs:string">
      <xs:annotation>
        <xs:documentation>项文字</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="text_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>项文字 ID（多语言，优先于 text）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="icon" type="xs:string">
      <xs:annotation>
        <xs:documentation>图标图片属性串，如 file='nav/home.svg' width='16' height='16'</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="page" type="xs:string">
      <xs:annotation>
        <xs:documentation>关联的内容页控件 name（与内容区页面联动）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="item_type" type="xs:string">
      <xs:annotation>
        <xs:documentation>形态：item（默认，可点击导航项）/ header（分组标题，兼容 group_header）/ separator（分隔线，兼容 sep）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="icon_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>图标尺寸（DIP，DPI 自适应；仅接受正值）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="icon_left" type="xs:string">
      <xs:annotation>
        <xs:documentation>展开态图标左边距（DIP）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="text_left" type="xs:string">
      <xs:annotation>
        <xs:documentation>展开态文字左边距（DIP）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="text_right" type="xs:string">
      <xs:annotation>
        <xs:documentation>展开态文字右边距（DIP）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pill_radius" type="xs:string">
      <xs:annotation>
        <xs:documentation>选中/悬停热区圆角半径（DIP）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pill_inset_x" type="xs:string">
      <xs:annotation>
        <xs:documentation>热区水平内缩量（DIP）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pill_inset_y" type="xs:string">
      <xs:annotation>
        <xs:documentation>热区垂直内缩量（DIP）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="selected_bg_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>选中背景色名</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hovered_bg_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>悬停背景色名</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="selected_text_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>选中文字色名</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="normal_text_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>普通文字色名</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled_text_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>禁用文字色名</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="header_text_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>分组标题文字色名</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="separator_color" type="xs:string">
      <xs:annotation>
        <xs:documentation>分隔线颜色名</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="PaginationAttrs">
    <!-- 来源：Pagination -->
    <xs:attribute name="page_count" type="xs:string">
      <xs:annotation>
        <xs:documentation>总页数</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="current_page" type="xs:string">
      <xs:annotation>
        <xs:documentation>当前页码（1 起），钳位到 [1, page_count]</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="total_count" type="xs:string">
      <xs:annotation>
        <xs:documentation>总记录数（与 page_size 配合推导 page_count，可选）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="page_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>每页记录数（可选；total_count + page_size &gt; 0 时优先推导）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="show_page_size" type="xs:string">
      <xs:annotation>
        <xs:documentation>是否显示“每页条数”选择器（可选功能，默认关闭）</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="page_size_format" type="xs:string">
      <xs:annotation>
        <xs:documentation>候选项文本格式（含 %d 占位符，如 %d 条/页）；ID 优先并支持多语言</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="page_size_format_id" type="xs:string">
      <xs:annotation>
        <xs:documentation>候选项文本格式（含 %d 占位符，如 %d 条/页）；ID 优先并支持多语言</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="page_size_class" type="xs:string">
      <xs:annotation>
        <xs:documentation>每页条数选择器（Combo）引用的皮肤 Class</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="page_size_width" type="xs:string">
