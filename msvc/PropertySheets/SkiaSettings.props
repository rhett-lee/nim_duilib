<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <!-- 该文件中设置 Skia 的 配置选项（必选项） -->
    <PropertyGroup Label="Globals">

        <!-- Skia的宏定义 -->
        <SkiaPreprocessorDefinitions Condition="'$(Configuration)'=='Release'">SK_GANESH;SK_GL;SK_RELEASE</SkiaPreprocessorDefinitions>
        <SkiaPreprocessorDefinitions Condition="'$(Configuration)'=='Debug'">SK_GANESH;SK_GL;SK_RELEASE</SkiaPreprocessorDefinitions>

        <!-- Skia的include目录 -->
        <SkiaIncludeDir>$(SolutionDir)\..\..\skia</SkiaIncludeDir>

        <!-- Skia的lib目录: 目前固定使用 llvm 编译 -->
        <SkiaLibDir Condition="'$(Configuration)|$(Platform)'=='Release|x64'">$(SolutionDir)\..\..\skia\out\llvm.x64.release</SkiaLibDir>
        <SkiaLibDir Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">$(SolutionDir)\..\..\skia\out\llvm.x64.debug</SkiaLibDir>
        <SkiaLibDir Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">$(SolutionDir)\..\..\skia\out\llvm.x86.release</SkiaLibDir>
        <SkiaLibDir Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">$(SolutionDir)\..\..\skia\out\llvm.x86.debug</SkiaLibDir>
        <!-- ARM64 需预先用同样的 GN 参数构建 llvm.arm64.*；目录不存在时链接阶段会报路径错误 -->
        <SkiaLibDir Condition="'$(Configuration)|$(Platform)'=='Release|ARM64'">$(SolutionDir)\..\..\skia\out\llvm.arm64.release</SkiaLibDir>
        <SkiaLibDir Condition="'$(Configuration)|$(Platform)'=='Debug|ARM64'">$(SolutionDir)\..\..\skia\out\llvm.arm64.debug</SkiaLibDir>

        <!-- DLL模式（存在 duilib_dll.flag 时）：duilib 用 /MD 动态运行库，
             必须链接同样使用 /MD 编译的 Skia，否则 LNK2038(RuntimeLibrary 不匹配)。
             Release 对应 llvm.<arch>.release.md，Debug 对应 llvm.<arch>.debug.mdd -->
        <DuilibDllModeFlag Condition="Exists('$(MSBuildThisFileDirectory)duilib_dll.flag')">true</DuilibDllModeFlag>
        <SkiaLibDir Condition="'$(Configuration)|$(Platform)'=='Release|x64' AND '$(DuilibDllModeFlag)'=='true'">$(SolutionDir)\..\..\skia\out\llvm.x64.release.md</SkiaLibDir>
        <SkiaLibDir Condition="'$(Configuration)|$(Platform)'=='Release|Win32' AND '$(DuilibDllModeFlag)'=='true'">$(SolutionDir)\..\..\skia\out\llvm.x86.release.md</SkiaLibDir>
        <SkiaLibDir Condition="'$(Configuration)|$(Platform)'=='Debug|x64' AND '$(DuilibDllModeFlag)'=='true'">$(SolutionDir)\..\..\skia\out\llvm.x64.debug.mdd</SkiaLibDir>
        <SkiaLibDir Condition="'$(Configuration)|$(Platform)'=='Debug|Win32' AND '$(DuilibDllModeFlag)'=='true'">$(SolutionDir)\..\..\skia\out\llvm.x86.debug.mdd</SkiaLibDir>
        <SkiaLibDir Condition="'$(Configuration)|$(Platform)'=='Release|ARM64' AND '$(DuilibDllModeFlag)'=='true'">$(SolutionDir)\..\..\skia\out\llvm.arm64.release.md</SkiaLibDir>
        <SkiaLibDir Condition="'$(Configuration)|$(Platform)'=='Debug|ARM64' AND '$(DuilibDllModeFlag)'=='true'">$(SolutionDir)\..\..\skia\out\llvm.arm64.debug.mdd</SkiaLibDir>

        <!-- Skia的lib列表 -->
        <SkiaLibs>skia.lib;svg.lib;skshaper.lib;skottie.lib;sksg.lib;jsonreader.lib</SkiaLibs>

    </PropertyGroup>
</Project>