<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <!-- 该文件中设置 libjpeg-turbo 的 配置选项（可选项） -->
    <PropertyGroup Label="Globals">

        <!-- 是否支持libjpeg-turbo的宏定义： 0表示不支持；1 表示支持 -->
        <JpegTurboEnabled>1</JpegTurboEnabled>

        <!-- libjpeg-turbo的include目录 -->
        <JpegTurboIncludeDir Condition="'$(JpegTurboEnabled)' == '0'"></JpegTurboIncludeDir>
        <JpegTurboIncludeDir Condition="'$(JpegTurboEnabled)' != '0' And '$(Platform)'=='x64'">$(SolutionDir)\..\duilib\third_party\libjpeg-turbo\libjpeg-turbo6-win-vc-x64\include</JpegTurboIncludeDir>
        <JpegTurboIncludeDir Condition="'$(JpegTurboEnabled)' != '0' And '$(Platform)'=='Win32'">$(SolutionDir)\..\duilib\third_party\libjpeg-turbo\libjpeg-turbo6-win-vc-x86\include</JpegTurboIncludeDir>
        <JpegTurboIncludeDir Condition="'$(JpegTurboEnabled)' != '0' And '$(Platform)'=='ARM64'">$(SolutionDir)\..\duilib\third_party\libjpeg-turbo\libjpeg-turbo6-win-vc-arm64\include</JpegTurboIncludeDir>
        
        <!-- libjpeg-turbo的lib目录 -->
        <JpegTurboLibDir Condition="'$(JpegTurboEnabled)' == '0'"></JpegTurboLibDir>
        <JpegTurboLibDir Condition="'$(JpegTurboEnabled)' != '0' And '$(Configuration)|$(Platform)'=='Release|x64'">$(SolutionDir)\..\duilib\third_party\libjpeg-turbo\libjpeg-turbo6-win-vc-x64\lib</JpegTurboLibDir>
        <JpegTurboLibDir Condition="'$(JpegTurboEnabled)' != '0' And '$(Configuration)|$(Platform)'=='Debug|x64'">$(SolutionDir)\..\duilib\third_party\libjpeg-turbo\libjpeg-turbo6-win-vc-x64\lib</JpegTurboLibDir>
        <JpegTurboLibDir Condition="'$(JpegTurboEnabled)' != '0' And '$(Configuration)|$(Platform)'=='Release|Win32'">$(SolutionDir)\..\duilib\third_party\libjpeg-turbo\libjpeg-turbo6-win-vc-x86\lib</JpegTurboLibDir>
        <JpegTurboLibDir Condition="'$(JpegTurboEnabled)' != '0' And '$(Configuration)|$(Platform)'=='Debug|Win32'">$(SolutionDir)\..\duilib\third_party\libjpeg-turbo\libjpeg-turbo6-win-vc-x86\lib</JpegTurboLibDir>
        <JpegTurboLibDir Condition="'$(JpegTurboEnabled)' != '0' And '$(Configuration)|$(Platform)'=='Release|ARM64'">$(SolutionDir)\..\duilib\third_party\libjpeg-turbo\libjpeg-turbo6-win-vc-arm64\lib</JpegTurboLibDir>
        <JpegTurboLibDir Condition="'$(JpegTurboEnabled)' != '0' And '$(Configuration)|$(Platform)'=='Debug|ARM64'">$(SolutionDir)\..\duilib\third_party\libjpeg-turbo\libjpeg-turbo6-win-vc-arm64\lib</JpegTurboLibDir>

        <!-- lib列表：
             - 静态模式（/MT、/MTd）：turbojpeg-static.lib，下游与 duilib 一起链；
             - DLL 模式（/MD、/MDd）：turbojpeg.lib 导入库，只由 duilib.dll 链接，
               同时需要把 turbojpeg.dll 复制到 bin/ 供运行期加载。
             预编译的 turbojpeg-static.lib 按 /MT 构建，混入 /MD 的 DLL 会触发
             LNK4098，因此 DLL 模式必须改用动态库。 -->
        <JpegTurboLibs Condition="'$(JpegTurboEnabled)' != '0' And '$(EnableDuilibDll)' == '1'">turbojpeg.lib</JpegTurboLibs>
        <JpegTurboLibs Condition="'$(JpegTurboEnabled)' != '0' And '$(EnableDuilibDll)' != '1'">turbojpeg-static.lib</JpegTurboLibs>
        <JpegTurboLibs Condition="'$(JpegTurboEnabled)' == '0'"></JpegTurboLibs>

        <!-- turbojpeg.dll 所在目录（预编译包中与 lib/ 同级） -->
        <JpegTurboBinDir Condition="'$(JpegTurboEnabled)' != '0'">$(JpegTurboLibDir)\..\bin</JpegTurboBinDir>

    </PropertyGroup>

    <!-- DLL 模式：duilib.dll 依赖 turbojpeg.dll，构建后复制到共享 bin/。
         只在 duilib 工程执行，避免多个示例并行复制同一个文件。 -->
    <Target Name="JpegTurboCopyRuntime" AfterTargets="Build"
            Condition="'$(EnableDuilibDll)' == '1' And '$(JpegTurboEnabled)' != '0' And '$(ProjectName)' == 'duilib'">
        <ItemGroup>
            <_JpegTurboRuntimeDll Include="$(JpegTurboBinDir)\turbojpeg.dll"
                                  Condition="Exists('$(JpegTurboBinDir)\turbojpeg.dll')" />
        </ItemGroup>
        <Copy SourceFiles="@(_JpegTurboRuntimeDll)"
              DestinationFolder="$(SolutionDir)\..\bin"
              SkipUnchangedFiles="true"
              Condition="'@(_JpegTurboRuntimeDll)' != ''" />
        <Warning Condition="'@(_JpegTurboRuntimeDll)' == ''"
                 Text="DLL 模式下未找到 turbojpeg.dll：$(JpegTurboBinDir)\turbojpeg.dll" />
    </Target>

</Project>