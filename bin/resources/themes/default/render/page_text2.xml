<?xml version="1.0" encoding="UTF-8"?>
<Window>
    <!-- 竖排文本测试页：统一卡片样式（圆角 + 边框 + 内边距 + 统一间距），浅色卡片配深色文字，保证文字清晰 -->
    <VScrollBox width="stretch" height="stretch" vscrollbar="true" hscrollbar="false">
        <VBox width="stretch" height="auto" padding="4,4,4,4">

            <!-- 第1组：对齐矩阵（横向：左/中/右 × 纵向：上/中/下） -->
            <HBox height="auto" margin="0,0,0,6">
                <HBox width="92" height="300" bkcolor="bg_window_card" border_size="1" border_color="border_window" border_round="6,6" padding="6,6,6,6" margin="0,0,6,0">
                    <Label height="stretch" width="stretch" text_id="STRID_RENDER_TEXT2_01" text_align="left,top" vertical_text="true" text_color="text_default"/>
                </HBox>
                <HBox width="92" height="300" bkcolor="bg_window_card" border_size="1" border_color="border_window" border_round="6,6" padding="6,6,6,6" margin="0,0,6,0">
                    <Label height="stretch" width="stretch" text_id="STRID_RENDER_TEXT2_02" text_align="left,vcenter" vertical_text="true" text_color="text_default"/>
                </HBox>
                <HBox width="92" height="300" bkcolor="bg_window_card" border_size="1" border_color="border_window" border_round="6,6" padding="6,6,6,6" margin="0,0,14,0">
                    <Label height="stretch" width="stretch" text_id="STRID_RENDER_TEXT2_03" text_align="left,bottom" vertical_text="true" text_color="text_default"/>
                </HBox>
                <HBox width="92" height="300" bkcolor="bg_window_card" border_size="1" border_color="border_window" border_round="6,6" padding="6,6,6,6" margin="0,0,6,0">
                    <Label height="stretch" width="stretch" text_id="STRID_RENDER_TEXT2_04" text_align="center,top" vertical_text="true" text_color="text_default"/>
                </HBox>
                <HBox width="92" height="300" bkcolor="bg_window_card" border_size="1" border_color="border_window" border_round="6,6" padding="6,6,6,6" margin="0,0,6,0">
                    <Label height="stretch" width="stretch" text_id="STRID_RENDER_TEXT2_05" text_align="center,vcenter" vertical_text="true" text_color="text_default"/>
                </HBox>
                <HBox width="92" height="300" bkcolor="bg_window_card" border_size="1" border_color="border_window" border_round="6,6" padding="6,6,6,6" margin="0,0,14,0">
                    <Label height="stretch" width="stretch" text_id="STRID_RENDER_TEXT2_06" text_align="center,bottom" vertical_text="true" text_color="text_default"/>
                </HBox>
                <HBox width="92" height="300" bkcolor="bg_window_card" border_size="1" border_color="border_window" border_round="6,6" padding="6,6,6,6" margin="0,0,6,0">
                    <Label height="stretch" width="stretch" text_id="STRID_RENDER_TEXT2_07" text_align="right,top" vertical_text="true" text_color="text_default"/>
                </HBox>
                <HBox width="92" height="300" bkcolor="bg_window_card" border_size="1" border_color="border_window" border_round="6,6" padding="6,6,6,6" margin="0,0,6,0">
                    <Label height="stretch" width="stretch" text_id="STRID_RENDER_TEXT2_08" text_align="right,vcenter" vertical_text="true" text_color="text_default"/>
                </HBox>
                <HBox width="92" height="300" bkcolor="bg_window_card" border_size="1" border_color="border_window" border_round="6,6" padding="6,6,6,6">
                    <Label height="stretch" width="stretch" text_id="STRID_RENDER_TEXT2_09" text_align="right,bottom" vertical_text="true" text_color="text_default"/>
                </HBox>
            </HBox>

            <!-- 第2组：自动提示与字体样式（自动提示单行/多行、正常/粗体/斜体/删除线/下划线） -->
            <HBox height="auto" margin="0,0,0,6">
                <HBox width="92" height="200" bkcolor="bg_window_card" border_size="1" border_color="border_window" border_round="6,6" padding="6,6,6,6" margin="0,0,6,0">
                    <Label height="stretch" width="stretch" text_id="STRID_RENDER_TEXT2_11" autotooltip="true" vertical_text="true" text_align="right,top" text_color="text_default"/>
                </HBox>
                <HBox width="92" height="200" bkcolor="bg_window_card" border_size="1" border_color="border_window" border_round="6,6" padding="6,6,6,6" margin="0,0,6,0">
                    <Label height="stretch" width="stretch" text_id="STRID_RENDER_TEXT2_12" autotooltip="true" single_line="false" vertical_text="true" text_align="right,top" text_color="text_default"/>
                </HBox>
                <HBox width="92" height="200" bkcolor="bg_window_card" border_size="1" border_color="border_window" border_round="6,6" padding="6,6,6,6" margin="0,0,6,0">
                    <Label height="stretch" width="stretch" text_id="STRID_RENDER_TEXT2_13" font="system_regular_14" vertical_text="true" text_align="right,top" text_color="text_default"/>
                </HBox>
                <HBox width="92" height="200" bkcolor="bg_window_card" border_size="1" border_color="border_window" border_round="6,6" padding="6,6,6,6" margin="0,0,6,0">
                    <Label height="stretch" width="stretch" text_id="STRID_RENDER_TEXT2_14" font="system_bold_14" vertical_text="true" text_align="right,top" text_color="text_default"/>
                </HBox>
                <HBox width="92" height="200" bkcolor="bg_window_card" border_size="1" border_color="border_window" border_round="6,6" padding="6,6,6,6" margin="0,0,6,0">
                    <Label height="stretch" width="stretch" text_id="STRID_RENDER_TEXT2_15" font="system_italic_14" vertical_text="true" text_align="right,top" text_color="text_default"/>
                </HBox>
                <HBox width="92" height="200" bkcolor="bg_window_card" border_size="1" border_color="border_window" border_round="6,6" padding="6,6,6,6" margin="0,0,6,0">
                    <Label height="stretch" width="stretch" text_id="STRID_RENDER_TEXT2_16" font="system_strikeout_14" vertical_text="true" text_align="right,top" text_color="text_default"/>
                </HBox>
                <HBox width="92" height="200" bkcolor="bg_window_card" border_size="1" border_color="border_window" border_round="6,6" padding="6,6,6,6">
                    <Label height="stretch" width="stretch" text_id="STRID_RENDER_TEXT2_17" font="system_underline_14" vertical_text="true" text_align="right,top" text_color="text_default"/>
                </HBox>
            </HBox>

            <!-- 第3组：全风格与行间距（正常行距、spacing_mul、word_spacing、spacing_mul + spacing_add） -->
            <HBox height="auto" margin="0,0,0,6">
                <HBox width="100" height="280" bkcolor="bg_window_card" border_size="1" border_color="border_window" border_round="6,6" padding="6,6,6,6" margin="0,0,6,0">
                    <Label height="stretch" width="stretch" text_id="STRID_RENDER_TEXT2_18" font="system_fullstyle_16" vertical_text="true" text_align="right,top" replace_newline="true" multi_line="true" text_color="text_default"/>
                </HBox>
                <HBox width="100" height="280" bkcolor="bg_window_card" border_size="1" border_color="border_window" border_round="6,6" padding="6,6,6,6" margin="0,0,6,0">
                    <Label height="stretch" width="stretch" text_id="STRID_RENDER_TEXT2_19" text_align="right,vcenter" multi_line="true" replace_newline="true" vertical_text="true" text_color="text_default"/>
                </HBox>
                <HBox width="100" height="280" bkcolor="bg_window_card" border_size="1" border_color="border_window" border_round="6,6" padding="6,6,6,6" margin="0,0,6,0">
                    <Label height="stretch" width="stretch" text_id="STRID_RENDER_TEXT2_20" text_align="right,vcenter" multi_line="true" replace_newline="true" spacing_mul="1.2" vertical_text="true" text_color="text_default"/>
                </HBox>
                <HBox width="100" height="280" bkcolor="bg_window_card" border_size="1" border_color="border_window" border_round="6,6" padding="6,6,6,6" margin="0,0,6,0">
                    <Label height="stretch" width="stretch" text_id="STRID_RENDER_TEXT2_21" text_align="right,vcenter" multi_line="true" replace_newline="true" word_spacing="6" vertical_text="true" text_color="text_default"/>
                </HBox>
                <HBox width="100" height="280" bkcolor="bg_window_card" border_size="1" border_color="border_window" border_round="6,6" padding="6,6,6,6">
                    <Label height="stretch" width="stretch" text_id="STRID_RENDER_TEXT2_22" text_align="right,vcenter" multi_line="true" replace_newline="true" spacing_mul="1.2" spacing_add="6" vertical_text="true" text_color="text_default"/>
                </HBox>
            </HBox>

            <!-- 第4组：长文本与两端对齐（自动换列、不旋转90度、按实际高度绘制） -->
            <HBox height="auto" margin="0,0,0,6">
                <HBox width="92" height="300" bkcolor="bg_window_card" border_size="1" border_color="border_window" border_round="6,6" padding="6,6,6,6" margin="0,0,6,0">
                    <Label height="stretch" width="stretch" text_id="STRID_RENDER_TEXT2_10" text_align="hcenter,vjustify" vertical_text="true" text_color="text_default"/>
                </HBox>
                <HBox width="200" height="300" bkcolor="bg_window_card" border_size="1" border_color="border_window" border_round="6,6" padding="6,6,6,6" margin="0,0,6,0">
                    <Label height="stretch" width="stretch" text_id="STRID_RENDER_TEXT2_23" text_align="hcenter,vjustify" multi_line="true" vertical_text="true" replace_newline="true" text_color="text_default"/>
                </HBox>
                <HBox width="200" height="300" bkcolor="bg_window_card" border_size="1" border_color="border_window" border_round="6,6" padding="6,6,6,6" margin="0,0,6,0">
                    <Label height="stretch" width="stretch" text_id="STRID_RENDER_TEXT2_24" single_line="false" vertical_text="true" ascii_rotate_90="false" text_align="right,top" text_color="text_default"/>
                </HBox>
                <HBox width="220" height="300" bkcolor="bg_window_card" border_size="1" border_color="border_window" border_round="6,6" padding="6,6,6,6">
                    <Label height="stretch" width="stretch" text_id="STRID_RENDER_TEXT2_25" single_line="false" vertical_text="true" use_font_height="false" text_align="right,top" text_color="text_default"/>
                </HBox>
            </HBox>

            <!-- 第5组：竖排字间距与列间距（word_spacing、spacing_mul、spacing_add） -->
            <HBox height="auto" margin="0,0,0,6">
                <HBox width="220" height="300" bkcolor="bg_window_card" border_size="1" border_color="border_window" border_round="6,6" padding="6,6,6,6" margin="0,0,6,0">
                    <Label height="stretch" width="stretch" text_id="STRID_RENDER_TEXT2_26" single_line="false" vertical_text="true" use_font_height="false" word_spacing="3" text_align="right,top" text_color="text_default"/>
                </HBox>
                <HBox width="220" height="300" bkcolor="bg_window_card" border_size="1" border_color="border_window" border_round="6,6" padding="6,6,6,6" margin="0,0,6,0">
                    <Label height="stretch" width="stretch" text_id="STRID_RENDER_TEXT2_27" single_line="false" vertical_text="true" use_font_height="false" word_spacing="3" spacing_mul="1.5" spacing_add="6" text_align="right,top" text_color="text_default"/>
                </HBox>
                <HBox width="220" height="300" bkcolor="bg_window_card" border_size="1" border_color="border_window" border_round="6,6" padding="6,6,6,6">
                    <Label height="stretch" width="stretch" text_id="STRID_RENDER_TEXT2_27" single_line="false" vertical_text="true" use_font_height="false" word_spacing="3" spacing_mul="1.5" spacing_add="12" text_align="right,top" text_color="text_default"/>
                </HBox>
            </HBox>

            <!-- 第6组：字符集覆盖测试（Emoji字体、中文生僻字、双Unicode扩展字符、混排） -->
            <HBox height="auto">
                <HBox width="150" height="300" bkcolor="bg_window_card" border_size="1" border_color="border_window" border_round="6,6" padding="6,6,6,6" margin="0,0,6,0">
                    <Label height="stretch" width="stretch" text_id="STRID_RENDER_TEXT2_28" single_line="false" vertical_text="true" text_align="right,top" text_color="text_default"/>
                </HBox>
                <HBox width="150" height="300" bkcolor="bg_window_card" border_size="1" border_color="border_window" border_round="6,6" padding="6,6,6,6" margin="0,0,6,0">
                    <Label height="stretch" width="stretch" text_id="STRID_RENDER_TEXT2_29" single_line="false" vertical_text="true" text_align="right,top" text_color="text_default"/>
                </HBox>
                <HBox width="150" height="300" bkcolor="bg_window_card" border_size="1" border_color="border_window" border_round="6,6" padding="6,6,6,6" margin="0,0,6,0">
                    <Label height="stretch" width="stretch" text_id="STRID_RENDER_TEXT2_30" single_line="false" vertical_text="true" text_align="right,top" text_color="text_default"/>
                </HBox>
                <HBox width="150" height="300" bkcolor="bg_window_card" border_size="1" border_color="border_window" border_round="6,6" padding="6,6,6,6">
                    <Label height="stretch" width="stretch" text_id="STRID_RENDER_TEXT2_31" single_line="false" vertical_text="true" text_align="right,top" text_color="text_default"/>
                </HBox>
            </HBox>

        </VBox>
    </VScrollBox>
</Window>
