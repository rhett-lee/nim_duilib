<?xml version="1.0" encoding="UTF-8"?>
<Window size="85%,80%" snap_layout_menu="true" sys_menu="true" sys_menu_rect="0,0,36,36" caption="0,0,0,36" shadow_attached="true" size_box="4,4,4,4" text_id="STRID_LAYOUT_TEST_TITLE">
    <!-- 内容卡片样式：与 TreeView 示例保持一致 -->
    <Class name="layout_card" bkcolor="bg_window_card" border_size="1" border_color="border_split_level1" border_round="8,8"/>
    <!-- 标签标题样式：收紧右侧留白，让固定宽度的标签能完整显示文字 -->
    <Class name="layout_tab_item_title" width="stretch" height="24" margin="0,0,0,0" valign="center"
           font="system_regular_12" auto_tooltip="true" mouse_enabled="false"/>

    <!-- 整个窗口中，所有控件都放在这个VBox容器中 -->
    <VBox bkcolor="bg_window_main">
        <!-- 标题栏区域 -->
        <HBox name="window_title_bar" width="stretch" height="36" bkcolor="bg_titlebar">
            <!-- 标题栏：窗口左上角显示区域 -->
            <HBox margin="0,0,30,0" valign="center" width="auto" height="auto" mouse_enabled="false">
                <Control width="18" height="18" bkimage="public/caption/logo.svg" valign="center" margin="8,0,0,0"/>
                <Label text_id="STRID_LAYOUT_TEST_TITLE" valign="center" margin="8,0,0,0" mouse_enabled="false"/>
            </HBox>
            <Control mouse_enabled="false"/>
            <!-- 标题栏：右侧窗口控制区域，窗口最小化、最大化、还原、关闭按钮 -->
            <HBox margin="0,0,0,0" valign="center" width="auto" height="36">
                <Button class="btn_switch_theme" height="32" width="40" name="btn_window_theme" margin="0,2,0,2"/>
                <Button class="btn_switch_lang" height="32" width="40" name="btn_window_language" margin="0,2,0,2"/>
                <Button class="btn_wnd_fullscreen_11" height="32" width="40" name="btn_window_fullscreen" margin="0,2,0,2"/>
                <Button class="btn_wnd_min_11" height="32" width="40" name="btn_window_min" margin="0,2,0,2"/>
                <Box height="stretch" width="40" margin="0,2,0,2">
                    <Button class="btn_wnd_max_11" height="32" width="stretch" name="btn_window_max"/>
                    <Button class="btn_wnd_restore_11" height="32" width="stretch" name="btn_window_restore" visible="false"/>
                </Box>
                <Button class="btn_wnd_close_11" height="stretch" width="40" name="btn_window_close" margin="0,0,0,2"/>
            </HBox>
        </HBox>
        <!-- 标题栏区域结束 -->

        <!-- 显示区域 -->
        <VBox bkcolor="bg_window_main" padding="10,10,10,10">
            <!-- 标签栏 -->
            <TabCtrl class="tab_ctrl" tab_box_name="main_view_tab" selected_id="0"
                     height="40" border_round="8,8" margin="0,0,0,8">
                <TabCtrlItem class="tab_ctrl_item" title_class="layout_tab_item_title" title="Box" width="47" close_button_class="" tab_box_item_index="0"/>
                <TabCtrlItem class="tab_ctrl_item" title_class="layout_tab_item_title" title="HBox" width="56" close_button_class="" tab_box_item_index="1"/>
                <TabCtrlItem class="tab_ctrl_item" title_class="layout_tab_item_title" title="VBox" width="55" close_button_class="" tab_box_item_index="2"/>
                <TabCtrlItem class="tab_ctrl_item" title_class="layout_tab_item_title" title="HFlowBox" width="80" close_button_class="" tab_box_item_index="3"/>
                <TabCtrlItem class="tab_ctrl_item" title_class="layout_tab_item_title" title="VFlowBox" width="79" close_button_class="" tab_box_item_index="4"/>
                <TabCtrlItem class="tab_ctrl_item" title_class="layout_tab_item_title" title="TileBox" width="66" close_button_class="" tab_box_item_index="5"/>
                <TabCtrlItem class="tab_ctrl_item" title_class="layout_tab_item_title" title="ScrollBox" width="76" close_button_class="" tab_box_item_index="6"/>
                <TabCtrlItem class="tab_ctrl_item" title_class="layout_tab_item_title" title="HScrollBox" width="85" close_button_class="" tab_box_item_index="7"/>
                <TabCtrlItem class="tab_ctrl_item" title_class="layout_tab_item_title" title="VScrollBox" width="83" close_button_class="" tab_box_item_index="8"/>
                <TabCtrlItem class="tab_ctrl_item" title_class="layout_tab_item_title" title="HFlowScrollBox" width="110" close_button_class="" tab_box_item_index="9"/>
                <TabCtrlItem class="tab_ctrl_item" title_class="layout_tab_item_title" title="VFlowScrollBox" width="109" close_button_class="" tab_box_item_index="10"/>
                <TabCtrlItem class="tab_ctrl_item" title_class="layout_tab_item_title" title="TileScrollBox" width="95" close_button_class="" tab_box_item_index="11"/>
                <TabCtrlItem class="tab_ctrl_item" title_class="layout_tab_item_title" title="ListBox" width="65" close_button_class="" tab_box_item_index="12"/>
                <TabCtrlItem class="tab_ctrl_item" title_class="layout_tab_item_title" title="Layout" width="63" close_button_class="" tab_box_item_index="13"/>
                <TabCtrlItem class="tab_ctrl_item" title_class="layout_tab_item_title" title="TabBox" width="67" close_button_class="" tab_box_item_index="14"/>
                <TabCtrlItem class="tab_ctrl_item" title_class="layout_tab_item_title" title="GridBox" width="69" close_button_class="" tab_box_item_index="15"/>
                <TabCtrlItem class="tab_ctrl_item" title_class="layout_tab_item_title" title="GridScrollBox" width="100" close_button_class="" tab_box_item_index="16"/>
            </TabCtrl>
            <!-- 内容卡片 -->
            <TabBox class="layout_card" name="main_view_tab" bkcolor="bg_window_card" selected_id="0"
                    fade_switch_type="FadeInOutX"
                    fade_switch_frame_interval_ms="16"
                    fade_switch_total_ms="220"
                    fade_switch_easing_function="EaseOutCubic">
                <VBox name="main_view_page_00" padding="10,10,10,10">
                    <Include src="page_box.xml"/>
                </VBox>
                <VBox name="main_view_page_01" padding="10,10,10,10">
                    <Include src="page_hbox.xml"/>
                </VBox>
                <VBox name="main_view_page_02" padding="10,10,10,10">
                    <Include src="page_vbox.xml"/>
                </VBox>
                <VBox name="main_view_page_03" padding="10,10,10,10">
                    <Include src="page_hflow_box.xml"/>
                </VBox>
                <VBox name="main_view_page_04" padding="10,10,10,10">
                    <Include src="page_vflow_box.xml"/>
                </VBox>
                <VBox name="main_view_page_05" padding="10,10,10,10">
                    <Include src="page_tilebox.xml"/>
                </VBox>
                <VBox name="main_view_page_06" padding="10,10,10,10">
                    <Include src="page_scroll_box.xml"/>
                </VBox>
                <VBox name="main_view_page_07" padding="10,10,10,10">
                    <Include src="page_hscroll_box.xml"/>
                </VBox>
                <VBox name="main_view_page_08" padding="10,10,10,10">
                    <Include src="page_vscroll_box.xml"/>
                </VBox>
                <VBox name="main_view_page_09" padding="10,10,10,10">
                    <Include src="page_hflow_scroll_box.xml"/>
                </VBox>
                <VBox name="main_view_page_10" padding="10,10,10,10">
                    <Include src="page_vflow_scroll_box.xml"/>
                </VBox>
                <VBox name="main_view_page_11" padding="10,10,10,10">
                    <Include src="page_tile_scroll_box.xml"/>
                </VBox>
                <VBox name="main_view_page_12" padding="10,10,10,10">
                    <Include src="page_list_box.xml"/>
                </VBox>
                <VBox name="main_view_page_13" padding="10,10,10,10">
                    <Include src="page_layout.xml"/>
                </VBox>
                <VBox name="main_view_page_14" padding="10,10,10,10">
                    <Include src="page_tabbox.xml"/>
                </VBox>
                <VBox name="main_view_page_15" padding="10,10,10,10">
                    <Include src="page_gridbox.xml"/>
                </VBox>
                <VBox name="main_view_page_16" padding="10,10,10,10">
                    <Include src="page_grid_scroll_box.xml"/>
                </VBox>
            </TabBox>
        </VBox>
    </VBox>
</Window>
