<Window size="90%,80%" min_size="1000,660" size_box="4,4,4,4" use_system_caption="false" snap_layout_menu="true" sys_menu="true" sys_menu_rect="0,0,36,36" caption="0,0,0,36" shadow_attached="true" text_id="STRID_RICHEDIT_TEST_TITLE" icon="public/caption/logo.ico">
    <!-- 该窗口下的Class定义 -->
    <Class name="checkbox_font_class" font="system_regular_14" text_align="hcenter,vcenter"
                                      border_size="1"
                                      hovered_border_color="border_btn_hovered"
                                      pressed_border_color="border_btn_pressed"
                                      selected_normal_color="bg_btn_pressed"
                                      hovered_color="border_btn_hovered"
                                      selected_hovered_color="border_btn_hovered"
                                      pressed_color="bg_btn_pressed"
                                      selected_pressed_color="bg_btn_pressed"/>
    <Class name="btn_font_class" font="system_regular_14" text_align="hcenter,vcenter"
                                      border_size="1"
                                      hovered_border_color="border_btn_hovered"
                                      pressed_border_color="border_btn_pressed"
                                      hovered_color="border_btn_hovered"
                                      pressed_color="bg_btn_pressed" />
    <!-- 卡片容器：内容区域分组显示 -->
    <Class name="panel_card" bkcolor="bg_window_card" border_size="1" border_color="border_split_level1"
                             border_round="8,8"/>

    <!-- 整个窗口中，所有控件都放在这个VBox容器中 -->
    <VBox bkcolor="bg_window_main">
        <!-- 标题栏区域 -->
        <HBox name="window_title_bar" width="stretch" height="36" bkcolor="bg_titlebar">
            <!-- 标题栏：窗口左上角显示区域 -->
            <HBox margin="0,0,30,0" valign="center" width="auto" height="auto" mouse_enabled="false">
                <Control width="18" height="18" bkimage="public/caption/logo.svg" valign="center" margin="8,0,0,0"/>
                <Label text_id="STRID_RICHEDIT_TEST_TITLE" valign="center" margin="8,0,0,0" mouse_enabled="false"/>
            </HBox>
            <Control mouse_enabled="false"/>
            <!-- 标题栏：右侧窗口控制区域，窗口最小化、最大化、还原、关闭按钮 -->
            <HBox margin="0,0,0,0" valign="center" width="auto" height="36">
                <Button class="btn_switch_theme" height="32" width="40" name="btn_window_theme" margin="0,2,0,2"/>
                <Button class="btn_switch_lang" height="32" width="40" name="btn_window_language" margin="0,2,0,2"/>
                <Button class="btn_wnd_fullscreen_11" height="32" width="40" name="btn_window_fullscreen" margin="0,2,0,2"/>
                <Button class="btn_wnd_min_11" height="32" width="40" name="btn_window_min" margin="0,2,0,2"/>
                <Box height="stretch" width="40" margin="0,2,0,2">
                    <Button class="btn_wnd_max_11" height="32" width="stretch" name="btn_window_max"/>
                    <Button class="btn_wnd_restore_11" height="32" width="stretch" name="btn_window_restore" visible="false"/>
                </Box>
                <Button class="btn_wnd_close_11" height="stretch" width="40" name="btn_window_close" margin="0,0,0,2"/>
            </HBox>
        </HBox>
        <!-- 标题栏区域结束 -->

        <!-- 显示区域 -->
        <VBox bkcolor="bg_window_main" padding="10,10,10,10" width="stretch" height="stretch">
            <HBox height="stretch">
                <!-- 左侧区域：控件演示面板 -->
                <VScrollBox class="panel_card" name="left_panel" width="360" height="stretch" min_width="60" vscrollbar="true" padding="4,4,4,4">
                    <GroupVBox margin="2,2,2,6" text_id="STRID_RICHEDIT_PASSWORD_FUNC" height="auto" corner_size="4,4">
                        <HBox height="36" margin="8,14,8,0">
                            <Label text_id="STRID_RICHEDIT_PASSWORD_INPUT" width="130" text_align="right,vcenter" valign="center"/>
                            <RichEdit class="simple simple_border" text="This is password!" password="true" valign="center" text_align="vcenter" margin="8,6,4,4"/>
                        </HBox>
                        <HBox height="36" margin="8,0,8,0">
                            <Label text_id="STRID_RICHEDIT_SHOW_PASSWORD" width="130" text_align="right,vcenter" valign="center"/>
                            <RichEdit class="simple" text="This is password!" password="true" show_password="true" valign="center" text_align="vcenter" margin="8,6,4,4"/>
                        </HBox>
                        <HBox height="36" margin="8,0,8,0">
                            <Label text_id="STRID_RICHEDIT_FLASH_PASSWORD_CHAR" width="130" text_align="right,vcenter" valign="center"/>
                            <RichEdit class="simple" text="This is password!" password="true" flash_password_char="true" show_password="false" valign="center" text_align="vcenter" margin="8,6,4,4"/>
                        </HBox>
                        <HBox height="36" margin="8,0,8,8">
                            <Label text_id="STRID_RICHEDIT_PASSWORD_CHAR_HASH" width="130" text_align="right,vcenter" valign="center"/>
                            <RichEdit class="simple" text="This is password!" password="true" password_char="#" valign="center" text_align="vcenter" margin="8,6,4,4"/>
                        </HBox>
                    </GroupVBox>
                    <GroupVBox margin="2,2,2,6" text_id="STRID_RICHEDIT_BASIC_FUNC" height="auto" corner_size="4,4">
                        <HBox height="36" margin="8,14,8,0">
                            <Label text_id="STRID_RICHEDIT_SINGLE_LINE_EDIT" width="130" text_align="right,vcenter" valign="center"/>
                            <RichEdit class="simple simple_border" text="RichEdit: simple" default_context_menu="true" valign="center" text_align="vcenter" text_padding="2,0,0,0" margin="8,6,4,4"/>
                        </HBox>
                        <HBox height="44" margin="8,0,8,0">
                            <Label text_id="STRID_RICHEDIT_SINGLE_LINE_EDIT" width="130" text_align="right,vcenter" valign="center"/>
                            <RichEdit class="simple simple_border" text="RichEdit: edit" valign="center" text_align="vcenter" text_padding="4,4,4,4" margin="8,6,4,4"/>
                        </HBox>
                        <HBox height="36" margin="8,0,8,0">
                            <Label text_id="STRID_RICHEDIT_PROMPT_MODE" width="130" text_align="right,vcenter" valign="center"/>
                            <RichEdit class="prompt simple simple_border_bottom" prompt_text_id="STRID_RICHEDIT_INPUT_TEXT_HERE" valign="center" text_align="vcenter" margin="8,6,4,4"/>
                        </HBox>
                        <HBox height="36" margin="8,0,8,0">
                            <Label text_id="STRID_RICHEDIT_NUMBER_MODE" width="130" text_align="right,vcenter" valign="center"/>
                            <RichEdit class="simple simple_border" text="0123456789" number="true" valign="center" text_align="vcenter" margin="8,6,4,4"/>
                        </HBox>
                        <HBox height="36" margin="8,0,8,0">
                            <Label text_id="STRID_RICHEDIT_READONLY_MODE" width="130" text_align="right,vcenter" valign="center"/>
                            <RichEdit class="simple simple_border" text="RichEdit: readonly" readonly="true" no_caret_readonly="true" valign="center" text_align="vcenter" margin="8,6,4,4"/>
                        </HBox>
                        <HBox height="36" margin="8,0,8,0">
                            <Label text_id="STRID_RICHEDIT_DISABLE_MODE" width="130" text_align="right,vcenter" valign="center"/>
                            <RichEdit class="simple simple_border" enabled="false" text="RichEdit: disabled" valign="center" text_align="vcenter" margin="8,6,4,4"/>
                        </HBox>
                        <HBox height="36" margin="8,0,8,0">
                            <Label text_id="STRID_RICHEDIT_HYPERLINK" width="130" text_align="right,vcenter" valign="center"/>
                            <RichEdit name="test_url" auto_detect_url="true" text="URL: http://www.baidu.com" readonly="true" no_caret_readonly="true" valign="center" text_align="vcenter" text_padding="2,0,0,0" margin="8,6,4,4"/>
                        </HBox>
                        <HBox height="36" margin="8,0,8,0">
                            <Label text_id="STRID_RICHEDIT_TEXT_COLOR" width="130" text_align="right,vcenter" valign="center"/>
                            <RichEdit class="simple simple_border" text="RichEdit: Red Text" normal_text_color="red" valign="center" text_align="vcenter" margin="8,6,4,4"/>
                        </HBox>
                        <HBox height="36" margin="8,0,8,0">
                            <Label text_id="STRID_RICHEDIT_CARET_COLOR" width="130" text_align="right,vcenter" valign="center"/>
                            <RichEdit class="simple simple_border" text="RichEdit: Red caret" caret_color="red" valign="center" text_align="vcenter" margin="8,6,4,4"/>
                        </HBox>
                        <HBox height="48" margin="8,0,8,0">
                            <Label text_id="STRID_RICHEDIT_TEXT_ALIGN" width="130" text_align="right,vcenter" valign="center"/>
                            <RichEdit class="simple simple_border" text="text_align={left/hcenter/right,top/vcenter/bottom}" valign="center" text_align="vcenter" margin="8,6,4,4"/>
                        </HBox>
                        <HBox height="36" margin="8,0,8,8">
                            <Label text_id="STRID_RICHEDIT_MAX_CHAR_8" width="130" text_align="right,vcenter" valign="center"/>
                            <RichEdit class="simple simple_border" text="Max ch 8" max_char="8" valign="center" text_align="vcenter" margin="8,6,4,4"/>
                        </HBox>
                    </GroupVBox>

                    <GroupVBox margin="2,2,2,6" text_id="STRID_RICHEDIT_COMMON_FUNC" height="auto" corner_size="4,4">
                        <HBox height="36" margin="8,14,8,0">
                            <Label text_id="STRID_RICHEDIT_SPIN_FUNC" width="130" text_align="right,vcenter" valign="center"/>
                            <RichEdit class="simple simple_border rich_edit_spin" min_number="-64" max_number="64" limit_text="3" margin="8,6,4,4"/>
                            <Label text_id="STRID_RICHEDIT_NUMBER_RANGE_64" valign="center" margin="6,0,4,0"/>
                        </HBox>
                        <HBox height="36" margin="8,0,8,0">
                            <Label text_id="STRID_RICHEDIT_SPINBOX_STEP" width="130" text_align="right,vcenter" valign="center"/>
                            <SpinBox class="simple simple_border rich_edit_spin" min_number="0" max_number="100" step="5" value="50" margin="8,6,4,4"/>
                            <Label text_id="STRID_RICHEDIT_SPINBOX_STEP_DESC" valign="center" margin="6,0,4,0"/>
                        </HBox>
                        <HBox height="36" margin="8,0,8,0">
                            <Label text_id="STRID_RICHEDIT_SPINBOX_DECIMAL" width="130" text_align="right,vcenter" valign="center"/>
                            <SpinBox class="simple simple_border rich_edit_spin" min_number="-10000" max_number="10000" step="0.25" decimals="2" value="1234.5" group_separator="," prefix="$ " suffix=" kg" width="128" margin="8,6,4,4"/>
                            <Label text_id="STRID_RICHEDIT_SPINBOX_DECIMAL_DESC" valign="center" margin="6,0,4,0"/>
                        </HBox>
                        <HBox height="40" margin="8,0,8,0">
                            <Label text_id="STRID_RICHEDIT_SEARCH_BOX" width="130" text_align="right,vcenter" valign="center"/>
                            <SearchBox class="search_box" prompt_text_id="STRID_RICHEDIT_SEARCH_PROMPT" margin="8,6,4,4"/>
                        </HBox>
                        <HBox height="36" margin="8,0,8,0">
                            <Label text_id="STRID_RICHEDIT_CLEAR_TEXT" width="130" text_align="right,vcenter" valign="center"/>
                            <RichEdit class="simple simple_border rich_edit_clear_btn" margin="8,6,4,4"/>
                        </HBox>
                        <HBox height="36" margin="8,0,8,8">
                            <Label text_id="STRID_RICHEDIT_SHOW_PASSWORD" width="130" text_align="right,vcenter" valign="center"/>
                            <RichEdit class="simple simple_border rich_edit_show_password_btn" margin="8,6,4,4"/>
                        </HBox>
                    </GroupVBox>

                    <GroupVBox margin="2,2,2,6" text_id="STRID_RICHEDIT_SCROLLBAR_FUNC" height="auto" corner_size="4,4">
                        <HBox height="48" margin="8,14,8,0">
                            <Label text_id="STRID_RICHEDIT_HORIZONTAL_SCROLLBAR" width="130" text_align="right,vcenter" valign="center"/>
                            <RichEdit class="simple_border" text="0123456789abcdefghigklmn" multi_line="true" word_wrap="false" hscrollbar="true" margin="8,6,4,4"/>
                        </HBox>
                        <HBox height="48" margin="8,0,8,0">
                            <Label text_id="STRID_RICHEDIT_VERTICAL_SCROLLBAR" width="130" text_align="right,vcenter" valign="center"/>
                            <RichEdit class="simple_border" text="0123456789abcdefghigklmn0123456789abcdefghigklmn0123456789abcdefghigklmn0123456789abcdefghigklmn" multi_line="true" want_return="true" word_wrap="true" vscrollbar="true" margin="8,6,4,4"/>
                        </HBox>
                        <HBox height="48" margin="8,0,8,8">
                            <Label text_id="STRID_RICHEDIT_HORIZONTAL_VERTICAL_SCROLLBAR" width="130" text_align="right,vcenter" valign="center"/>
                            <RichEdit class="simple_border" text="0123456789abcdefghigklmn0123456789abcdefghigklmn0123456789abcdefghigklmn0123456789abcdefghigklmn" multi_line="true" want_return="true" word_wrap="false" vscrollbar="true" hscrollbar="true" margin="8,6,4,4"/>
                        </HBox>
                    </GroupVBox>
                </VScrollBox>

                <!-- 纵向分割条，用于调整左右区域大小 -->
                <Split class="split_vertical"/>

                <!-- 右侧区域：工具栏、编辑区与状态栏 -->
                <VBox width="stretch" height="stretch">
                    <!-- 工具栏 -->
                    <VBox class="panel_card" height="auto" padding="8,6,8,6">
                        <HBox height="auto" margin="0,0,0,4">
                            <Label text_id="STRID_RICHEDIT_FILE" width="56" text_align="right,vcenter" valign="center" font="system_bold_12" margin="0,0,10,0"/>
                            <Button class="btn_global" name="new_file" width="auto" height="28" padding="8,0,8,0" font="system_regular_12" text_id="STRID_RICHEDIT_NEW_FILE" border_round="4,4" valign="center" margin="0,0,6,0" tooltip_text_id="STRID_RICHEDIT_NEW_FILE"/>
                            <Button class="btn_global" name="open_file" width="auto" height="28" padding="8,0,8,0" font="system_regular_12" text_id="STRID_RICHEDIT_OPEN_FILE" border_round="4,4" valign="center" margin="0,0,6,0" tooltip_text_id="STRID_RICHEDIT_OPEN_FILE"/>
                            <Button class="btn_global" name="save_file" width="auto" height="28" padding="8,0,8,0" font="system_regular_12" text_id="STRID_RICHEDIT_SAVE_FILE" border_round="4,4" valign="center" margin="0,0,6,0" tooltip_text_id="STRID_RICHEDIT_SAVE_FILE"/>
                            <Button class="btn_global" name="save_as_file" width="auto" height="28" padding="8,0,8,0" font="system_regular_12" text_id="STRID_RICHEDIT_SAVE_AS_FILE" border_round="4,4" valign="center" tooltip_text_id="STRID_RICHEDIT_SAVE_AS_FILE"/>
                        </HBox>
                        <HBox height="auto" margin="0,0,0,4">
                            <Label text_id="STRID_RICHEDIT_EDIT" width="56" text_align="right,vcenter" valign="center" font="system_bold_12" margin="0,0,10,0"/>
                            <Button class="btn_global" name="btn_copy" width="auto" height="28" padding="8,0,8,0" font="system_regular_12" text_id="STRID_RICHEDIT_COPY" border_round="4,4" valign="center" margin="0,0,6,0"/>
                            <Button class="btn_global" name="btn_cut" width="auto" height="28" padding="8,0,8,0" font="system_regular_12" text_id="STRID_RICHEDIT_CUT" border_round="4,4" valign="center" margin="0,0,6,0"/>
                            <Button class="btn_global" name="btn_paste" width="auto" height="28" padding="8,0,8,0" font="system_regular_12" text_id="STRID_RICHEDIT_PASTE" border_round="4,4" valign="center" margin="0,0,6,0"/>
                            <Button class="btn_global" name="btn_delete" width="auto" height="28" padding="8,0,8,0" font="system_regular_12" text_id="STRID_RICHEDIT_DELETE" border_round="4,4" valign="center"/>
                        </HBox>
                        <HBox height="auto" margin="0,0,0,4">
                            <Control width="56" margin="0,0,10,0"/>
                            <Button class="btn_global" name="btn_sel_all" width="auto" height="28" padding="8,0,8,0" font="system_regular_12" text_id="STRID_RICHEDIT_SELECT_ALL" border_round="4,4" valign="center" margin="0,0,6,0"/>
                            <Button class="btn_global" name="btn_sel_none" width="auto" height="28" padding="8,0,8,0" font="system_regular_12" text_id="STRID_RICHEDIT_DESELECT" border_round="4,4" valign="center" margin="0,0,6,0"/>
                            <Button class="btn_global" name="btn_undo" width="auto" height="28" padding="8,0,8,0" font="system_regular_12" text_id="STRID_RICHEDIT_UNDO" border_round="4,4" valign="center" margin="0,0,6,0"/>
                            <Button class="btn_global" name="btn_redo" width="auto" height="28" padding="8,0,8,0" font="system_regular_12" text_id="STRID_RICHEDIT_REDO" border_round="4,4" valign="center"/>
                        </HBox>
                        <HBox height="auto" margin="0,0,0,4">
                            <Label text_id="STRID_RICHEDIT_FIND" width="56" text_align="right,vcenter" valign="center" font="system_bold_12" margin="0,0,10,0"/>
                            <Button class="btn_global" name="btn_find_text" width="auto" height="28" padding="8,0,8,0" font="system_regular_12" text_id="STRID_RICHEDIT_FIND_TEXT" border_round="4,4" valign="center" margin="0,0,6,0"/>
                            <Button class="btn_global" name="btn_find_next" width="auto" height="28" padding="8,0,8,0" font="system_regular_12" text_id="STRID_RICHEDIT_FIND_NEXT_TEXT" border_round="4,4" valign="center" margin="0,0,6,0"/>
                            <Button class="btn_global" name="btn_replace_text" width="auto" height="28" padding="8,0,8,0" font="system_regular_12" text_id="STRID_RICHEDIT_REPLACE_TEXT" border_round="4,4" valign="center"/>
                        </HBox>
                        <HBox height="auto" margin="0,0,0,4">
                            <Label text_id="STRID_RICHEDIT_FONT" width="56" text_align="right,vcenter" valign="center" font="system_bold_12" margin="0,0,10,0"/>
                            <Button class="btn_global" name="set_font" width="auto" height="28" padding="8,0,8,0" font="system_regular_12" text_id="STRID_RICHEDIT_SET_FONT" border_round="4,4" valign="center" margin="0,0,4,0"/>
                            <Combo class="combo" name="combo_font_name" combo_icon_class="" combo_type="drop_down" dropbox_size="0,300" height="28" width="140" tooltip_text_id="STRID_RICHEDIT_SELECT_FONT" margin="2,0,2,0"/>
                            <Combo class="combo" name="combo_font_size" combo_icon_class="" combo_type="drop_down" dropbox_size="0,300" height="28" width="56" margin="2,0,2,0" tooltip_text_id="STRID_RICHEDIT_SELECT_FONT"/>
                            <CheckBox class="checkbox_font_class" name="btn_font_bold" width="24" height="24" text="B" font="system_bold_14" valign="center" margin="2,2,1,2" tooltip_text_id="STRID_RICHEDIT_FONT_BOLD"/>
                            <CheckBox class="checkbox_font_class" name="btn_font_italic" width="24" height="24" text="I" font="system_italic_14" valign="center" margin="1,2,1,2" tooltip_text_id="STRID_RICHEDIT_FONT_ITALIC"/>
                            <CheckBox class="checkbox_font_class" name="btn_font_underline" width="24" height="24" text="U" font="system_underline_14" valign="center" margin="1,2,1,2" tooltip_text_id="STRID_RICHEDIT_FONT_UNDERLINE"/>
                            <CheckBox class="checkbox_font_class" name="btn_font_strikeout" width="30" height="24" text="abc" font="system_strikeout_14" valign="center" margin="1,2,1,2" tooltip_text_id="STRID_RICHEDIT_FONT_STRIKEOUT"/>
                            <Button class="btn_font_class" name="btn_font_size_increase" width="28" height="24" text="A+" font="system_bold_14" valign="center" margin="1,2,1,2" tooltip_text_id="STRID_RICHEDIT_INCREASE_FONT_SIZE"/>
                            <Button class="btn_font_class" name="btn_font_size_decrease" width="28" height="24" text="A-" font="system_bold_14" valign="center" margin="1,2,1,2" tooltip_text_id="STRID_RICHEDIT_DECREASE_FONT_SIZE"/>
                            <ComboButton class="combo_button" name="color_combo_button" height="28" width="40" dropbox_size="240,300" left_button_top_label_text="A" left_button_bottom_label_bkcolor="text_default" tooltip_text_id="STRID_RICHEDIT_RICH_TEXT_FORMAT_TIPS_DETAIL"/>
                        </HBox>
                        <HBox height="auto" margin="0,0,0,4">
                            <Label text_id="STRID_RICHEDIT_ZOOM" width="56" text_align="right,vcenter" valign="center" font="system_bold_12" margin="0,0,10,0"/>
                            <Label text_id="STRID_RICHEDIT_CURRENT_ZOOM_RATIO" font="system_regular_12" valign="center"/>
                            <Label name="lavel_zoom_value" text_id="STRID_RICHEDIT_ZOOM_100_PERCENT" font="system_bold_12" valign="center" margin="0,0,10,0"/>
                            <Combo class="combo" name="combo_zoom" combo_type="drop_down" dropbox_size="120,240" height="28" width="88" margin="2,0,2,0" tooltip_text_id="STRID_RICHEDIT_ZOOM_SELECT_TIPS"/>
                        </HBox>
                        <HBox height="auto">
                            <Label text_id="STRID_RICHEDIT_OTHER" width="56" text_align="right,vcenter" valign="center" font="system_bold_12" margin="0,0,10,0"/>
                            <CheckBox class="checkbox_1" name="btn_word_wrap" text_id="STRID_RICHEDIT_AUTO_WRAP" font="system_regular_12" margin="0,0,0,0" selected="true" tooltip_text_id="STRID_RICHEDIT_AUTO_WRAP_TIPS"/>
                            <CheckBox class="checkbox_1" name="btn_rich_text" text_id="STRID_RICHEDIT_RICH_TEXT_MODE" font="system_regular_12" margin="10,0,0,0" selected="true" tooltip_text_id="STRID_RICHEDIT_RICH_TEXT_MODE_TIPS"/>
                            <Label name="line_spacing_label" text_id="STRID_RICHEDIT_LINE_SPACING" font="system_regular_12" valign="center" margin="12,0,0,0" tooltip_text_id="STRID_RICHEDIT_LINE_SPACING_RICH_TEXT_ONLY"/>
                            <Option class="option_1" name="row_spacing_1_0" group="richedit_row_spacing_group" text="1.0" margin="4,0,0,0" text_align="vcenter" selected="true">
                                <Event type="select" receiver="rich_edit" apply_attribute="row_spacing_mul='1.0'" />
                            </Option>
                            <Option class="option_1" name="row_spacing_1_15" group="richedit_row_spacing_group" text="1.15" margin="4,0,0,0" text_align="vcenter">
                                <Event type="select" receiver="rich_edit" apply_attribute="row_spacing_mul='1.15'" />
                            </Option>
                            <Option class="option_1" name="row_spacing_1_5" group="richedit_row_spacing_group" text="1.5" margin="4,0,0,0" text_align="vcenter">
                                <Event type="select" receiver="rich_edit" apply_attribute="row_spacing_mul='1.5'" />
                            </Option>
                            <Option class="option_1" name="row_spacing_2_0" group="richedit_row_spacing_group" text="2.0" margin="4,0,0,0" text_align="vcenter">
                                <Event type="select" receiver="rich_edit" apply_attribute="row_spacing_mul='2.0'" />
                            </Option>
                            <Option class="option_1" name="row_spacing_2_5" group="richedit_row_spacing_group" text="2.5" margin="4,0,0,0" text_align="vcenter">
                                <Event type="select" receiver="rich_edit" apply_attribute="row_spacing_mul='2.5'" />
                            </Option>
