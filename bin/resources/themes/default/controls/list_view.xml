<?xml version="1.0" encoding="UTF-8"?>
<Window size="980,740" min_size="760,540" caption="0,0,0,40" shadow_type="default" size_box="2,2,2,2"
        icon="public/caption/logo.ico">
    <VBox bkcolor="bg_window_main">
        <HBox name="window_title_bar" width="stretch" height="40" bkcolor="bg_titlebar">
            <HBox margin="0,0,30,0" valign="center" width="auto" height="auto" mouse_enabled="false">
                <Control width="18" height="18" bkimage="public/caption/logo.svg" valign="center" margin="10,0,0,0"/>
                <Label text_id="STRID_LISTVIEW_WINDOW_TITLE" font="system_bold_14" valign="center" margin="8,0,0,0" mouse_enabled="false"/>
            </HBox>
            <Control mouse_enabled="false"/>
            <HBox margin="0,0,0,0" valign="center" width="auto" height="36">
                <Button class="btn_switch_theme" height="32" width="40" name="btn_window_theme" margin="0,2,0,2"/>
                <Button class="btn_switch_lang" height="32" width="40" name="btn_window_language" margin="0,2,0,2"/>
                <Button class="btn_wnd_close_11" height="stretch" width="40" name="btn_window_close" margin="0,0,0,2"/>
            </HBox>
        </HBox>

        <VScrollBox width="stretch" height="stretch" vscrollbar="true" hscrollbar="false" padding="16,12,16,16">
            <VBox width="stretch" height="auto">
                <Label text_id="STRID_LISTVIEW_DESC"
                       font="system_regular_12" text_color="text_muted" margin="4,0,4,10"
                       multi_line="true" auto_tooltip="true"/>

                <HBox height="30" margin="4,4,4,8" valign="center">
                    <Control width="4" height="16" bkcolor="color_blue_light" border_round="2,2" valign="center"/>
                    <Label text_id="STRID_LISTVIEW_VLIST" font="system_bold_15" text_color="text_default"
                           margin="8,0,0,0" valign="center"/>
                    <Control/>
                </HBox>
                <VBox bkcolor="bg_window_card" border_size="1" bordercolor="border_window" border_round="10,10"
                      padding="12,12,12,12" height="auto">
                    <VListBox class="list" name="list_v" height="200" padding="5,3,5,3">
                        <ListBoxItem class="list_item" height="24" text="ListBoxItem 0"/>
                        <ListBoxItem class="list_item" height="24" text="ListBoxItem 1"/>
                        <ListBoxItem class="list_item" height="24" text="ListBoxItem 2"/>
                        <ListBoxItem class="list_item" height="24" text="ListBoxItem 3"/>
                    </VListBox>
                </VBox>

                <HBox height="30" margin="4,18,4,8" valign="center">
                    <Control width="4" height="16" bkcolor="color_blue_light" border_round="2,2" valign="center"/>
                    <Label text_id="STRID_LISTVIEW_HLIST" font="system_bold_15" text_color="text_default"
                           margin="8,0,0,0" valign="center"/>
                    <Control/>
                </HBox>
                <HBox height="140" child_margin="10">
                    <VBox bkcolor="bg_window_card" border_size="1" bordercolor="border_window" border_round="10,10"
                          padding="12,12,12,12" height="stretch" width="50%">
                        <Label text="HListBox" font="system_regular_12" text_color="text_muted"/>
                        <HListBox class="list" name="list_h" height="80" margin="0,8,0,0" padding="5,3,5,3">
                            <ListBoxItem class="list_item" width="110" text="Horizontal 0"/>
                            <ListBoxItem class="list_item" width="110" text="Horizontal 1"/>
                            <ListBoxItem class="list_item" width="110" text="Horizontal 2"/>
                            <ListBoxItem class="list_item" width="110" text="Horizontal 3"/>
                        </HListBox>
                    </VBox>
                    <VBox bkcolor="bg_window_card" border_size="1" bordercolor="border_window" border_round="10,10"
                          padding="12,12,12,12" height="stretch" width="50%">
                        <Label text_id="STRID_LISTVIEW_LISTBOX_DEFAULT" font="system_regular_12" text_color="text_muted"/>
                        <HListBox class="list" name="list_base" height="80" margin="0,8,0,0" padding="5,3,5,3">
                            <ListBoxItem class="list_item" width="110" text="Base 0"/>
                            <ListBoxItem class="list_item" width="110" text="Base 1"/>
                        </HListBox>
                    </VBox>
                </HBox>

                <HBox height="30" margin="4,18,4,8" valign="center">
                    <Control width="4" height="16" bkcolor="color_blue_light" border_round="2,2" valign="center"/>
                    <Label text_id="STRID_LISTVIEW_TREE" font="system_bold_15" text_color="text_default"
                           margin="8,0,0,0" valign="center"/>
                    <Control/>
                </HBox>
                <VBox bkcolor="bg_window_card" border_size="1" bordercolor="border_window" border_round="10,10"
                      padding="12,12,12,12" height="auto">
                    <TreeView class="list" name="tree_view" height="200" padding="5,3,5,3" indent="18">
                        <TreeNode class="list_item" height="24" text="Root Node">
                            <TreeNode class="list_item" height="24" text="Child A"/>
                            <TreeNode class="list_item" height="24" text="Child B">
                                <TreeNode class="list_item" height="24" text="Grandchild B-1"/>
                                <TreeNode class="list_item" height="24" text="Grandchild B-2"/>
                            </TreeNode>
                        </TreeNode>
                        <TreeNode class="list_item" height="24" text="Root Node 2"/>
                    </TreeView>
                </VBox>

                <HBox height="30" margin="4,18,4,8" valign="center">
                    <Control width="4" height="16" bkcolor="color_accent" border_round="2,2" valign="center"/>
                    <Label text_id="STRID_LISTVIEW_EVENT" font="system_bold_15" text_color="text_default" margin="8,0,0,0" valign="center"/>
                    <Control/>
                </HBox>
                <VBox bkcolor="bg_window_card" border_size="1" bordercolor="border_window" border_round="10,10"
                      padding="16,14,16,14" height="auto">
                    <Label name="list_event_label" text_id="STRID_LISTVIEW_EVENT_DEFAULT" font="system_regular_14"
                           text_color="text_default" multi_line="true" auto_tooltip="true"/>
                </VBox>
            </VBox>
        </VScrollBox>
    </VBox>
</Window>
