<?xml version="1.0" encoding="UTF-8"?>
<Window size="960,760" min_size="760,560" caption="0,0,0,40" shadow_type="default" size_box="2,2,2,2"
        icon="public/caption/logo.ico">
    <VBox bkcolor="bg_window_main">
        <HBox name="window_title_bar" width="stretch" height="40" bkcolor="bg_titlebar">
            <HBox margin="0,0,30,0" valign="center" width="auto" height="auto" mouse_enabled="false">
                <Control width="18" height="18" bkimage="public/caption/logo.svg" valign="center" margin="10,0,0,0"/>
                <Label text="RichEdit 文本输入" font="system_bold_14" valign="center" margin="8,0,0,0" mouse_enabled="false"/>
            </HBox>
            <Control mouse_enabled="false"/>
            <HBox margin="0,0,0,0" valign="center" width="auto" height="36">
                <Button class="btn_switch_theme" height="32" width="40" name="btn_window_theme" margin="0,2,0,2"/>
                <Button class="btn_switch_lang" height="32" width="40" name="btn_window_language" margin="0,2,0,2"/>
                <Button class="btn_wnd_close_11" height="stretch" width="40" name="btn_window_close" margin="0,0,0,2"/>
            </HBox>
        </HBox>

        <VScrollBox width="stretch" height="stretch" vscrollbar="true" hscrollbar="false" padding="16,12,16,16">
            <VBox width="stretch" height="auto">
                <Label text="演示单行/多行编辑、滚动条样式、占位提示、数字 Spin、密码模式与右键菜单；支持将 txt/md 文件拖入编辑框。"
                       font="system_regular_12" text_color="text_muted" margin="4,0,4,10"
                       multi_line="true" auto_tooltip="true"/>

                <HBox height="30" margin="4,4,4,8" valign="center">
                    <Control width="4" height="16" bkcolor="color_success" border_round="2,2" valign="center"/>
                    <Label text="单行输入" font="system_bold_15" text_color="text_default" margin="8,0,0,0" valign="center"/>
                    <Control/>
                </HBox>
                <VBox bkcolor="bg_window_card" border_size="1" bordercolor="border_window" border_round="10,10"
                      padding="16,14,16,14" height="auto">
                    <Label text="普通单行 + 占位提示 + 清除按钮" font="system_regular_12" text_color="text_muted"/>
                    <RichEdit class="simple simple_border rich_edit_clear_btn" name="rich_edit_single" height="32"
                              margin="0,8,0,0" text_align="vcenter" text_padding="8,4,8,4"
                              prompt_text="请输入内容，支持一键清除"/>
                    <Label text="数字 Spin（范围 -64 ~ 64）" font="system_regular_12" text_color="text_muted" margin="0,12,0,0"/>
                    <RichEdit class="simple simple_border rich_edit_spin" name="rich_edit_spin" height="30"
                              margin="0,8,0,0" min_number="-64" max_number="64" limit_text="3" text="0"/>
                    <Label text="密码模式（点击眼睛图标切换显示）" font="system_regular_12" text_color="text_muted" margin="0,12,0,0"/>
                    <RichEdit class="simple simple_border rich_edit_show_password_btn" name="rich_edit_password" height="32"
                              margin="0,8,0,0" text_align="vcenter" text_padding="8,4,8,4"
                              prompt_text="请输入密码"/>
                </VBox>

                <HBox height="30" margin="4,18,4,8" valign="center">
                    <Control width="4" height="16" bkcolor="color_success" border_round="2,2" valign="center"/>
                    <Label text="多行输入" font="system_bold_15" text_color="text_default" margin="8,0,0,0" valign="center"/>
                    <Control/>
                </HBox>
                <HBox height="280" child_margin="10">
                    <VBox bkcolor="bg_window_card" border_size="1" bordercolor="border_window" border_round="10,10"
                          padding="16,14,16,14" height="stretch" width="50%">
                        <Label text="RichEdit（默认滚动条）" font="system_regular_12" text_color="text_muted"/>
                        <RichEdit class="simple simple_border" name="rich_edit_multi" text_align="left,top"
                                  text_padding="8,6,8,6" bkcolor="bg_richedit" height="stretch" margin="0,8,0,0"
                                  multi_line="true" auto_vscroll="true" vscrollbar="true" hscrollbar="false"
                                  scrollbar_float="false" want_return="true" want_tab="true" rich="false"
                                  default_context_menu="true" replace_newline="true"/>
                    </VBox>
                    <VBox bkcolor="bg_window_card" border_size="1" bordercolor="border_window" border_round="10,10"
                          padding="16,14,16,14" height="stretch" width="50%">
                        <Label text="RichEdit2（DirectWrite 渲染）" font="system_regular_12" text_color="text_muted"/>
                        <RichEdit2 class="simple simple_border" name="rich_edit2" text_align="left,top"
                                   text_padding="8,6,8,6" bkcolor="bg_richedit" height="stretch" margin="0,8,0,0"
                                   multi_line="true" auto_vscroll="true" vscrollbar="true" hscrollbar="false"
                                   vscrollbar_class="vscrollbar2" scrollbar_float="false"
                                   want_return="true" want_tab="true" default_context_menu="true"
                                   replace_newline="true"/>
                    </VBox>
                </HBox>

                <HBox height="30" margin="4,18,4,8" valign="center">
                    <Control width="4" height="16" bkcolor="color_accent" border_round="2,2" valign="center"/>
                    <Label text="事件回显" font="system_bold_15" text_color="text_default" margin="8,0,0,0" valign="center"/>
                    <Control/>
                </HBox>
                <VBox bkcolor="bg_window_card" border_size="1" bordercolor="border_window" border_round="10,10"
                      padding="16,14,16,14" height="auto">
                    <Label name="rich_edit_event_label" text="编辑任意输入框，这里会显示字符数。" font="system_regular_14"
                           text_color="text_default" multi_line="true" auto_tooltip="true"/>
                </VBox>
            </VBox>
        </VScrollBox>
    </VBox>
</Window>
