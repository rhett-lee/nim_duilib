<?xml version="1.0" encoding="UTF-8"?>
<Window size="1000,748" text="Progress Test" use_system_caption="false" caption="0,0,0,36" shadow_type="default" size_box="2,2,2,2">
    <VBox bkcolor="bg_window_main" height="stretch">
        <!-- 标题栏 -->
        <HBox name="window_title_bar" width="stretch" height="36" bkcolor="bg_titlebar">
            <Control width="18" height="18" bkimage="public/caption/logo.svg" valign="center" margin="8"/>
            <Label name="label_title" text_id="STRID_PROGRESS_WINDOW_TITLE" valign="center" margin="8" mouse_enabled="false"/>
            <Control/>
            <Button class="btn_wnd_close_11" height="stretch" width="40" name="btn_window_close" margin="0,0,0,2"/>
        </HBox>

        <!-- 控制区 -->
        <HBox height="44" padding="12,8,12,0">
            <Button class="btn_global" name="btn_progress_animate" text_id="STRID_PROGRESS_BTN_ANIMATE" width="90" height="28" border_round="3,3" margin="0,0,8,0"/>
            <Button class="btn_global" name="btn_progress_indet" text_id="STRID_PROGRESS_BTN_SPIN" width="90" height="28" border_round="3,3" margin="0,0,8,0"/>
            <Control/>
            <Label name="progress_event_text" text_id="STRID_PROGRESS_EVENT_NONE" text_color="text_muted" valign="center"/>
        </HBox>

        <!-- 演示区：内容较多，放进纵向滚动容器，窗口变矮时也不会被裁掉 -->
        <VScrollBox height="stretch" vscrollbar="true" hscrollbar="false" padding="12,8,12,12">
            <VBox height="auto" width="stretch">
            <HBox height="auto">                
                <VBox height="auto">
                    <!-- 水平进度条：图片前景 / 纯色圆角+百分比 / 浮点动画 / 滑块 / marquee -->
                    <VBox height="250" bkcolor="bg_window_card" border_size="1" bordercolor="border_window" border_round="4,4" padding="12,12,12,12" margin="0,0,0,10">
                        <Label text_id="STRID_PROGRESS_CARD_HORIZ" font="system_bold_15" text_color="text_default" valign="center" margin="0,0,0,8"/>
                        <Progress class="progress_horizontal_blue" name="progress11" reverse="false" height="6" width="stretch" min="0" max="100" value="0" margin="10,12,10,12" tooltip_text="ui::Progress (image foreground)"/>
                        <Progress progress_color="bg_progress" name="progress12" reverse="false" height="20" width="stretch" min="0" max="100" value="0" buffer_value="25" marquee="false" margin="10,12,10,12" bkcolor="bg_progress_track" progress_radius="10" show_percent="true" tooltip_text="ui::Progress (solid color + radius + show_percent + buffer)"/>
                        <Progress name="progress_float" progress_color="bg_progress" bkcolor="bg_progress_track" progress_radius="10" min="0" max="1" value="0.3" animation_enabled="true" animation_duration="600" show_percent="true" height="20" width="stretch" margin="10,12,10,12" tooltip_text="ui::Progress (float value + animation)"/>
                        <Slider class="slider_horizontal_blue" name="progress13" reverse="false" height="14" width="stretch" min="0" max="100" value="0" margin="10,12,10,12" tooltip_text="ui::Slider"/>
                        <Progress name="progress_marquee" progress_color="bg_progress" bkcolor="bg_progress_track" progress_radius="10" marquee="true" marquee_width="40" height="20" width="stretch" margin="10,12,10,12" tooltip_text="ui::Progress (marquee)"/>
                    </VBox>
                    <!-- 环形进度条 -->
                    <VBox height="auto" bkcolor="bg_window_card" border_size="1" bordercolor="border_window" border_round="4,4" padding="12,4,12,4" margin="0,0,0,0">
                        <Label text_id="STRID_PROGRESS_CARD_CIRCLE" font="system_bold_15" text_color="text_default" valign="center" margin="0,0,0,8"/>
                        <HBox height="auto">
                            <Control width="stretch"/>
                            <CircleProgress name="progress14" reverse="false" circular="true" height="120" width="120" valign="center"
                                            circle_width="12" bgcolor="bg_progress_track" fgcolor="bg_progress" gradient_color="color_accent" clockwise="true" min="0" max="100" value="0" margin="20,20,20,20"
                                            text_padding="10,44,10,10" normal_text_color="darkcolor" indicator="file='public/progress/indicator.svg' width='16' height='16'" tooltip_text="ui::CircleProgress (gradient + indicator)"/>
                            <CircleProgress name="progress24" reverse="false" circular="true" height="120" width="120" valign="center"
                                            circle_width="12" bgcolor="bg_progress_track" fgcolor="bg_progress" clockwise="false" min="0" max="100" value="0" margin="20,20,20,20"
                                            text_padding="10,44,10,10" normal_text_color="darkcolor" tooltip_text="ui::CircleProgress (counter-clockwise)"/>
                            <CircleProgress name="circle_indeterminate" circular="true" indeterminate="true" height="120" width="120" valign="center"
                                            circle_width="12" bgcolor="bg_progress_track" fgcolor="bg_progress" margin="20,20,20,20"
                                            tooltip_text="ui::CircleProgress (indeterminate)"/>
                            <Control width="stretch"/>
                        </HBox>
                    </VBox>
                </VBox>
                <!-- 垂直进度条 -->
                <VBox width="40%" bkcolor="bg_window_card" border_size="1" bordercolor="border_window" border_round="4,4" padding="12,12,12,12" margin="6,0,0,0">
                    <Label text_id="STRID_PROGRESS_CARD_VERT" font="system_bold_15" text_color="text_default" valign="center" margin="0,0,0,8"/>
                    <HBox height="stretch" margin="10,10,10,10">
                        <Control width="stretch"/>
                        <Progress class="progress_vertical_blue" name="progress21" reverse="false" height="stretch" width="6" min="0" max="100" value="0" horizontal="false" margin="20,20,20,20" tooltip_text="ui::Progress (image foreground)"/>
                        <Progress progress_color="bg_progress" name="progress22" reverse="false" height="stretch" width="14" min="0" max="100" value="0" horizontal="false" margin="20,20,20,20" bkcolor="bg_progress_track" progress_radius="7" tooltip_text="ui::Progress (solid color + radius)"/>
                        <Slider class="slider_vertical_blue" name="progress23" reverse="false" height="stretch" width="14" min="0" max="100" value="0" horizontal="false" margin="20,20,20,20" tooltip_text="ui::Slider"/>
                        <Control width="stretch"/>
                    </HBox>
                </VBox>
            </HBox>

        <!-- Slider 交互测试：键盘操作 / 刻度显示 / 点击轨道跳转 -->
        <VBox height="150" bkcolor="bg_window_card" border_size="1" bordercolor="border_window" border_round="4,4" padding="12,12,12,12" margin="0,0,0,10">
            <Label text_id="STRID_PROGRESS_CARD_SLIDER" font="system_bold_15" text_color="text_default" valign="center" margin="0,0,0,4"/>
            <HBox height="stretch">
                <!-- 键盘操作：方向键步进 step，PageUp/PageDown 与 Shift+方向键按 page_step 步进，Home/End 到端点 -->
                <VBox width="32%" height="stretch" margin="0,0,10,0">
                    <Label text_id="STRID_PROGRESS_SLIDER_KEYBOARD" text_color="text_muted" font="system_regular_13" valign="center" height="18" margin="0,0,0,2"/>
                    <Slider class="slider_horizontal_blue" name="slider_keyboard" height="20" width="stretch" min="0" max="100" value="50"
                            step="5" page_step="25" click_to_jump="true" margin="0,0,0,6" tooltip_text="keyboard: arrows / PageUp / PageDown / Home / End"/>
                    <Label name="slider_keyboard_text" text_id="STRID_PROGRESS_SLIDER_TIP_KEY" text_color="text_muted" font="system_regular_12" valign="top" height="stretch"/>
                </VBox>
                <!-- 刻度显示：刻度线 + 刻度值文本（每 2 格一个标签） -->
                <VBox width="34%" height="stretch" margin="0,0,10,0">
                    <Label text_id="STRID_PROGRESS_SLIDER_TICKS" text_color="text_muted" font="system_regular_13" valign="center" height="18" margin="0,0,0,2"/>
                    <Slider class="slider_horizontal_blue" name="slider_ticks" height="44" width="stretch" min="0" max="100" value="30"
                            step="1" show_ticks="true" tick_count="6" tick_length="6" tick_pos="bottom" tick_color="border_control_normal"
                            show_tick_labels="true" tick_label_interval="1" tick_font="system_regular_12" tick_label_color="text_muted" margin="0,0,0,4"
                            tooltip_text="ticks + tick labels"/>
                    <Label text_id="STRID_PROGRESS_SLIDER_TIP_TICKS" text_color="text_muted" font="system_regular_12" valign="top" height="stretch"/>
                </VBox>
                <!-- 点击轨道行为对照：上面 click_to_jump=true（按下即跳），下面 =false（松开才跳） -->
                <VBox width="34%" height="stretch">
                    <Label text_id="STRID_PROGRESS_SLIDER_CLICK" text_color="text_muted" font="system_regular_13" valign="center" height="18" margin="0,0,0,2"/>
                    <Slider class="slider_horizontal_blue" name="slider_click_jump" height="16" width="stretch" min="0" max="100" value="60"
                            step="1" click_to_jump="true" margin="0,0,0,4" tooltip_text="click_to_jump=true: jump on mouse down"/>
                    <Slider class="slider_horizontal_blue" name="slider_click_release" height="16" width="stretch" min="0" max="100" value="60"
                            step="1" click_to_jump="false" margin="0,0,0,4" tooltip_text="click_to_jump=false: jump on mouse up"/>
                    <Label name="slider_click_text" text_id="STRID_PROGRESS_SLIDER_TIP_CLICK" text_color="text_muted" font="system_regular_12" valign="top" height="stretch"/>
                </VBox>
            </HBox>
        </VBox>
        <!-- CircleProgress 形态扩展：仪表盘/缺口环 / 中心自定义内容 / indeterminate 参数化 -->
        <VBox height="200" bkcolor="bg_window_card" border_size="1" bordercolor="border_window" border_round="4,4" padding="12,12,12,12" margin="0,0,0,10">
            <Label text_id="STRID_PROGRESS_CARD_GAUGE" font="system_bold_15" text_color="text_default" valign="center" margin="0,0,0,4"/>
            <HBox height="stretch">
                <!-- 180° 半圆表盘（速度表）：起点 270°、跨度 180°，圆心自动下移让上半弧完整显示 -->
                <VBox width="25%" height="stretch" margin="0,0,10,0">
                    <Label text_id="STRID_PROGRESS_GAUGE_HALF" text_color="text_muted" font="system_regular_13" valign="center" height="18" margin="0,0,0,2"/>
                    <HBox height="stretch">
                        <Control width="stretch"/>
                        <CircleProgress name="gauge_half" circular="true" height="110" width="170" valign="bottom"
                                        circle_width="10" bgcolor="bg_progress_track" fgcolor="bg_progress" clockwise="true"
                                        start_angle="270" span_angle="180" min="0" max="240" value="0" show_percent="true"
                                        center_ratio="100" tooltip_text="gauge: span_angle=180"/>
                        <Control width="stretch"/>
                    </HBox>
                </VBox>
                <!-- 270° 缺口环：从 135° 起、缺口 90°，用于环形评分/完成度 -->
                <VBox width="25%" height="stretch" margin="0,0,10,0">
                    <Label text_id="STRID_PROGRESS_GAUGE_GAP" text_color="text_muted" font="system_regular_13" valign="center" height="18" margin="0,0,0,2"/>
                    <HBox height="stretch">
                        <Control width="stretch"/>
                        <CircleProgress name="gauge_gap" circular="true" height="140" width="140" valign="center"
                                        circle_width="12" bgcolor="bg_progress_track" fgcolor="bg_progress" gradient_color="color_accent" clockwise="true"
                                        start_angle="135" span_angle="270" min="0" max="100" value="0" show_percent="true"
                                        tooltip_text="gap ring: start_angle=135, span_angle=270"/>
                        <Control width="stretch"/>
                    </HBox>
                </VBox>
                <!-- 中心自定义内容：绘制指针图标/文字（SetCenterCallback） -->
                <VBox width="25%" height="stretch" margin="0,0,10,0">
                    <Label text_id="STRID_PROGRESS_GAUGE_CENTER" text_color="text_muted" font="system_regular_13" valign="center" height="18" margin="0,0,0,2"/>
                    <HBox height="stretch">
                        <Control width="stretch"/>
                        <CircleProgress name="gauge_center" circular="true" height="140" width="140" valign="center"
                                        circle_width="10" bgcolor="bg_progress_track" fgcolor="bg_progress" clockwise="true"
                                        start_angle="135" span_angle="270" min="0" max="100" value="0"
                                        center_ratio="70" center_padding="4,4,4,4" tooltip_text="center content via SetCenterCallback"/>
                        <Control width="stretch"/>
                    </HBox>
                </VBox>
                <!-- indeterminate 参数化：弧长 240°、转速 3°/帧、间隔 24ms（比默认更慢更醒目） -->
                <VBox width="25%" height="stretch">
                    <Label text_id="STRID_PROGRESS_GAUGE_INDET" text_color="text_muted" font="system_regular_13" valign="center" height="18" margin="0,0,0,2"/>
                    <HBox height="stretch">
                        <Control width="stretch"/>
                        <CircleProgress name="gauge_indeterminate" circular="true" indeterminate="true" height="140" width="140" valign="center"
                                        circle_width="10" bgcolor="bg_progress_track" fgcolor="bg_progress"
                                        start_angle="135" span_angle="270" indeterminate_arc="240" indeterminate_speed="3" indeterminate_interval="24"
                                        tooltip_text="indeterminate: arc=240, speed=3, interval=24"/>
                        <Control width="stretch"/>
                    </HBox>
                </VBox>
            </HBox>
        </VBox>
        <!-- 健壮性与一致性：min/max 钳位 / marquee 圆角 / 动画曲线可配 -->
        <VBox height="260" bkcolor="bg_window_card" border_size="1" bordercolor="border_window" border_round="4,4" padding="12,12,12,12" margin="0,0,0,0">
            <Label text_id="STRID_PROGRESS_CARD_ROBUST" font="system_bold_15" text_color="text_default" valign="center" margin="0,0,0,4"/>
            <HBox height="stretch">
                <!-- marquee 圆角：与上方 progress_marquee 同参数，验证已套用 progress_radius -->
                <VBox width="25%" height="stretch" margin="0,0,10,0">
                    <Label text_id="STRID_PROGRESS_ROBUST_MARQUEE" text_color="text_muted" font="system_regular_13" valign="center" height="18" margin="0,0,0,2"/>
                    <VBox height="stretch">
                        <Progress name="robust_marquee_round" progress_color="bg_progress" bkcolor="bg_progress_track"
                                 progress_radius="10" marquee="true" marquee_width="40" height="20" width="stretch"
                                 margin="0,0,0,8" tooltip_text="marquee + progress_radius=10 (now rounded)"/>
                        <Progress name="robust_marquee_square" progress_color="bg_progress" bkcolor="bg_progress_track"
                                 progress_radius="0" marquee="true" marquee_width="40" height="20" width="stretch"
                                 tooltip_text="marquee + progress_radius=0 (square, for comparison)"/>
                        <Label text_id="STRID_PROGRESS_ROBUST_TIP_MARQUEE" text_color="text_muted" font="system_regular_12" valign="top" height="stretch" margin="0,8,0,0"/>
                    </VBox>
                </VBox>
                <!-- 动画曲线可配：animation_easing，取值与 EasingFunctionType 枚举名一致 -->
                <VBox width="34%" height="stretch" margin="0,0,10,0">
                    <Label text_id="STRID_PROGRESS_ROBUST_EASING" text_color="text_muted" font="system_regular_13" valign="center" height="18" margin="0,0,0,2"/>
                    <VBox height="stretch">
                        <Progress name="robust_ease_linear" progress_color="bg_progress" bkcolor="bg_progress_track" progress_radius="6"
                                 min="0" max="100" value="70" height="18" width="stretch" margin="0,0,0,6"
                                 animation_enabled="true" animation_duration="600" animation_easing="EaseLinear"
                                 tooltip_text="animation_easing=&quot;EaseLinear&quot;"/>
                        <Progress name="robust_ease_out" progress_color="bg_progress" bkcolor="bg_progress_track" progress_radius="6"
                                 min="0" max="100" value="70" height="18" width="stretch" margin="0,0,0,6"
                                 animation_enabled="true" animation_duration="600" animation_easing="EaseOutQuad"
                                 tooltip_text="animation_easing=&quot;EaseOutQuad&quot; (default)"/>
                        <Progress name="robust_ease_elastic" progress_color="bg_progress" bkcolor="bg_progress_track" progress_radius="6"
                                 min="0" max="100" value="70" height="18" width="stretch" margin="0,0,0,6"
                                 animation_enabled="true" animation_duration="900" animation_easing="EaseOutElastic"
                                 tooltip_text="animation_easing=&quot;EaseOutElastic&quot;"/>
                        <Label text_id="STRID_PROGRESS_ROBUST_TIP_EASING" text_color="text_muted" font="system_regular_12" valign="top" height="stretch"/>
                    </VBox>
                </VBox>
                <!-- min/max 运行时钳位 + reverse 在 min≠0 时的比例正确性 -->
                <VBox width="34%" height="stretch">
                    <Label text_id="STRID_PROGRESS_ROBUST_CLAMP" text_color="text_muted" font="system_regular_13" valign="center" height="18" margin="0,0,0,2"/>
                    <VBox height="stretch">
                        <Progress name="robust_clamp" progress_color="bg_progress" bkcolor="bg_progress_track" progress_radius="6"
                                 min="0" max="100" value="80" height="18" width="stretch" margin="0,0,0,6"
                                 show_percent="true" tooltip_text="value=80, max will be set to 50 at runtime"/>
                        <HBox height="26">
                            <Button class="btn_global" name="btn_clamp_shrink" text_id="STRID_PROGRESS_ROBUST_BTN_SHRINK" width="stretch" height="26" border_round="3,3" margin="0,0,6,0"/>
                            <Button class="btn_global" name="btn_clamp_restore" text_id="STRID_PROGRESS_ROBUST_BTN_RESTORE" width="stretch" height="26" border_round="3,3"/>
                        </HBox>
                        <Label name="robust_clamp_text" text_id="STRID_PROGRESS_ROBUST_TIP_CLAMP" text_color="text_muted" font="system_regular_12" valign="center" height="14" margin="0,4,0,0"/>
                        <!-- reverse 对照：min=10（≠0）时比例仍应正确，上=value=min 满格 / 下=value=max 空 -->
                        <Label text_id="STRID_PROGRESS_ROBUST_REVERSE" text_color="text_muted" font="system_regular_12" valign="center" height="14" margin="0,2,0,2"/>
                        <Progress name="robust_reverse_min" progress_color="bg_progress" bkcolor="bg_progress_track" progress_radius="6"
                                 min="10" max="100" value="10" reverse="true" height="14" width="stretch" margin="0,0,0,2"
                                 tooltip_text="reverse + min=10, value=min (expect full)"/>
                        <Progress name="robust_reverse_max" progress_color="bg_progress" bkcolor="bg_progress_track" progress_radius="6"
                                 min="10" max="100" value="100" reverse="true" height="14" width="stretch" margin="0,0,0,2"
                                 tooltip_text="reverse + min=10, value=max (expect empty)"/>
                        <Label text_id="STRID_PROGRESS_ROBUST_TIP_REVERSE" text_color="text_muted" font="system_regular_12" valign="top" height="stretch" margin="0,2,0,0"/>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
            </VBox>
        </VScrollBox>
    </VBox>
</Window>
