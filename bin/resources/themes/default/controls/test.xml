<?xml version="1.0" encoding="UTF-8"?>
<Window size="800,640" use_system_caption="true">
    <VBox bkcolor="bg_window_main">
        <VBox>
            <HBox height="auto">
                <GroupHBox height="80" margin="6,6,6,6" text="MessageBox" corner_size="4,4">
                    <Button class="btn_global" text="MessageBox Test" name="message_box_btn" margin="20,30,0,0" width="160" height="30" border_round="3,3"/>
                </GroupHBox>
                <GroupHBox height="80" margin="6,6,6,6" text="Toast" corner_size="4,4">
                    <Button class="btn_global" text="Toast Test" name="toast_btn" margin="20,30,0,0" width="160" height="30" border_round="3,3"/>
                </GroupHBox>
                <!-- Flyout 浮层：4 个按钮分别从下/上/右/左弹出，均以自身为锚点 -->
                <GroupVBox height="80" width="auto" margin="6,6,6,6" text_id="STRID_FLYOUT_DEMO_GROUP" corner_size="4,4">
                    <HBox margin="8,28,8,8" height="28" width="auto">
                        <Button class="btn_global" text_id="STRID_FLYOUT_DEMO_BOTTOM" name="flyout_bottom" width="56" height="28" border_round="3,3"/>
                        <Button class="btn_global" text_id="STRID_FLYOUT_DEMO_TOP" name="flyout_top" width="56" height="28" border_round="3,3" margin="6,0,0,0"/>
                        <Button class="btn_global" text_id="STRID_FLYOUT_DEMO_LEFT" name="flyout_left" width="56" height="28" border_round="3,3" margin="6,0,0,0"/>
                        <Button class="btn_global" text_id="STRID_FLYOUT_DEMO_RIGHT" name="flyout_right" width="56" height="28" border_round="3,3" margin="6,0,0,0"/>
                    </HBox>
                </GroupVBox>                
            </HBox>
            <HBox height="auto">
                <!-- Calendar 演示：单选/范围 两个按钮 -->
                <GroupVBox height="80" width="auto" margin="6,6,6,6" text_id="STRID_CALENDAR_DEMO_GROUP" corner_size="4,4">
                    <HBox margin="8,28,8,8" height="28" width="auto">
                        <Button class="btn_global" text_id="STRID_CALENDAR_DEMO_SINGLE" name="calendar_single" width="56" height="28" border_round="3,3"/>
                        <Button class="btn_global" text_id="STRID_CALENDAR_DEMO_RANGE" name="calendar_range" width="56" height="28" border_round="3,3" margin="6,0,0,0"/>
                    </HBox>
                </GroupVBox>
                <!-- 进度条测试：独立窗口入口 -->
                <GroupHBox height="80" width="auto" margin="6,6,6,6" text="Progress" corner_size="4,4">
                    <Button class="btn_global" text="Progress Test" name="progress_btn" margin="20,30,20,0" width="140" height="30" border_round="3,3"/>
                </GroupHBox>
            </HBox>
            
            <!-- TabCtrl (Badge) -->
            <GroupHBox text_id="STRID_CONTROLS_TABCTRL" height="70" margin="6,6,6,6">
                <TabCtrl class="tab_ctrl" width="stretch" height="36" margin="12,24,12,10" selected_id="3" tooltip_text="ui::TabCtrl + ui::TabCtrlItem (badge)">
                    <TabCtrlItem class="tab_ctrl_item" title_id="STRID_CONTROLS_TAB_MSG" badge_count="5"/>
                    <TabCtrlItem class="tab_ctrl_item" title_id="STRID_CONTROLS_TAB_NOTIFY" badge_count="120"/>
                    <TabCtrlItem class="tab_ctrl_item" title_id="STRID_CONTROLS_TAB_FEED" badge_class="tab_ctrl_item_badge_dot" badge_dot="true"/>
                    <TabCtrlItem class="tab_ctrl_item" title_id="STRID_CONTROLS_TAB_SETTINGS"/>
                </TabCtrl>
            </GroupHBox>

            <!-- TagInput 标签输入框 -->
            <GroupVBox text_id="STRID_CONTROLS_TAG_INPUT" height="auto" margin="6,6,6,6" corner_size="4,4">
                <HBox height="auto" margin="8,28,8,8">
                    <TagInput class="tag_input" name="tag_input" tags="nim_duilib;C++;Desktop UI"
                              prompt_text_id="STRID_CONTROLS_TAG_INPUT_PROMPT"/>
                    <Button class="btn_global" name="btn_add_tag" text_id="STRID_CONTROLS_TAG_ADD" width="100" height="30" border_round="3,3" margin="8,2,0,2" valign="center"/>
                    <TagInput class="tag_input" name="tag_input2" delimiter="," width="240" margin="8,2,0,2"
                              prompt_text_id="STRID_CONTROLS_TAG_INPUT_PROMPT2"/>
                </HBox>
            </GroupVBox>

            <!-- AutoComplete 自动完成输入框 -->
            <GroupVBox text_id="STRID_CONTROLS_AUTO_COMPLETE" height="auto" margin="6,6,6,6" corner_size="4,4">
                <HBox height="auto" margin="8,28,8,8">
                    <AutoComplete class="auto_complete" name="auto_complete"
                                  items="Beijing;Berlin;Budapest;Bangkok;Boston;Brisbane;Chicago;London;Los Angeles;New York;Paris;Seattle;Shanghai;Shenzhen;Singapore;Sydney;Tokyo;Toronto"
                                  prompt_text_id="STRID_CONTROLS_AUTO_COMPLETE_PROMPT"/>
                    <AutoComplete class="auto_complete" name="auto_complete2" match_mode="contains" max_visible="6"
                                  width="260" margin="8,2,0,2"
                                  prompt_text_id="STRID_CONTROLS_AUTO_COMPLETE_PROMPT2"/>
                </HBox>
            </GroupVBox>

            <!-- 上下文菜单：一行代码为任意控件绑定右键菜单(Control::AttachPopupMenu) -->
            <GroupHBox text_id="STRID_CONTROLS_CONTEXT_MENU" height="70" margin="6,6,6,6" corner_size="4,4">
                <Button class="btn_global" name="context_menu_btn" text_id="STRID_CONTROLS_CONTEXT_MENU_HINT"
                        margin="20,24,20,10" width="220" height="30" border_round="3,3"/>
            </GroupHBox>
        </VBox>
    </VBox>
</Window>
