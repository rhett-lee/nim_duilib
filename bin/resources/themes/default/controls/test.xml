<?xml version="1.0" encoding="UTF-8"?>
<Window size="1000,780" min_size="780,540" caption="0,0,0,40" shadow_type="default" size_box="2,2,2,2"
        icon="public/caption/logo.ico">
    <VBox bkcolor="bg_window_main">
        <!-- 标题栏 -->
        <HBox name="window_title_bar" width="stretch" height="40" bkcolor="bg_titlebar">
            <HBox margin="0,0,30,0" valign="center" width="auto" height="auto" mouse_enabled="false">
                <Control width="18" height="18" bkimage="public/caption/logo.svg" valign="center" margin="10,0,0,0"/>
                <Label text_id="STRID_TEST_TITLE" font="system_bold_14" valign="center" margin="8,0,0,0" mouse_enabled="false"/>
            </HBox>
            <Control mouse_enabled="false"/>
            <HBox margin="0,0,0,0" valign="center" width="auto" height="36">
                <Button class="btn_switch_theme" height="32" width="40" name="btn_window_theme" margin="0,2,0,2"/>
                <Button class="btn_switch_lang" height="32" width="40" name="btn_window_language" margin="0,2,0,2"/>
                <Button class="btn_wnd_close_11" height="stretch" width="40" name="btn_window_close" margin="0,0,0,2"/>
            </HBox>
        </HBox>

        <VScrollBox width="stretch" height="stretch" vscrollbar="true" hscrollbar="false" padding="16,12,16,16">
            <VBox width="stretch" height="auto">
                <Label text_id="STRID_TEST_HINT" font="system_regular_12" text_color="text_muted"
                       margin="4,0,4,10" multi_line="true" auto_tooltip="true"/>

                <!-- 反馈与通知 -->
                <HBox height="30" margin="4,4,4,8" valign="center">
                    <Control width="4" height="16" bkcolor="color_warning" border_round="2,2" valign="center"/>
                    <Label text_id="STRID_TEST_SEC_FEEDBACK" font="system_bold_15" text_color="text_default"
                           margin="8,0,0,0" valign="center"/>
                    <Control/>
                </HBox>
                <VBox bkcolor="bg_window_card" border_size="1" bordercolor="border_window" border_round="10,10"
                      padding="16,14,16,14" height="auto">
                    <Label text_id="STRID_TEST_NOTIFY_DESC" font="system_regular_12" text_color="text_muted"
                           multi_line="true" auto_tooltip="true"/>
                    <HBox height="32" margin="0,10,0,0">
                        <Button class="btn_global" text="System Notification" name="system_notification_btn"
                                width="160" height="30" border_round="3,3"/>
                    </HBox>
                </VBox>

                <!-- 浮层与菜单 -->
                <HBox height="30" margin="4,18,4,8" valign="center">
                    <Control width="4" height="16" bkcolor="color_accent" border_round="2,2" valign="center"/>
                    <Label text_id="STRID_TEST_SEC_POPUP" font="system_bold_15" text_color="text_default"
                           margin="8,0,0,0" valign="center"/>
                    <Control/>
                </HBox>
                <HBox height="130" child_margin="10">
                    <VBox bkcolor="bg_window_card" border_size="1" bordercolor="border_window" border_round="10,10"
                          padding="16,14,16,14" height="stretch">
                        <Label text_id="STRID_FLYOUT_DEMO_GROUP" font="system_bold_14" text_color="text_default"/>
                        <Label text_id="STRID_TEST_FLYOUT_DESC" font="system_regular_12" text_color="text_muted"
                               margin="0,6,0,0" height="stretch" multi_line="true" auto_tooltip="true"/>
                        <HBox height="30" margin="0,6,0,0" child_margin="6">
                            <Button class="btn_global" text_id="STRID_FLYOUT_DEMO_BOTTOM" name="flyout_bottom" width="60" height="28" border_round="3,3"/>
                            <Button class="btn_global" text_id="STRID_FLYOUT_DEMO_TOP" name="flyout_top" width="60" height="28" border_round="3,3"/>
                            <Button class="btn_global" text_id="STRID_FLYOUT_DEMO_LEFT" name="flyout_left" width="60" height="28" border_round="3,3"/>
                            <Button class="btn_global" text_id="STRID_FLYOUT_DEMO_RIGHT" name="flyout_right" width="60" height="28" border_round="3,3"/>
                            <Control/>
                        </HBox>
                    </VBox>
                    <VBox bkcolor="bg_window_card" border_size="1" bordercolor="border_window" border_round="10,10"
                          padding="16,14,16,14" height="stretch">
                        <Label text_id="STRID_CALENDAR_DEMO_GROUP" font="system_bold_14" text_color="text_default"/>
                        <Label text_id="STRID_TEST_CALENDAR_DESC" font="system_regular_12" text_color="text_muted"
                               margin="0,6,0,0" height="stretch" multi_line="true" auto_tooltip="true"/>
                        <HBox height="30" margin="0,6,0,0" child_margin="6">
                            <Button class="btn_global" text_id="STRID_CALENDAR_DEMO_SINGLE" name="calendar_single" width="70" height="28" border_round="3,3"/>
                            <Button class="btn_global" text_id="STRID_CALENDAR_DEMO_RANGE" name="calendar_range" width="70" height="28" border_round="3,3"/>
                            <Control/>
                        </HBox>
                    </VBox>
                    <VBox bkcolor="bg_window_card" border_size="1" bordercolor="border_window" border_round="10,10"
                          padding="16,14,16,14" height="stretch">
                        <Label text_id="STRID_CONTROLS_CONTEXT_MENU" font="system_bold_14" text_color="text_default"/>
                        <Label text_id="STRID_TEST_CONTEXT_DESC" font="system_regular_12" text_color="text_muted"
                               margin="0,6,0,0" height="stretch" multi_line="true" auto_tooltip="true"/>
                        <HBox height="30" margin="0,6,0,0">
                            <Button class="btn_global" name="context_menu_btn" text_id="STRID_CONTROLS_CONTEXT_MENU_HINT"
                                    width="180" height="28" border_round="3,3"/>
                            <Control/>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- 输入增强 -->
                <HBox height="30" margin="4,18,4,8" valign="center">
                    <Control width="4" height="16" bkcolor="color_success" border_round="2,2" valign="center"/>
                    <Label text_id="STRID_TEST_SEC_INPUT" font="system_bold_15" text_color="text_default"
                           margin="8,0,0,0" valign="center"/>
                    <Control/>
                </HBox>
                <VBox bkcolor="bg_window_card" border_size="1" bordercolor="border_window" border_round="10,10"
                      padding="16,14,16,14" height="auto">
                    <Label text_id="STRID_CONTROLS_TAG_INPUT" font="system_bold_14" text_color="text_default"/>
                    <HBox height="34" margin="0,8,0,0" child_margin="8">
                        <TagInput class="tag_input" name="tag_input" tags="nim_duilib;C++;Desktop UI"
                                  prompt_text_id="STRID_CONTROLS_TAG_INPUT_PROMPT" height="32"/>
                        <Button class="btn_global" name="btn_add_tag" text_id="STRID_CONTROLS_TAG_ADD" width="100" height="30"
                                border_round="3,3" valign="center"/>
                        <TagInput class="tag_input" name="tag_input2" delimiter="," width="260" height="32"
                                  prompt_text_id="STRID_CONTROLS_TAG_INPUT_PROMPT2"/>
                        <Control/>
                    </HBox>
                    <Label text_id="STRID_CONTROLS_AUTO_COMPLETE" font="system_bold_14" text_color="text_default" margin="0,12,0,0"/>
                    <HBox height="34" margin="0,8,0,0" child_margin="8">
                        <AutoComplete class="auto_complete" name="auto_complete" width="50%" height="32"
                                      items="Beijing;Berlin;Budapest;Bangkok;Boston;Brisbane;Chicago;London;Los Angeles;New York;Paris;Seattle;Shanghai;Shenzhen;Singapore;Sydney;Tokyo;Toronto"
                                      prompt_text_id="STRID_CONTROLS_AUTO_COMPLETE_PROMPT"/>
                        <AutoComplete class="auto_complete" name="auto_complete2" match_mode="contains" max_visible="6"
                                      width="50%" height="32" prompt_text_id="STRID_CONTROLS_AUTO_COMPLETE_PROMPT2"/>
                    </HBox>
                    <Label text_id="STRID_TEST_SEARCH_TITLE" font="system_bold_14" text_color="text_default" margin="0,12,0,0"/>
                    <HBox height="34" margin="0,8,0,0">
                        <SearchBox class="search_box" name="search_box" width="100%" height="32"
                                   prompt_text_id="STRID_TEST_SEARCH_PROMPT"
                                   suggestions="nim_duilib;C++;Desktop UI;Skia;Qt;WPF;MFC;Win32;DirectUI;Electron;Flutter;duilib"
                                   history_enabled="true" max_history="10" max_visible="8"/>
                    </HBox>
                </VBox>

                <!-- 基础元素 -->
                <HBox height="30" margin="4,18,4,8" valign="center">
                    <Control width="4" height="16" bkcolor="color_blue_light" border_round="2,2" valign="center"/>
                    <Label text_id="STRID_TEST_SEC_ELEMENT" font="system_bold_15" text_color="text_default"
                           margin="8,0,0,0" valign="center"/>
                    <Control/>
                </HBox>
                <HBox height="208" child_margin="10">
                    <VBox bkcolor="bg_window_card" border_size="1" bordercolor="border_window" border_round="10,10"
                          padding="16,14,16,14" height="stretch" width="50%">
                        <Label text="RichText / HyperLink / Line" font="system_bold_14" text_color="text_default"/>
                        <RichText class="rich_text" name="test_rich_text" row_spacing_mul="1.2" width="auto"
                                  margin="0,8,0,0" text_id="STRID_TEST_RICHTEXT_DEMO"/>
                        <HBox height="26" margin="0,6,0,0" child_margin="10">
                            <HyperLink class="hyper_link" name="test_hyperlink1" text="Baidu Home" url="www.baidu.com" valign="center"/>
                            <HyperLink class="hyper_link" name="test_hyperlink2" text="Text Button" url="" valign="center"/>
                            <Control/>
                        </HBox>
                        <HBox height="20" margin="0,6,0,0">
                            <Label text="Solid" text_color="text_muted" width="86" font="system_regular_12" valign="center"/>
                            <Line vertical="false" line_color="#FF0078D4" dash_style="solid" line_width="2"/>
                        </HBox>
                        <HBox height="20" margin="0,4,0,0">
                            <Label text="Dash" text_color="text_muted" width="86" font="system_regular_12" valign="center"/>
                            <Line vertical="false" line_color="#FFE85854" dash_style="dash" line_width="2"/>
                        </HBox>
                        <HBox height="20" margin="0,4,0,0">
                            <Label text="Dot" text_color="text_muted" width="86" font="system_regular_12" valign="center"/>
                            <Line vertical="false" line_color="#FF22A95B" dash_style="dot" line_width="2"/>
                        </HBox>
                        <HBox height="20" margin="0,4,0,0">
                            <Label text="DashDot" text_color="text_muted" width="86" font="system_regular_12" valign="center"/>
                            <Line vertical="false" line_color="#FFD08700" dash_style="dash_dot" line_width="2"/>
                        </HBox>
                    </VBox>
                    <VBox bkcolor="bg_window_card" border_size="1" bordercolor="border_window" border_round="10,10"
                          padding="16,14,16,14" height="stretch" width="50%">
                        <Label text="IPAddress / HotKey" font="system_bold_14" text_color="text_default"/>
                        <HBox height="34" margin="0,10,0,0" child_margin="8" valign="center">
                            <Label text_id="STRID_CONTROLS_IP_ADDRESS" width="78" valign="center"/>
                            <IPAddress class="ip_address" ip="192.168.0.1" valign="center"/>
                            <Control/>
                        </HBox>
                        <HBox height="34" margin="0,8,0,0" child_margin="8" valign="center">
                            <Label text="HotKey" width="78" valign="center"/>
                            <HotKey class="hot_key" name="test_set_hot_key" default_text_id="STRID_CONTROLS_NONE" valign="center"/>
                            <Button class="btn_global" name="test_btn_set_hot_key" text_id="STRID_CONTROLS_SET_WINDOW_HOTKEY"
                                    width="130" height="28" border_round="3,3" text_align="vcenter"/>
                            <Control/>
                        </HBox>
                        <Label text_id="STRID_TEST_HOTKEY_DESC" font="system_regular_12" text_color="text_muted"
                               margin="0,8,0,0" height="stretch" multi_line="true" auto_tooltip="true"/>
                    </VBox>
                </HBox>

                <!-- 遮罩 -->
                <HBox height="30" margin="4,18,4,8" valign="center">
                    <Control width="4" height="16" bkcolor="color_error" border_round="2,2" valign="center"/>
                    <Label text_id="STRID_CONTROLS_MASK" font="system_bold_15" text_color="text_default"
                           margin="8,0,0,0" valign="center"/>
                    <Control/>
                </HBox>
                <VBox bkcolor="bg_window_card" border_size="1" bordercolor="border_window" border_round="10,10"
                      padding="16,14,16,14" height="auto">
                    <Label text_id="STRID_TEST_MASK_DESC" font="system_regular_12" text_color="text_muted"
                           multi_line="true" auto_tooltip="true"/>
                    <HBox height="32" margin="0,10,0,0" child_margin="8">
                        <Button class="btn_global" name="mask_modal_btn" text_id="STRID_CONTROLS_MASK_MODAL" width="120" height="30" border_round="3,3"/>
                        <Button class="btn_global" name="mask_guide_btn" text_id="STRID_CONTROLS_MASK_GUIDE" width="120" height="30" border_round="3,3"/>
                        <Button class="btn_global" name="mask_guide_target" text_id="STRID_CONTROLS_MASK_GUIDE_TARGET" width="120" height="30" border_round="3,3"/>
                        <Button class="btn_global" name="mask_loading_btn" text_id="STRID_CONTROLS_MASK_LOADING" width="120" height="30" border_round="3,3"/>
                        <Control/>
                    </HBox>
                </VBox>
            </VBox>
        </VScrollBox>

        <!-- 模态遮罩：铺满整个窗口、拦截鼠标输入，中间显示一个模态卡片 -->
        <Mask class="mask" name="mask_modal" visible="false">
            <VBox bkcolor="bg_window_card" border_round="6,6" float="true" halign="center" valign="center"
                  width="300" height="170" padding="20,20,20,20">
                <Label text_id="STRID_CONTROLS_MASK_MODAL_TITLE" width="stretch" height="auto" font="system_bold_14"/>
                <Label text_id="STRID_CONTROLS_MASK_MODAL_DESC" width="stretch" height="auto"
                       margin="0,12,0,0" font="system_regular_12" multi_line="true" replace_newline="true"/>
                <Button class="btn_global_blue_80x30" name="mask_modal_close" text_id="STRID_CONTROLS_MASK_CLOSE"
                        float="true" halign="center" valign="bottom" width="90" height="30" border_round="3,3"/>
            </VBox>
        </Mask>

        <!-- 新手引导遮罩：镂空高亮 mask_guide_target，镂空区域内点击可穿透到该按钮 -->
        <Mask class="mask" name="mask_guide" visible="false" mask_color="#80000000"
              highlight_control="mask_guide_target" highlight_padding="6" highlight_corner="6" click_through="true">
            <Label text_id="STRID_CONTROLS_MASK_GUIDE_HINT" float="true" halign="center" valign="bottom"
                   width="auto" height="auto" margin="0,0,0,60" font="system_regular_14" text_color="#FFFFFFFF"/>
        </Mask>

        <!-- 加载遮罩：覆盖内容区并拦截交互，中间显示加载动画 -->
        <Mask class="mask" name="mask_loading" visible="false">
            <VBox float="true" halign="center" valign="center" width="220" height="70">
                <Progress class="progress_horizontal" name="mask_loading_progress" marquee="true" marquee_width="60"
                          height="6" margin="20,0,20,0"/>
                <Label text_id="STRID_CONTROLS_MASK_LOADING_TEXT" width="stretch" height="auto"
                       margin="0,16,0,0" text_align="center" font="system_regular_14"/>
            </VBox>
        </Mask>
    </VBox>
</Window>
