<?xml version="1.0" encoding="UTF-8"?>
<Window size="720,480" text="RangeSlider Test" use_system_caption="false" caption="0,0,0,36"
        shadow_type="default" size_box="4,4,4,4" min_size="480,360">
    <VBox bkcolor="bg_window_main">
        <!-- 标题栏 -->
        <HBox name="window_title_bar" width="stretch" height="36" bkcolor="bg_titlebar">
            <Control width="18" height="18" bkimage="public/caption/logo.svg" valign="center" margin="8"/>
            <Label name="label_title" text_id="STRID_RANGESLIDER_WINDOW_TITLE" valign="center" margin="8" mouse_enabled="false"/>
            <Control/>
            <Button class="btn_wnd_close_11" height="stretch" width="40" name="btn_window_close" margin="0,0,0,2"/>
        </HBox>

        <!-- 提示区 -->
        <HBox height="38" padding="12,8,12,0">
            <Label text_id="STRID_RANGESLIDER_HINT" text_color="text_muted" valign="center"
                   text_align="left,vcenter" width="stretch" auto_tooltip="true"/>
        </HBox>

        <!-- 内容区 -->
        <VBox padding="12,8,12,12" width="stretch" height="stretch">
            <VBox bkcolor="bg_window_card" border_size="1" bordercolor="border_window" border_round="4,4"
                  padding="12,12,12,12" width="stretch" height="stretch">

                <!-- 水平方向：价格区间 -->
                <Label text_id="STRID_RANGESLIDER_PRICE" font="system_bold_15" text_color="text_default" valign="center" margin="0,0,0,6"/>
                <HBox height="36" child_margin="8">
                    <RangeSlider class="range_slider_horizontal" name="price_range"
                                 min="0" max="1000" low_value="200" value="800" min_range="50" width="stretch"/>
                </HBox>
                <Label name="rs_event" text_id="STRID_RANGESLIDER_EVENT_NONE" text_color="text_muted" valign="center"
                       margin="0,6,0,0" auto_tooltip="true"/>

                <!-- 操作按钮 -->
                <HBox height="34" child_margin="8" margin="0,8,0,0">
                    <Button class="btn_global" name="btn_range_reset" text_id="STRID_RANGESLIDER_RESET" width="96" height="28" border_round="3,3"/>
                    <Button class="btn_global" name="btn_range_full" text_id="STRID_RANGESLIDER_FULL" width="96" height="28" border_round="3,3"/>
                    <Control/>
                </HBox>

                <!-- 垂直方向：音量区间 -->
                <Label text_id="STRID_RANGESLIDER_LEVEL" font="system_bold_15" text_color="text_default" valign="center" margin="0,12,0,6"/>
                <HBox height="stretch" width="stretch">
                    <RangeSlider class="range_slider_vertical" name="level_range"
                                 min="0" max="100" low_value="30" value="70" height="stretch"/>
                    <Control/>
                </HBox>
            </VBox>
        </VBox>
    </VBox>
</Window>
