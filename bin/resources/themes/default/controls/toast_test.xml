<?xml version="1.0" encoding="UTF-8"?>
<Window text_id="STRID_TOAST_MAIN_TITLE" size="560,520" min_size="360,300"
        caption="0,0,0,${SIZE_TITLEBAR_HEIGHT}" use_system_caption="false"
        snap_layout_menu="true" sys_menu="true" sys_menu_rect="0,0,${SIZE_TITLEBAR_HEIGHT},${SIZE_TITLEBAR_HEIGHT}"
        shadow_type="default" shadow_attached="true"
        layered_window="true" alpha="255" size_box="4,4,4,4"
        icon="public/caption/logo.ico">
    <VBox bkcolor="bg_window_main">
        <!-- 标题栏 -->
        <HBox name="window_title_bar" width="stretch" height="${SIZE_TITLEBAR_HEIGHT}" bkcolor="bg_titlebar">
            <Control class="title_bar_logo"/>
            <Label class="title_bar_title" name="label_title" text_id="STRID_TOAST_MAIN_TITLE"/>
            <Control/>
            <Button class="btn_switch_theme" name="btn_window_theme" margin="0,2,0,2"/>
            <Button class="btn_switch_lang" name="btn_window_language" margin="0,2,0,2"/>
            <Button class="btn_wnd_min_11" name="btn_window_min" margin="0,2,0,2"/>
            <Box height="${SIZE_WND_BTN_HEIGHT}" width="${SIZE_WND_BTN_WIDTH}" margin="0,2,0,2">
                <Button class="btn_wnd_max_11" name="btn_window_max" margin="0"/>
                <Button class="btn_wnd_restore_11" name="btn_window_restore" visible="false" margin="0"/>
            </Box>
            <Button class="btn_wnd_close_11" name="btn_window_close" margin="0"/>
        </HBox>

        <!-- 内容区 -->
        <VBox width="stretch" height="stretch" padding="20,20,20,20" halign="center">
            <Label name="label_hint" text_id="STRID_TOAST_MAIN_HINT" multi_line="true" font="system_bold_14" margin="0,0,0,12"/>

            <Button class="btn_global" name="btn_demo_info" text_id="STRID_TOAST_BTN_INFO"
                    width="320" height="34" halign="center" margin="0,0,0,10"/>
            <Button class="btn_global" name="btn_demo_success" text_id="STRID_TOAST_BTN_SUCCESS"
                    width="320" height="34" halign="center" margin="0,0,0,10"/>
            <Button class="btn_global" name="btn_demo_warning" text_id="STRID_TOAST_BTN_WARNING"
                    width="320" height="34" halign="center" margin="0,0,0,10"/>
            <Button class="btn_global" name="btn_demo_error" text_id="STRID_TOAST_BTN_ERROR"
                    width="320" height="34" halign="center" margin="0,0,0,10"/>
            <Button class="btn_global" name="btn_demo_stack" text_id="STRID_TOAST_BTN_STACK"
                    width="320" height="34" halign="center" margin="0,0,0,10"/>
            <Button class="btn_global" name="btn_demo_long" text_id="STRID_TOAST_BTN_LONG"
                    width="320" height="34" halign="center" margin="0,0,0,10"/>
            <Button class="btn_global" name="btn_demo_manual" text_id="STRID_TOAST_BTN_MANUAL"
                    width="320" height="34" halign="center" margin="0,0,0,10"/>
            <!-- 位置演示：覆盖 ToastPosition 全部取值（顶部/垂直居中/底部/右上/右下） -->
            <HBox width="stretch" height="auto" margin="0,0,0,10" halign="center">
                <Button class="btn_global" name="btn_demo_pos_top" text_id="STRID_TOAST_BTN_POS_TOP"
                        width="stretch" height="34" margin="2,0,2,0"/>
                <Button class="btn_global" name="btn_demo_pos_center" text_id="STRID_TOAST_BTN_POS_CENTER"
                        width="stretch" height="34" margin="2,0,2,0"/>
                <Button class="btn_global" name="btn_demo_pos_bottom" text_id="STRID_TOAST_BTN_POS_BOTTOM"
                        width="stretch" height="34" margin="2,0,2,0"/>
                <Button class="btn_global" name="btn_demo_pos_topright" text_id="STRID_TOAST_BTN_POS_TOPRIGHT"
                        width="stretch" height="34" margin="2,0,2,0"/>
                <Button class="btn_global" name="btn_demo_pos_bottomright" text_id="STRID_TOAST_BTN_POS_BOTTOMRIGHT"
                        width="stretch" height="34" margin="2,0,2,0"/>
            </HBox>
            <Button class="btn_global" name="btn_demo_action" text_id="STRID_TOAST_BTN_ACTION"
                    width="320" height="34" halign="center" margin="0,0,0,10"/>
        </VBox>
    </VBox>
</Window>
