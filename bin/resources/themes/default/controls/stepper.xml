<?xml version="1.0" encoding="UTF-8"?>
<Window size="760,560" text="Stepper Test" use_system_caption="false" caption="0,0,0,36"
        shadow_type="default" size_box="4,4,4,4" min_size="520,420">
    <VBox bkcolor="bg_window_main">
        <!-- 标题栏 -->
        <HBox name="window_title_bar" width="stretch" height="36" bkcolor="bg_titlebar">
            <Control width="18" height="18" bkimage="public/caption/logo.svg" valign="center" margin="8"/>
            <Label name="label_title" text_id="STRID_STEPPER_WINDOW_TITLE" valign="center" margin="8" mouse_enabled="false"/>
            <Control/>
            <Button class="btn_wnd_close_11" height="stretch" width="40" name="btn_window_close" margin="0,0,0,2"/>
        </HBox>

        <!-- 提示区 -->
        <HBox height="38" padding="12,8,12,0">
            <Label text_id="STRID_STEPPER_HINT" text_color="text_muted" valign="center"
                   text_align="left,vcenter" width="stretch" auto_tooltip="true"/>
        </HBox>

        <!-- 内容区 -->
        <VBox padding="12,8,12,12" width="stretch" height="stretch">
            <!-- 水平步骤条：安装向导 -->
            <VBox bkcolor="bg_window_card" border_size="1" bordercolor="border_window" border_round="4,4"
                  padding="16,16,16,16" width="stretch" height="150">
                <Label text_id="STRID_STEPPER_HORIZONTAL_TITLE" font="system_bold_15" text_color="text_default" valign="center" margin="0,0,0,12"/>
                <Stepper class="stepper_node" name="stepper_demo" width="stretch" height="stretch" node_size="28" current="1"
                         step_title_id="STRID_STEPPER_S1_TITLE|STRID_STEPPER_S2_TITLE|STRID_STEPPER_S3_TITLE|STRID_STEPPER_S4_TITLE"
                         step_desc_id="STRID_STEPPER_S1_DESC|STRID_STEPPER_S2_DESC|STRID_STEPPER_S3_DESC|STRID_STEPPER_S4_DESC"/>
            </VBox>

            <!-- 操作按钮与当前步骤回显 -->
            <HBox height="40" child_margin="8" margin="0,10,0,0">
                <Button class="btn_global" name="btn_step_prev" text_id="STRID_STEPPER_PREV" width="96" height="28" border_round="3,3"/>
                <Button class="btn_global" name="btn_step_next" text_id="STRID_STEPPER_NEXT" width="96" height="28" border_round="3,3"/>
                <Button class="btn_global" name="btn_step_goto" text_id="STRID_STEPPER_GOTO" width="110" height="28" border_round="3,3"/>
                <Button class="btn_global" name="btn_step_reset" text_id="STRID_STEPPER_RESET" width="96" height="28" border_round="3,3"/>
                <Label name="step_event" text_id="STRID_STEPPER_EVENT_NONE" text_color="text_default" valign="center"
                       margin="8,0,0,0" auto_tooltip="true"/>
                <Control/>
            </HBox>

            <!-- 垂直步骤条：配置向导 -->
            <VBox bkcolor="bg_window_card" border_size="1" bordercolor="border_window" border_round="4,4"
                  padding="16,16,16,16" width="stretch" height="stretch" margin="0,10,0,0">
                <Label text_id="STRID_STEPPER_VERTICAL_TITLE" font="system_bold_15" text_color="text_default" valign="center" margin="0,0,0,8"/>
                <Stepper class="stepper_node" name="stepper_vertical" direction="vertical" width="stretch" height="stretch" node_size="24" current="2"
                         step_title_id="STRID_STEPPER_V1_TITLE|STRID_STEPPER_V2_TITLE|STRID_STEPPER_V3_TITLE"
                         step_desc_id="STRID_STEPPER_V1_DESC|STRID_STEPPER_V2_DESC|STRID_STEPPER_V3_DESC"/>
            </VBox>
        </VBox>
    </VBox>
</Window>
