<?xml version="1.0" encoding="UTF-8"?>
<Window size="1100,760" text="Chart Test" use_system_caption="false" caption="0,0,0,36" shadow_type="default">
    <VBox bkcolor="bg_window_main">
        <!-- 标题栏 -->
        <HBox name="window_title_bar" width="stretch" height="36" bkcolor="bg_titlebar">
            <Control width="18" height="18" bkimage="public/caption/logo.svg" valign="center" margin="8"/>
            <Label name="label_title" text="Chart 图表控件测试" valign="center" margin="8" mouse_enabled="false"/>
            <Control/>
            <Button class="btn_wnd_close_11" height="stretch" width="40" name="btn_window_close" margin="0,0,0,2"/>
        </HBox>

        <!-- 图表内容区：两行两列 -->
        <VBox padding="12,12,12,12" height="stretch">
            <!-- 第一行 -->
            <HBox height="stretch" padding="0,0,0,12">
                <!-- 左上：多系列折线图（直线 + 数据点 + 标题 + 坐标轴标题 + 图例） -->
                <VBox width="stretch" bkcolor="bg_window_card" border_size="1" bordercolor="border_window" border_round="4,4" padding="12,12,12,12" margin="0,0,12,0">
                    <HBox height="28">
                        <Label text="折线图 · 多系列（直线）" font="system_bold_15" text_color="text_default" valign="center"/>
                        <Control/>
                        <Button class="btn_global" name="btn_line_add" text="追加数据" width="90" height="26" border_round="3,3" margin="0,0,6,0"/>
                        <Button class="btn_global" name="btn_line_clear" text="清空" width="70" height="26" border_round="3,3"/>
                    </HBox>
                    <Chart name="chart_line" height="stretch" chart_type="line"
                           title="季度销售趋势对比"
                           x_axis_title="季度" y_axis_title="销售额（万元）"
                           data="35,48,27,62,50,41,58,33,45,52"
                           data_labels="Q1,Q2,Q3,Q4,Q5,Q6,Q7,Q8,Q9,Q10"
                           legend_visible="true"
                           series_color="color_accent" axis_color="border_control_normal"
                           label_color="text_default" show_value="true" show_grid="true"
                           show_axis_values="true" axis_divisions="5" line_width="2"
                           line_mode="straight" show_data_points="true"/>
                </VBox>

                <!-- 右上：折线图（曲线 + 面积填充） -->
                <VBox width="stretch" bkcolor="bg_window_card" border_size="1" bordercolor="border_window" border_round="4,4" padding="12,12,12,12">
                    <HBox height="28">
                        <Label text="折线图 · 曲线 + 面积填充" font="system_bold_15" text_color="text_default" valign="center"/>
                    </HBox>
                    <Chart name="chart_line_area" height="stretch" chart_type="line"
                           title="网站访问量趋势"
                           x_axis_title="日期" y_axis_title="访问量"
                           data="120,150,180,165,220,260,240,300,280,340,320,380"
                           data_labels="1日,5日,9日,13日,17日,21日,25日,29日,3日,7日,11日,15日"
                           legend_visible="false"
                           series_color="color_accent" axis_color="border_control_normal"
                           label_color="text_default" show_value="false" show_grid="true"
                           show_axis_values="true" axis_divisions="4" line_width="3"
                           line_mode="curve" area_fill="true" show_data_points="false"/>
                </VBox>
            </HBox>

            <!-- 第二行 -->
            <HBox height="stretch">
                <!-- 左下：柱状图（分组，含负值） -->
                <VBox width="stretch" bkcolor="bg_window_card" border_size="1" bordercolor="border_window" border_round="4,4" padding="12,12,12,12" margin="0,0,12,0">
                    <HBox height="28">
                        <Label text="柱状图 · 分组（含负值）" font="system_bold_15" text_color="text_default" valign="center"/>
                        <Control/>
                        <Button class="btn_global" name="btn_bar_switch" text="切换数据" width="90" height="26" border_round="3,3"/>
                    </HBox>
                    <Chart name="chart_bar" height="stretch" chart_type="bar"
                           title="各季度收支对比"
                           x_axis_title="季度" y_axis_title="金额（万元）"
                           data="45,-18,62,-25,38,80,-15,55,70"
                           data_labels="Q1,Q2,Q3,Q4,Q5,Q6,Q7,Q8,Q9"
                           legend_visible="true"
                           series_color="color_accent" axis_color="border_control_normal"
                           label_color="text_default" show_value="true" show_grid="true"
                           show_axis_values="true" axis_divisions="5"
                           bar_mode="grouped"/>
                </VBox>

                <!-- 右下：环形饼图（百分比 + 图例） -->
                <VBox width="stretch" bkcolor="bg_window_card" border_size="1" bordercolor="border_window" border_round="4,4" padding="12,12,12,12">
                    <HBox height="28">
                        <Label text="饼图 · 环形（百分比）" font="system_bold_15" text_color="text_default" valign="center"/>
                        <Control/>
                        <Button class="btn_global" name="btn_pie_switch" text="切换数据" width="90" height="26" border_round="3,3"/>
                    </HBox>
                    <Chart name="chart_pie" height="stretch" chart_type="pie"
                           title="访问来源占比"
                           data="30,25,20,15,10"
                           data_labels="搜索引擎,直接访问,社交媒体,邮件推广,其他"
                           series_color="color_accent" label_color="text_default"
                           legend_visible="true" show_value="false" show_percent="true"
                           donut="true"/>
                </VBox>
            </HBox>
        </VBox>
    </VBox>
</Window>
