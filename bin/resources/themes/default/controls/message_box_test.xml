<?xml version="1.0" encoding="UTF-8"?>
<Window text_id="STRID_MSGBOX_MAIN_TITLE" size="500,560" min_size="360,300"
        caption="0,0,0,36" use_system_caption="false"
        snap_layout_menu="true" sys_menu="true" sys_menu_rect="0,0,36,36"
        shadow_type="default" shadow_attached="true"
        layered_window="true" alpha="255" size_box="4,4,4,4"
        icon="public/caption/logo.ico">
    <VBox bkcolor="bg_window_main">
        <!-- 标题栏 -->
        <HBox name="window_title_bar" width="stretch" height="36" bkcolor="bg_titlebar">
            <Control width="18" height="18" bkimage="public/caption/logo.svg" valign="center" margin="8"/>
            <Label name="label_title" text_id="STRID_MSGBOX_MAIN_TITLE" valign="center" margin="8" mouse_enabled="false"/>
            <Control/>
            <Button class="btn_switch_theme" height="32" width="40" name="btn_window_theme" margin="0,2,0,2"/>
            <Button class="btn_switch_lang" height="32" width="40" name="btn_window_language" margin="0,2,0,2"/>
            <Button class="btn_wnd_min_11" height="32" width="40" name="btn_window_min" margin="0,2,0,2"/>
            <Box height="stretch" width="40" margin="0,2,0,2">
                <Button class="btn_wnd_max_11" height="32" width="stretch" name="btn_window_max"/>
                <Button class="btn_wnd_restore_11" height="32" width="stretch" name="btn_window_restore" visible="false"/>
            </Box>
            <Button class="btn_wnd_close_11" height="stretch" width="40" name="btn_window_close" margin="0,0,0,2"/>
        </HBox>

        <!-- 内容区 -->
        <VBox width="stretch" height="stretch" padding="20,20,20,20" halign="center">
            <Label name="label_hint" text_id="STRID_MSGBOX_MAIN_HINT" font="system_bold_14" margin="0,0,0,12"/>

            <Button class="btn_global" name="btn_demo_ok" text_id="STRID_MSGBOX_BTN_OK"
                    width="320" height="34" halign="center" margin="0,0,0,10"/>
            <Button class="btn_global" name="btn_demo_ok_cancel" text_id="STRID_MSGBOX_BTN_OK_CANCEL"
                    width="320" height="34" halign="center" margin="0,0,0,10"/>
            <Button class="btn_global" name="btn_demo_yes_no" text_id="STRID_MSGBOX_BTN_YES_NO"
                    width="320" height="34" halign="center" margin="0,0,0,10"/>
            <Button class="btn_global" name="btn_demo_yes_no_cancel" text_id="STRID_MSGBOX_BTN_YES_NO_CANCEL"
                    width="320" height="34" halign="center" margin="0,0,0,10"/>
            <Button class="btn_global" name="btn_demo_retry_cancel" text_id="STRID_MSGBOX_BTN_RETRY_CANCEL"
                    width="320" height="34" halign="center" margin="0,0,0,10"/>
            <Button class="btn_global" name="btn_demo_icons" text_id="STRID_MSGBOX_BTN_ICONS"
                    width="320" height="34" halign="center" margin="0,0,0,10"/>
            <Button class="btn_global" name="btn_demo_long_text" text_id="STRID_MSGBOX_BTN_LONG_TEXT"
                    width="320" height="34" halign="center" margin="0,0,0,10"/>
            <Button class="btn_global" name="btn_demo_custom_text" text_id="STRID_MSGBOX_BTN_CUSTOM_TEXT"
                    width="320" height="34" halign="center" margin="0,0,0,10"/>

            <Label name="label_result" text_id="STRID_MSGBOX_MAIN_RESULT_NONE"
                   normal_text_color="text_muted" font="system_regular_14"
                   width="stretch" height="auto" margin="0,12,0,0"/>
        </VBox>
    </VBox>
</Window>
