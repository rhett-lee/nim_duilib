<?xml version="1.0" encoding="UTF-8"?>
<Window size="900,820" text="Popover Test" use_system_caption="false" caption="0,0,0,36"
        shadow_type="default" size_box="4,4,4,4" min_size="820,620">
    <VBox bkcolor="bg_window_main">
        <!-- 标题栏 -->
        <HBox name="window_title_bar" width="stretch" height="36" bkcolor="bg_titlebar">
            <Control width="18" height="18" bkimage="public/caption/logo.svg" valign="center" margin="8"/>
            <Label name="label_title" text_id="STRID_POPOVER_WINDOW_TITLE" valign="center" margin="8" mouse_enabled="false"/>
            <Control/>
            <Button class="btn_wnd_close_11" height="stretch" width="40" name="btn_window_close" margin="0,0,0,2"/>
        </HBox>

        <!-- 提示区 -->
        <HBox height="34" padding="12,6,12,0">
            <Label text_id="STRID_POPOVER_HINT" text_color="text_muted" valign="center"
                   text_align="left,vcenter" width="stretch" auto_tooltip="true"/>
        </HBox>

        <!-- 内容区 -->
        <VScrollBox width="stretch" height="stretch" vscrollbar="true" hscrollbar="false">
            <VBox padding="12,8,12,12" width="stretch" height="auto">
                <!-- 基础用法：悬停锚点即弹出卡片，卡片高度由内容决定 -->
                <VBox bkcolor="bg_window_card" border_size="1" border_color="border_window" border_round="6,6"
                      padding="16,16,16,16" width="stretch" height="auto">
                    <Label text_id="STRID_POPOVER_BASIC_TITLE" font="system_bold_15" text_color="text_default"
                           valign="center" margin="0,0,0,4"/>
                    <Label text_id="STRID_POPOVER_BASIC_DESC" font="system_regular_12" text_color="text_muted"
                           valign="center" margin="0,0,0,12" auto_tooltip="true"/>
                    <HBox height="40">
                        <Popover class="popover_anchor_primary" name="popover_basic" trigger="hover" placement="top"
                                 valign="center" text_id="STRID_POPOVER_ANCHOR_HOVER_ME"
                                 title_id="STRID_POPOVER_TITLE"/>
                        <Control width="stretch" height="stretch" mouse_enabled="false"/>
                    </HBox>
                </VBox>

                <!-- 三种触发方式 + 手动触发（手动触发只响应 API，右侧按钮演示 Show/Toggle） -->
                <VBox bkcolor="bg_window_card" border_size="1" border_color="border_window" border_round="6,6"
                      padding="16,16,16,16" width="stretch" height="auto" margin="0,12,0,0">
                    <Label text_id="STRID_POPOVER_TRIGGER_TITLE" font="system_bold_15" text_color="text_default"
                           valign="center" margin="0,0,0,4"/>
                    <Label text_id="STRID_POPOVER_TRIGGER_DESC" font="system_regular_12" text_color="text_muted"
                           valign="center" margin="0,0,0,12" auto_tooltip="true"/>
                    <HBox height="40" child_margin_x="8">
                        <Popover class="popover_anchor" name="popover_hover" trigger="hover" placement="top"
                                 valign="center" text_id="STRID_POPOVER_ANCHOR_HOVER"
                                 title_id="STRID_POPOVER_TITLE" content_id="STRID_POPOVER_HOVER_CONTENT"/>
                        <Popover class="popover_anchor" name="popover_focus" trigger="focus" placement="top"
                                 valign="center" text_id="STRID_POPOVER_ANCHOR_FOCUS"
                                 title_id="STRID_POPOVER_TITLE" content_id="STRID_POPOVER_FOCUS_CONTENT"/>
                        <Popover class="popover_anchor" name="popover_click" trigger="click" placement="top"
                                 valign="center" text_id="STRID_POPOVER_ANCHOR_CLICK"
                                 title_id="STRID_POPOVER_TITLE" content_id="STRID_POPOVER_CLICK_CONTENT"/>
                        <Popover class="popover_anchor" name="popover_manual" trigger="manual" placement="top"
                                 valign="center" width="auto" padding="12,0,12,0"
                                 text_id="STRID_POPOVER_ANCHOR_MANUAL"
                                 title_id="STRID_POPOVER_TITLE" content_id="STRID_POPOVER_MANUAL_CONTENT"/>
                        <Button class="btn_global" name="btn_popover_manual" text_id="STRID_POPOVER_MANUAL_BTN"
                                width="96" height="28" border_round="3,3" valign="center"/>
                        <Control width="stretch" height="stretch" mouse_enabled="false"/>
                    </HBox>
                </VBox>

                <!-- 位置：12 个方位按"环形"排列，与 Ant Design 的位置示例一致 -->
                <VBox bkcolor="bg_window_card" border_size="1" border_color="border_window" border_round="6,6"
                      padding="16,16,16,16" width="stretch" height="auto" margin="0,12,0,0">
                    <Label text_id="STRID_POPOVER_PLACEMENT_TITLE" font="system_bold_15" text_color="text_default"
                           valign="center" margin="0,0,0,4"/>
                    <Label text_id="STRID_POPOVER_PLACEMENT_DESC" font="system_regular_12" text_color="text_muted"
                           valign="center" margin="0,0,0,12" auto_tooltip="true"/>
                    <VBox width="520" height="auto" halign="center">
                        <HBox height="34" child_margin_x="6">
                            <Control width="stretch" height="stretch" mouse_enabled="false"/>
                            <Popover class="popover_anchor" name="popover_top_left" placement="top_left"
                                     valign="center" text_id="STRID_POPOVER_ANCHOR_TOP_LEFT"
                                     title_id="STRID_POPOVER_TITLE" content_id="STRID_POPOVER_PLACEMENT_CONTENT"/>
                            <Popover class="popover_anchor" name="popover_top" placement="top"
                                     valign="center" text_id="STRID_POPOVER_ANCHOR_TOP"
                                     title_id="STRID_POPOVER_TITLE" content_id="STRID_POPOVER_PLACEMENT_CONTENT"/>
                            <Popover class="popover_anchor" name="popover_top_right" placement="top_right"
                                     valign="center" text_id="STRID_POPOVER_ANCHOR_TOP_RIGHT"
                                     title_id="STRID_POPOVER_TITLE" content_id="STRID_POPOVER_PLACEMENT_CONTENT"/>
                            <Control width="stretch" height="stretch" mouse_enabled="false"/>
                        </HBox>
                        <HBox height="34" child_margin_x="6">
                            <Popover class="popover_anchor" name="popover_left_top" placement="left_top"
                                     valign="center" text_id="STRID_POPOVER_ANCHOR_LEFT_TOP"
                                     title_id="STRID_POPOVER_TITLE" content_id="STRID_POPOVER_PLACEMENT_CONTENT"/>
                            <Control width="stretch" height="stretch" mouse_enabled="false"/>
                            <Popover class="popover_anchor" name="popover_right_top" placement="right_top"
                                     valign="center" text_id="STRID_POPOVER_ANCHOR_RIGHT_TOP"
                                     title_id="STRID_POPOVER_TITLE" content_id="STRID_POPOVER_PLACEMENT_CONTENT"/>
                        </HBox>
                        <HBox height="34" child_margin_x="6">
                            <Popover class="popover_anchor" name="popover_left" placement="left"
                                     valign="center" text_id="STRID_POPOVER_ANCHOR_LEFT"
                                     title_id="STRID_POPOVER_TITLE" content_id="STRID_POPOVER_PLACEMENT_CONTENT"/>
                            <Control width="stretch" height="stretch" mouse_enabled="false"/>
                            <Popover class="popover_anchor" name="popover_right" placement="right"
                                     valign="center" text_id="STRID_POPOVER_ANCHOR_RIGHT"
                                     title_id="STRID_POPOVER_TITLE" content_id="STRID_POPOVER_PLACEMENT_CONTENT"/>
                        </HBox>
                        <HBox height="34" child_margin_x="6">
                            <Popover class="popover_anchor" name="popover_left_bottom" placement="left_bottom"
                                     valign="center" text_id="STRID_POPOVER_ANCHOR_LEFT_BOTTOM"
                                     title_id="STRID_POPOVER_TITLE" content_id="STRID_POPOVER_PLACEMENT_CONTENT"/>
                            <Control width="stretch" height="stretch" mouse_enabled="false"/>
                            <Popover class="popover_anchor" name="popover_right_bottom" placement="right_bottom"
                                     valign="center" text_id="STRID_POPOVER_ANCHOR_RIGHT_BOTTOM"
                                     title_id="STRID_POPOVER_TITLE" content_id="STRID_POPOVER_PLACEMENT_CONTENT"/>
                        </HBox>
                        <HBox height="34" child_margin_x="6">
                            <Control width="stretch" height="stretch" mouse_enabled="false"/>
                            <Popover class="popover_anchor" name="popover_bottom_left" placement="bottom_left"
                                     valign="center" text_id="STRID_POPOVER_ANCHOR_BOTTOM_LEFT"
                                     title_id="STRID_POPOVER_TITLE" content_id="STRID_POPOVER_PLACEMENT_CONTENT"/>
                            <Popover class="popover_anchor" name="popover_bottom" placement="bottom"
                                     valign="center" text_id="STRID_POPOVER_ANCHOR_BOTTOM"
                                     title_id="STRID_POPOVER_TITLE" content_id="STRID_POPOVER_PLACEMENT_CONTENT"/>
                            <Popover class="popover_anchor" name="popover_bottom_right" placement="bottom_right"
                                     valign="center" text_id="STRID_POPOVER_ANCHOR_BOTTOM_RIGHT"
                                     title_id="STRID_POPOVER_TITLE" content_id="STRID_POPOVER_PLACEMENT_CONTENT"/>
                            <Control width="stretch" height="stretch" mouse_enabled="false"/>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- 受控模式：trigger="manual" + Show/Hide/Toggle/换样式 + 状态回显 -->
                <VBox bkcolor="bg_window_card" border_size="1" border_color="border_window" border_round="6,6"
                      padding="16,16,16,16" width="stretch" height="auto" margin="0,12,0,0">
                    <Label text_id="STRID_POPOVER_CONTROLLED_TITLE" font="system_bold_15" text_color="text_default"
                           valign="center" margin="0,0,0,4"/>
                    <Label text_id="STRID_POPOVER_CONTROLLED_DESC" font="system_regular_12" text_color="text_muted"
                           valign="center" margin="0,0,0,12" auto_tooltip="true"/>
                    <HBox height="40" child_margin_x="8">
                        <Popover class="popover_anchor" name="popover_controlled" trigger="manual" placement="bottom"
                                 valign="center" width="auto" padding="12,0,12,0"
                                 text_id="STRID_POPOVER_CONTROLLED_ANCHOR"
                                 title_id="STRID_POPOVER_TITLE" content_id="STRID_POPOVER_CONTROLLED_CONTENT"/>
                        <Control width="stretch" height="stretch" mouse_enabled="false"/>
                        <Button class="btn_global" name="btn_popover_show" text_id="STRID_POPOVER_BTN_SHOW"
                                width="80" height="28" border_round="3,3" valign="center"/>
                        <Button class="btn_global" name="btn_popover_hide" text_id="STRID_POPOVER_BTN_HIDE"
                                width="80" height="28" border_round="3,3" valign="center"/>
                        <Button class="btn_global" name="btn_popover_toggle" text_id="STRID_POPOVER_BTN_TOGGLE"
                                width="80" height="28" border_round="3,3" valign="center"/>
                        <Button class="btn_global" name="btn_popover_style" text_id="STRID_POPOVER_BTN_STYLE"
                                width="auto" padding="12,0,12,0" height="28" border_round="3,3" valign="center"/>
                    </HBox>
                    <HBox height="30" margin="0,8,0,0">
                        <Label name="popover_state" text_id="STRID_POPOVER_STATE_NONE" text_color="text_default"
                               valign="center" width="stretch" auto_tooltip="true"/>
                    </HBox>
                </VBox>

                <!-- 复杂内容：content_xml 富内容 + 卡片内按钮（从浮层内关闭） -->
                <VBox bkcolor="bg_window_card" border_size="1" border_color="border_window" border_round="6,6"
                      padding="16,16,16,16" width="stretch" height="auto" margin="0,12,0,0">
                    <Label text_id="STRID_POPOVER_RICH_TITLE" font="system_bold_15" text_color="text_default"
                           valign="center" margin="0,0,0,4"/>
                    <Label text_id="STRID_POPOVER_RICH_DESC" font="system_regular_12" text_color="text_muted"
                           valign="center" margin="0,0,0,12" auto_tooltip="true"/>
                    <HBox height="40">
                        <Popover class="popover_anchor" name="popover_rich" trigger="click" placement="right"
                                 valign="center" width="auto" padding="12,0,12,0"
                                 text_id="STRID_POPOVER_RICH_ANCHOR"
                                 title_id="STRID_POPOVER_TITLE"/>
                        <Control width="stretch" height="stretch" mouse_enabled="false"/>
                    </HBox>
                </VBox>

                <!-- 占位：把剩余空间留在底部 -->
                <Control height="stretch" mouse_enabled="false"/>
            </VBox>
        </VScrollBox>
    </VBox>
</Window>
