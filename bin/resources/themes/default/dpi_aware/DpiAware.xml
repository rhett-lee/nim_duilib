<?xml version="1.0" encoding="UTF-8"?>
<Window size="900,520" min_size="820,480" snap_layout_menu="true" sys_menu="true" sys_menu_rect="0,0,36,36" caption="0,0,0,36" shadow_attached="true" size_box="4,4,4,4">
    <VBox bkcolor="bg_window_main" visible="true">
        <!-- 标题栏区域 -->
        <HBox name="window_title_bar" width="stretch" height="36" bkcolor="bg_titlebar">
            <Label name="title" width="100%" height="100%" mouse_enabled="false" text_padding="10,0,0,0" text_align="vcenter"/>
            <Button class="btn_switch_theme" height="32" width="40" name="btn_window_theme" margin="0,2,0,2"/>
            <Button class="btn_switch_lang" height="32" width="40" name="btn_window_language" margin="0,2,0,2"/>
            <Button class="btn_wnd_fullscreen_11" height="32" width="40" name="btn_window_fullscreen" margin="0,2,0,2"/>
            <Button class="btn_wnd_min_11" height="32" width="40" name="btn_window_min" margin="0,2,0,2"/>
            <Box height="stretch" width="40" margin="0,2,0,2">
                <Button class="btn_wnd_max_11" height="32" width="stretch" name="btn_window_max"/>
                <Button class="btn_wnd_restore_11" height="32" width="stretch" name="btn_window_restore" visible="false"/>
            </Box>
            <Button class="btn_wnd_close_11" height="stretch" width="40" name="btn_window_close" margin="0,0,0,2"/>
        </HBox>

        <!-- 工作区域：左侧为 DPI 信息与富文本，右侧为多分辨率图源演示 -->
        <VBox name="content_area" width="stretch" height="stretch" padding="20,16,20,12">
            <HBox width="stretch" height="stretch">

                <!-- 左列 -->
                <VBox width="stretch" height="stretch">

                    <!-- 卡片：DPI 信息 -->
                    <VBox name="info_card" width="stretch" height="auto" bkcolor="bg_window_card"
                          border_size="1" border_color="border_control_normal" border_round="8,8"
                          padding="18,14,18,12">
                        <Label text_id="STRID_DPIAWARE_TITLE" width="stretch" height="auto"
                               font="system_bold_15" text_align="left,vcenter"/>
                        <Control width="stretch" height="12" mouse_enabled="false"/>

                        <HBox width="stretch" height="28">
                            <Label text_id="STRID_DPIAWARE_CURRENT_AWARENESS" width="150" height="100%" text_align="left,vcenter" text_color="color_gray"/>
                            <Label name="dpi_awareness" text="-" width="stretch" height="100%" text_align="left,vcenter"/>
                        </HBox>
                        <HBox width="stretch" height="28">
                            <Label text_id="STRID_DPIAWARE_CURRENT_DPI_SCALE" width="150" height="100%" text_align="left,vcenter" text_color="color_gray"/>
                            <Label name="primary_monitor_display_scale" text="-" width="stretch" height="100%" text_align="left,vcenter"/>
                        </HBox>
                        <HBox width="stretch" height="28">
                            <Label text_id="STRID_DPIAWARE_WINDOW_DISPLAY_SCALE" width="150" height="100%" text_align="left,vcenter" text_color="color_gray"/>
                            <Label name="window_display_scale" text="-" width="stretch" height="100%" text_align="left,vcenter"/>
                        </HBox>
                        <HBox width="stretch" height="28">
                            <Label text_id="STRID_DPIAWARE_WINDOW_SIZE" width="150" height="100%" text_align="left,vcenter" text_color="color_gray"/>
                            <Label name="window_size" text="-" width="stretch" height="100%" text_align="left,vcenter"/>
                        </HBox>
                        <HBox width="stretch" height="28">
                            <Label text_id="STRID_DPIAWARE_WINDOW_CLIENT_SIZE" width="150" height="100%" text_align="left,vcenter" text_color="color_gray"/>
                            <Label name="window_client_size" text="-" width="stretch" height="100%" text_align="left,vcenter"/>
                        </HBox>
                        <HBox width="stretch" height="28">
                            <Label text_id="STRID_DPIAWARE_CONTENT_SIZE" width="150" height="100%" text_align="left,vcenter" text_color="color_gray"/>
                            <Label name="content_size" text="-" width="stretch" height="100%" text_align="left,vcenter"/>
                        </HBox>

                        <!-- SDL 平台专有的接口返回值（非 SDL 构建时不显示） -->
                        <VBox name="SDL" width="stretch" height="auto" visible="true" margin="0,6,0,0">
                            <Control width="stretch" height="1" bkcolor="border_split_level1" mouse_enabled="false"/>
                            <Control width="stretch" height="10" mouse_enabled="false"/>
                            <HBox width="stretch" height="26">
                                <Label text="SDL_GetWindowSize" width="200" height="100%" text_align="left,vcenter" text_color="color_gray"/>
                                <Label name="SDL_GetWindowSize" text="-" width="stretch" height="100%" text_align="left,vcenter"/>
                            </HBox>
                            <HBox width="stretch" height="26">
                                <Label text="SDL_GetWindowSizeInPixels" width="200" height="100%" text_align="left,vcenter" text_color="color_gray"/>
                                <Label name="SDL_GetWindowSizeInPixels" text="-" width="stretch" height="100%" text_align="left,vcenter"/>
                            </HBox>
                            <HBox width="stretch" height="26">
                                <Label text="SDL_GetDisplayContentScale" width="200" height="100%" text_align="left,vcenter" text_color="color_gray"/>
                                <Label name="SDL_GetDisplayContentScale" text="-" width="stretch" height="100%" text_align="left,vcenter"/>
                            </HBox>
                            <HBox width="stretch" height="26">
                                <Label text="SDL_GetWindowDisplayScale" width="200" height="100%" text_align="left,vcenter" text_color="color_gray"/>
                                <Label name="SDL_GetWindowDisplayScale" text="-" width="stretch" height="100%" text_align="left,vcenter"/>
                            </HBox>
                            <HBox width="stretch" height="26">
                                <Label text="SDL_GetWindowPixelDensity" width="200" height="100%" text_align="left,vcenter" text_color="color_gray"/>
                                <Label name="SDL_GetWindowPixelDensity" text="-" width="stretch" height="100%" text_align="left,vcenter"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- 卡片：富文本缩放 -->
                    <VBox width="stretch" height="auto" bkcolor="bg_window_card"
                          border_size="1" border_color="border_control_normal" border_round="8,8"
                          padding="18,12,18,12" margin="0,12,0,0">
                        <Label text_id="STRID_DPIAWARE_RICHTEXT_TITLE" width="stretch" height="auto"
                               font="system_bold_14" text_align="left,vcenter"/>
                        <RichText class="rich_text" name="rich_text_demo" width="stretch" height="auto"
                                  row_spacing_mul="1.4" margin="0,8,0,0" text_id="STRID_DPIAWARE_RICHTEXT"/>
                        <Label text_id="STRID_DPIAWARE_RICHTEXT_TIP" width="stretch" height="auto"
                               font="system_regular_12" text_color="color_gray"
                               text_align="left,vcenter" margin="0,6,0,0"/>
                    </VBox>

                    <!-- 剩余空间占位 -->
                    <Control width="stretch" height="stretch" mouse_enabled="false"/>
                </VBox>

                <!-- 右列：多分辨率图源演示 -->
                <VBox width="260" height="stretch" bkcolor="bg_window_card"
                      border_size="1" border_color="border_control_normal" border_round="8,8"
                      padding="14,14,14,12" margin="16,0,0,0">
                    <Label text_id="STRID_DPIAWARE_IMAGE_TITLE" width="stretch" height="auto"
                           font="system_bold_14" text_align="left,vcenter"/>
                    <Control width="stretch" height="stretch" mouse_enabled="false"/>
                    <Control name="dpi_image" bkimage="autumn.png" width="auto" height="auto"
                             halign="center" mouse_enabled="false"/>
                    <Control width="stretch" height="stretch" mouse_enabled="false"/>
                    <Label text_id="STRID_DPIAWARE_IMAGE_TIP" width="stretch" height="84"
                           multi_line="true" font="system_regular_12" text_color="color_gray"
                           text_align="left,top"/>
                </VBox>
            </HBox>

            <!-- 底部操作栏 -->
            <HBox width="stretch" height="44" margin="0,12,0,0" valign="center">
                <Label text_id="STRID_DPIAWARE_MODIFY_DPI" width="auto" height="100%" text_align="left,vcenter"/>
                <RichEdit class="simple simple_border" name="display_scale_factor" text="" number="true"
                          height="32" width="72" max_char="4" min_number="0" max_number="500"
                          text_align="hcenter,vcenter" margin="8,0,0,0"/>
                <Button class="btn_global_blue_80x30" height="32" width="110" name="set_display_scale_factor"
                        text_id="STRID_DPIAWARE_MODIFY_DPI_BTN" margin="8,0,0,0"/>
                <Control width="stretch" height="1" mouse_enabled="false"/>
                <Button class="btn_global_white_80x30" height="32" width="110" name="NewWindow"
                        text_id="STRID_DPIAWARE_NEW_WINDOW"/>
            </HBox>
        </VBox>
    </VBox>
</Window>
