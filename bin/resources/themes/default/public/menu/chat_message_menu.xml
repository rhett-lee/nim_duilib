<?xml version="1.0" encoding="utf-8"?>
<Window shadow_type="menu_round" shadow_border_size="1" shadow_border_color="border_window">
    <Class name="my_menu_element" height="28" width="160" padding="10,0,10,0" />
    <Class name="my_menu_text" text_align="vcenter,left" disabled_text_color="text_disabled"/>
    <Class name="my_menu_shortcut" width="100%" text_align="vcenter,right" disabled_text_color="text_disabled"/>
    <Class name="my_menu_text_hbox" margin="16,0,16,0"/>
    <MenuListBox class="menu" name="chat_message_menu" padding="0,4,0,4">
        <!-- 消息列表只读，仅提供"复制"与"全选"两项；无选区/无消息时对应项置灰 -->
        <MenuItem class="menu_element my_menu_element" name="edit_menu_copy">
            <HBox class="my_menu_text_hbox">
                <Label class="menu_text my_menu_text" name="edit_menu_copy_text" text_id="STRID_PUBLIC_MENU_TEXT_COPY"/>
                <Label class="menu_text_shortcut my_menu_shortcut" name="edit_menu_copy_shortcut" text="Ctrl+C"/>
            </HBox>
        </MenuItem>
        <MenuItem class="menu_element my_menu_element" name="edit_menu_sel_all">
            <HBox class="my_menu_text_hbox">
                <Label class="menu_text my_menu_text" name="edit_menu_sel_all_text" text_id="STRID_PUBLIC_MENU_TEXT_SEL_ALL"/>
                <Label class="menu_text_shortcut my_menu_shortcut" name="edit_menu_sel_all_shortcut" text="Ctrl+A"/>
            </HBox>
        </MenuItem>
    </MenuListBox>
</Window>