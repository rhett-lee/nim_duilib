<?xml version="1.0" encoding="UTF-8"?>
<Window size="768,504" min_size="640,420"
        caption="0,0,0,36" use_system_caption="false" snap_layout_menu="true" sys_menu="true" sys_menu_rect="0,0,36,36"
        shadow_type="default" shadow_attached="true" shadow_snap="true"
        size_box="4,4,4,4" icon="public/caption/logo.ico" text_id="STRID_BASIC_TITLE">
    <!-- 该窗口下的Class定义 -->
    <!-- 卡片容器：内容区域分组显示，与TreeView等示例保持一致 -->
    <Class name="panel_card" bkcolor="bg_window_card" border_size="1" border_color="border_split_level1"
                             border_round="10,10"/>

    <!-- 整个窗口中，所有控件都放在这个VBox容器中 -->
    <VBox bkcolor="bg_window_main">
        <!-- 标题栏区域 -->
        <HBox name="window_title_bar" width="stretch" height="36" bkcolor="bg_titlebar">
            <!-- 标题栏：窗口左上角显示区域 -->
            <HBox margin="0,0,30,0" valign="center" width="auto" height="auto" mouse_enabled="false">
                <Control width="18" height="18" bkimage="public/caption/logo.svg" valign="center" margin="8,0,0,0"/>
                <Label text_id="STRID_BASIC_TITLE" valign="center" margin="8,0,0,0" mouse_enabled="false"/>
            </HBox>
            <Control mouse_enabled="false"/>
            <!-- 标题栏：右侧窗口控制区域，窗口最小化、最大化、还原、关闭按钮 -->
            <HBox margin="0,0,0,0" valign="center" width="auto" height="36">
                <Button class="btn_switch_theme" height="32" width="40" name="btn_window_theme" margin="0,2,0,2"/>
                <Button class="btn_switch_lang" height="32" width="40" name="btn_window_language" margin="0,2,0,2"/>
                <Button class="btn_wnd_fullscreen_11" height="32" width="40" name="btn_window_fullscreen" margin="0,2,0,2"/>
                <Button class="btn_wnd_min_11" height="32" width="40" name="btn_window_min" margin="0,2,0,2"/>
                <Box height="stretch" width="40" margin="0,2,0,2">
                    <Button class="btn_wnd_max_11" height="32" width="stretch" name="btn_window_max"/>
                    <Button class="btn_wnd_restore_11" height="32" width="stretch" name="btn_window_restore" visible="false"/>
                </Box>
                <Button class="btn_wnd_close_11" height="stretch" width="40" name="btn_window_close" margin="0,0,0,2"/>
            </HBox>
        </HBox>
        <!-- 标题栏区域结束 -->

        <!-- 工作区域，除了标题栏外的内容都放在这个大的VBox区域 -->
        <VBox bkcolor="bg_window_main" width="stretch" height="stretch" padding="16,12,16,16" child_margin="12">
            <!-- 欢迎卡片：页面视觉重心 -->
            <VBox class="panel_card" width="stretch" height="auto" padding="24,20,24,20" child_margin="8">
                <Control width="56" height="56" valign="center" halign="center"
                         bkimage="file='public/caption/logo.svg' width='56' height='56' valign='center' halign='center'"/>
                <Label text_id="STRID_BASIC_HEADLINE" font="system_bold_18" text_color="text_default"
                       width="stretch" height="30" valign="center" single_line="true" text_align="hcenter,vcenter"/>
                <Label text_id="STRID_BASIC_TEXT" font="system_regular_12" text_color="text_muted"
                       width="stretch" height="auto" valign="center" single_line="false" text_align="hcenter,vcenter"/>
            </VBox>

            <!-- 示例要点卡片：图标 + 标题 + 说明，分组展示 -->
            <VBox class="panel_card" width="stretch" height="auto" padding="14,12,14,12" child_margin="10">
                <HBox width="stretch" height="auto" child_margin="10" valign="center">
                    <Control width="16" height="16" valign="center"
                             bkimage="file='public/button/window-maximize.svg' width='16' height='16'
                                       valign='center' halign='center' svg_replace_colors='#333333|border_svg_image'"/>
                    <VBox width="stretch" height="auto" child_margin="2">
                        <Label text_id="STRID_BASIC_CARD1_TITLE" font="system_bold_14" text_color="text_default"
                               width="stretch" height="auto" single_line="true"/>
                        <Label text_id="STRID_BASIC_CARD1_DESC" font="system_regular_12" text_color="text_muted"
                               width="stretch" height="auto" single_line="false"/>
                    </VBox>
                </HBox>
                <HBox width="stretch" height="auto" child_margin="10" valign="center">
                    <Control width="16" height="16" valign="center"
                             bkimage="file='public/button/switch_theme.svg' width='16' height='16'
                                       valign='center' halign='center' svg_replace_colors='#333333|border_svg_image'"/>
                    <VBox width="stretch" height="auto" child_margin="2">
                        <Label text_id="STRID_BASIC_CARD2_TITLE" font="system_bold_14" text_color="text_default"
                               width="stretch" height="auto" single_line="true"/>
                        <Label text_id="STRID_BASIC_CARD2_DESC" font="system_regular_12" text_color="text_muted"
                               width="stretch" height="auto" single_line="false"/>
                    </VBox>
                </HBox>
                <HBox width="stretch" height="auto" child_margin="10" valign="center">
                    <Control width="16" height="16" valign="center"
                             bkimage="file='public/button/switch_lang.svg' width='16' height='16'
                                       valign='center' halign='center' svg_replace_colors='#333333|border_svg_image'"/>
                    <VBox width="stretch" height="auto" child_margin="2">
                        <Label text_id="STRID_BASIC_CARD3_TITLE" font="system_bold_14" text_color="text_default"
                               width="stretch" height="auto" single_line="true"/>
                        <Label text_id="STRID_BASIC_CARD3_DESC" font="system_regular_12" text_color="text_muted"
                               width="stretch" height="auto" single_line="false"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- 占位区域：把底部提示条推到窗口底部 -->
            <Control width="stretch" height="stretch"/>

            <!-- 底部提示条：与TreeView的状态栏保持一致的样式 -->
            <HBox class="panel_card" width="stretch" height="28" padding="10,0,10,0" border_round="6,6">
                <Label text_id="STRID_BASIC_FOOTER" font="system_regular_12" text_color="text_muted"
                       width="stretch" height="auto" valign="center" single_line="true"/>
            </HBox>
        </VBox>
    </VBox>
</Window>
